---
import "../styles/Buyer-segments.css";

const segments = [
  {
    num: "01",
    badge: "BIM & ARCHITECTURE",
    title: "Architecture Practices",
    desc: "BEP-aligned Revit models, seamless BIM integration, and high-fidelity 3D visualization.",
    steps: [
      "Revit model production & BEP alignment",
      "Architectural BIM data federation",
      "High-fidelity visual asset creation"
    ]
  },
  {
    num: "02",
    badge: "ENGINEERING & AUDIT",
    title: "Multidisciplinary Engineering",
    desc: "BIM federation, automated clash detection, and model production.",
    steps: [
      "Automated clash detection audit",
      "Multi-discipline model federation",
      "MEP & structural coordination"
    ]
  },
  {
    num: "03",
    badge: "DEVELOPMENT & ASSETS",
    title: "Developers & Asset Teams",
    desc: "End-to-end transparent planning and real-time interactive project models.",
    steps: [
      "Real-time interactive project models",
      "Transparent timeline & progress tracking",
      "Milestone-based asset handoff"
    ]
  }
];
---

<section class="buyer-segments">
  <div class="bs-wrap">
    
    <!-- Header Section Matching Exact Reference Layout -->
    <div class="bs-top-header">
      <div class="bs-header-left">
        <span class="bs-pill-tag reveal-element">APPROACH</span>
        <h2 class="bs-heading reveal-element">
          Production systems built for precision, <span class="adapted-text">adapted to you.</span>
        </h2>
      </div>

      <div class="bs-header-right reveal-element">
        <p class="bs-sub">
          We deliver architectural visuals and BIM execution systems that streamline workflows before a single brick is laid.
        </p>
      </div>
    </div>

    <!-- Cards Layout Matching Axys3D Navy Blue Cards System -->
    <div class="bs-cards-grid">
      
      <!-- Card 01: Light White Card (Matches Reference Left Card) -->
      <div class="bs-card card-white reveal-card">
        <div class="bs-card-top">
          <span class="bs-badge badge-light">{segments[0].badge}</span>
          <span class="bs-num num-gold">{segments[0].num}</span>
        </div>
        <div class="bs-card-body">
          <h3 class="bs-title title-dark">{segments[0].title}</h3>
          <p class="bs-desc desc-muted">{segments[0].desc}</p>
        </div>
        
        <div class="bs-steps-list steps-light-border" data-auto-loop>
          {segments[0].steps.map((step, idx) => (
            <div class={`bs-step-item step-light-item ${idx === 0 ? "active" : ""}`}>
              <span class="step-indicator dot-blue"></span>
              <span class="step-text">{step}</span>
            </div>
          ))}
        </div>
      </div>

      <!-- Card 02: Dark Navy Blue Card (Matches Reference Middle Card) -->
      <div class="bs-card card-navy reveal-card">
        <div class="bs-card-top">
          <span class="bs-badge badge-dark">{segments[1].badge}</span>
          <span class="bs-num num-gold">{segments[1].num}</span>
        </div>
        <div class="bs-card-body">
          <h3 class="bs-title title-white">{segments[1].title}</h3>
          <p class="bs-desc desc-grey">{segments[1].desc}</p>
        </div>

        <div class="bs-steps-list steps-dark-border" data-auto-loop>
          {segments[1].steps.map((step, idx) => (
            <div class={`bs-step-item step-dark-item ${idx === 0 ? "active" : ""}`}>
              <span class="step-indicator dot-blue"></span>
              <span class="step-text">{step}</span>
            </div>
          ))}
        </div>
      </div>

      <!-- Card 03: Dark Navy Blue Card (Matches Reference Right Card) -->
      <div class="bs-card card-navy reveal-card">
        <div class="bs-card-top">
          <span class="bs-badge badge-dark">{segments[2].badge}</span>
          <span class="bs-num num-gold">{segments[2].num}</span>
        </div>
        <div class="bs-card-body">
          <h3 class="bs-title title-white">{segments[2].title}</h3>
          <p class="bs-desc desc-grey">{segments[2].desc}</p>
        </div>

        <div class="bs-steps-list steps-dark-border" data-auto-loop>
          {segments[2].steps.map((step, idx) => (
            <div class={`bs-step-item step-dark-item ${idx === 0 ? "active" : ""}`}>
              <span class="step-indicator dot-blue"></span>
              <span class="step-text">{step}</span>
            </div>
          ))}
        </div>
      </div>

    </div>

  </div>
</section>

<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/gsap.min.js" is:inline></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/ScrollTrigger.min.js" is:inline></script>

<script>
  declare const gsap: any;
  declare const ScrollTrigger: any;

  function initBuyerSegments() {
    if (typeof gsap === "undefined" || typeof ScrollTrigger === "undefined") return;

    gsap.registerPlugin(ScrollTrigger);

    // GSAP Sequential Entrance Animation
    const tl = gsap.timeline({
      scrollTrigger: {
        trigger: ".buyer-segments",
        start: "top 78%",
        toggleActions: "play none none none"
      }
    });

    // 1. Text elements enter line by line
    tl.from(".reveal-element", {
      y: 20,
      opacity: 0,
      duration: 0.6,
      stagger: 0.12,
      ease: "power2.out"
    });

    // 2. Cards sequence load one by one
    tl.from(".reveal-card", {
      y: 30,
      opacity: 0,
      duration: 0.7,
      stagger: 0.18,
      ease: "power2.out"
    }, "-=0.2");

    // Reference Animation: Automatic Loop Item Highlighting
    const stepLists = document.querySelectorAll("[data-auto-loop]");

    stepLists.forEach((list) => {
      const items = list.querySelectorAll(".bs-step-item");
      if (items.length === 0) return;

      let currentIndex = 0;

      setInterval(() => {
        items[currentIndex].classList.remove("active");
        currentIndex = (currentIndex + 1) % items.length;
        items[currentIndex].classList.add("active");
      }, 2200);
    });
  }

  window.addEventListener("DOMContentLoaded", initBuyerSegments);
  document.addEventListener("astro:page-load", initBuyerSegments);
</script>