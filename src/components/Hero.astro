---
import "../styles/Hero.css";
---

<section class="hero" id="axysHero">
  <!-- Google Fonts: Inter Direct Load -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800;900&display=swap" rel="stylesheet" />

  <!-- ================= BACKGROUND VIDEO ================= -->
  <video class="hero-video" id="heroVideo" autoplay muted loop playsinline>
    <source src="/videos/hero-video.mp4" type="video/mp4" />
  </video>

  <!-- ================= BLUE DARK OVERLAY ================= -->
  <div class="hero-overlay"></div>

  <!-- ================= BRAND MASK INTRO ================= -->
  <div class="brand-mask" aria-hidden="true">
    <video autoplay muted loop playsinline>
      <source src="/videos/hero-video.mp4" type="video/mp4" />
    </video>
  </div>

  <!-- ================= TOP BAR: logo + menu toggle only ================= -->
  <div class="hero-topbar">
    <a href="/" class="logo">AXYS<span class="brown-text">3D</span></a>

    <button class="menu-toggle-btn" id="menuToggle" aria-label="Open menu" aria-expanded="false">
      <span class="menu-toggle-label">Menu</span>
      <span class="menu-toggle-lines"><i></i><i></i><i></i></span>
    </button>
  </div>

  <!-- ================= RIGHT SIDE NAV (hidden until opened) ================= -->
  <div class="side-nav-scrim" id="sideNavScrim"></div>

  <nav class="side-nav" id="sideNav" aria-hidden="true">
    <div class="side-nav-preview" id="sideNavPreview">
      <span class="side-nav-preview-index">00</span>
      <p class="side-nav-preview-text">Hover a link to preview what's inside.</p>
    </div>

    <span class="side-nav-kicker">Navigation</span>

    <ul class="side-nav-links">
      <li><a href="/" data-preview="Back to where it all begins — the Axys3D studio."><span class="side-nav-link-index">01</span><span class="side-nav-link-text">Home</span><span class="side-nav-link-arrow">↗</span></a></li>
      <li><a href="/Services" data-preview="Every stage of the AEC production pipeline, laid out step by step."><span class="side-nav-link-index">02</span><span class="side-nav-link-text">Services</span><span class="side-nav-link-arrow">↗</span></a></li>
      <li><a href="/Projects" data-preview="A curated look at the spaces we've brought to life."><span class="side-nav-link-index">03</span><span class="side-nav-link-text">Projects</span><span class="side-nav-link-arrow">↗</span></a></li>
      <li><a href="/Visuals" data-preview="Renders, walkthroughs and stills from the studio's latest work."><span class="side-nav-link-index">04</span><span class="side-nav-link-text">Visuals</span><span class="side-nav-link-arrow">↗</span></a></li>
      <li><a href="/Insights" data-preview="Notes on production workflow, tools and the AEC pipeline."><span class="side-nav-link-index">05</span><span class="side-nav-link-text">Insights</span><span class="side-nav-link-arrow">↗</span></a></li>
      <li><a href="/Process" data-preview="How raw drawings become cinematic architectural visuals."><span class="side-nav-link-index">06</span><span class="side-nav-link-text">Process</span><span class="side-nav-link-arrow">↗</span></a></li>
      <li><a href="/About" data-preview="The studio, the people, and the standard we work to."><span class="side-nav-link-index">07</span><span class="side-nav-link-text">About</span><span class="side-nav-link-arrow">↗</span></a></li>
      <li><a href="/Contact" data-preview="Scope your next production package with us."><span class="side-nav-link-index">08</span><span class="side-nav-link-text">Contact</span><span class="side-nav-link-arrow">↗</span></a></li>
    </ul>

    <a href="/Contact" class="side-nav-cta">
      <span>Start a project</span>
      <span class="arrow">↗</span>
    </a>
  </nav>

  <!-- ================= SCROLL-DRIVEN SCENES ================= -->
  <div class="hero-scenes" id="heroScenes">
    <div class="hero-scenes-sticky">

      <div class="hero-content">
        <div class="hero-main">

          <div class="hero-eyebrow" id="sceneEyebrow">Full-service AEC production partner</div>

          <h1 id="sceneHeadline">
            <span class="line line-1">AEC production</span>
            <span class="line line-2">without the production friction.</span>
          </h1>

          <div class="hero-buttons" id="heroButtons">
            <a href="/Services" class="primary-button">
              <span>Review the full pipeline</span>
              <span class="arrow">↗</span>
            </a>

            <a href="/Contact" class="secondary-button">
              <span>Scope a production package</span>
              <span class="arrow">↗</span>
            </a>
          </div>

        </div>
      </div>

      <!-- ================= HOTSPOTS ================= -->
      <!-- <div class="hero-hotspots" id="heroHotspots">
        <button class="hotspot-btn active" data-key="pool" type="button">
          <span class="hotspot-dot"></span> Pool
        </button>
        <button class="hotspot-btn" data-key="living" type="button">
          <span class="hotspot-dot"></span> Living
        </button>
        <button class="hotspot-btn" data-key="dining" type="button">
          <span class="hotspot-dot"></span> Dining
        </button>
        <button class="hotspot-btn" data-key="suite" type="button">
          <span class="hotspot-dot"></span> Suite
        </button>
      </div> -->

      <div class="hero-scroll-cue">
        <span>Scroll</span>
        <span class="scroll-line"></span>
      </div>

    </div>
  </div>

</section>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const heroSection = document.getElementById("axysHero") as HTMLElement;
    const video = document.getElementById("heroVideo") as HTMLVideoElement;
    const eyebrow = document.getElementById("sceneEyebrow") as HTMLElement;
    const headline = document.getElementById("sceneHeadline") as HTMLElement;
    const buttons = document.getElementById("heroButtons") as HTMLElement;
    const hotspots = document.querySelectorAll<HTMLButtonElement>(".hotspot-btn");

    const menuToggle = document.getElementById("menuToggle") as HTMLButtonElement;
    const sideNav = document.getElementById("sideNav") as HTMLElement;
    const scrim = document.getElementById("sideNavScrim") as HTMLElement;
    const preview = document.getElementById("sideNavPreview") as HTMLElement;
    const previewText = preview.querySelector(".side-nav-preview-text") as HTMLElement;
    const previewIndex = preview.querySelector(".side-nav-preview-index") as HTMLElement;

    if (
      !heroSection || !video || !eyebrow || !headline || !buttons ||
      !menuToggle || !sideNav || !scrim || !preview || !previewText || !previewIndex
    ) {
      return;
    }

    // 8 short scenes so the copy keeps pace with the footage. Only the very
    // first one (the client's own brand line) shows the two CTA buttons —
    // every scene after that is text-only. "mainKey" ties each in-between
    // scene back to whichever hotspot (Pool / Living / Dining / Suite) it
    // belongs under, so the right hotspot stays highlighted throughout.
    type Scene = {
      label: string;
      lines: [string, string];
      time: number;
      mainKey: string;
      showButtons?: boolean;
    };

    const scenes: Scene[] = [
      {
        label: "01 — ARRIVAL",
        lines: ["AEC production", "without the production friction."],
        time: 0.3,
        mainKey: "pool",
        showButtons: true,
      },
      {
        label: "02 — POOL",
        lines: ["Water, light and silence,", "composed to scale."],
        time: 8,
        mainKey: "pool",
      },
      {
        label: "03 — LIVING",
        lines: ["Space engineered", "to feel effortless."],
        time: 16,
        mainKey: "living",
      },
      {
        label: "04 — DETAIL",
        lines: ["Every material chosen", "to render true to touch."],
        time: 24,
        mainKey: "living",
      },
      {
        label: "05 — DINING",
        lines: ["A table built", "for the render, and the room."],
        time: 32,
        mainKey: "dining",
      },
      {
        label: "06 — TABLESCAPE",
        lines: ["Styling that holds up", "to the closest frame."],
        time: 40,
        mainKey: "dining",
      },
      {
        label: "07 — PASSAGE",
        lines: ["Circulation drawn", "as carefully as the facade."],
        time: 46,
        mainKey: "suite",
      },
      {
        label: "08 — MASTER SUITE",
        lines: ["Privacy, framed", "by the skyline."],
        time: 52,
        mainKey: "suite",
      },
    ];

    let activeScene = -1;

    function setScene(i: number, { seek = false }: { seek?: boolean } = {}) {
      if (i === activeScene && !seek) return;
      activeScene = i;
      const s = scenes[i];
      if (!s) return;

      eyebrow.style.opacity = "0";
      headline.style.opacity = "0";

      window.setTimeout(() => {
        eyebrow.textContent = s.label;
        headline.innerHTML =
          `<span class="line line-1">${s.lines[0]}</span>` +
          `<span class="line line-2">${s.lines[1]}</span>`;
        eyebrow.style.opacity = "1";
        headline.style.opacity = "1";
      }, 180);

      buttons.style.opacity = s.showButtons ? "1" : "0";
      buttons.style.pointerEvents = s.showButtons ? "auto" : "none";

      hotspots.forEach((b: HTMLButtonElement) => {
        b.classList.toggle("active", b.dataset.key === s.mainKey);
      });

      if (seek && video) {
        try {
          video.currentTime = s.time;
          video.play();
        } catch (e) {}
      }
    }

    setScene(0);

    hotspots.forEach((btn: HTMLButtonElement) => {
      btn.addEventListener("click", () => {
        // Jump to the first (earliest) scene that belongs to this hotspot's group.
        const group = scenes
          .map((sc, sIdx) => ({ sc, sIdx }))
          .filter(({ sc }) => sc.mainKey === btn.dataset.key);
        if (group.length === 0) return;
        const target = group.reduce((a, b) => (a.sc.time < b.sc.time ? a : b));
        setScene(target.sIdx, { seek: true });
      });
    });

    // Automatic: as the video plays (and loops), the text switches on its own
    // whenever playback crosses into the next scene's time range.
    video.addEventListener("timeupdate", () => {
      const t = video.currentTime;
      let idx = 0;
      for (let i = 0; i < scenes.length; i++) {
        if (t >= scenes[i].time) idx = i;
      }
      setScene(idx);
    });

    // Right-side nav: opens from the right, dims + fades the video behind it.
    function openNav() {
      heroSection.classList.add("nav-open");
      menuToggle.classList.add("is-open");
      menuToggle.setAttribute("aria-expanded", "true");
      sideNav.setAttribute("aria-hidden", "false");
    }
    function closeNav() {
      heroSection.classList.remove("nav-open");
      menuToggle.classList.remove("is-open");
      menuToggle.setAttribute("aria-expanded", "false");
      sideNav.setAttribute("aria-hidden", "true");
      preview.classList.remove("is-visible");
    }
    menuToggle.addEventListener("click", () => {
      heroSection.classList.contains("nav-open") ? closeNav() : openNav();
    });
    scrim.addEventListener("click", closeNav);
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape") closeNav();
    });

    // Hover a nav link → the parallel preview panel slides in level with
    // that exact link (not a fixed center spot).
    sideNav.querySelectorAll<HTMLAnchorElement>(".side-nav-links a").forEach((a: HTMLAnchorElement, idx: number) => {
      a.addEventListener("mouseenter", () => {
        const rect = a.getBoundingClientRect();
        preview.style.top = `${rect.top + rect.height / 2}px`;
        previewText.textContent = a.dataset.preview || "";
        previewIndex.textContent = String(idx + 1).padStart(2, "0");
        preview.classList.add("is-visible");
      });
      a.addEventListener("mouseleave", () => {
        preview.classList.remove("is-visible");
      });
    });
  });
</script>