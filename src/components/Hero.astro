---
import "../styles/Hero.css";
---

<!-- =====================================================
     UX BRIEF — HERO
     Visitor ka sawal : "Ye log kya karte hain, aur kya ye mere liye hai?"
     Jawab (5 second): drawings -> 3D models / renders / walkthroughs.
     Har NEW (UX) element ka maqsad us k upar comment mein likha hai.
     ===================================================== -->

<section class="hero" id="axysHero">

  <!-- ================= FONTS ================= -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800;900&display=swap"
    rel="stylesheet"
  />


  <!-- ================= BACKGROUND VIDEO ================= -->
  <video
    class="hero-video"
    id="heroVideo"
    autoplay
    muted
    playsinline
  >
    <source
      src="/videos/hero-video.mp4"
      type="video/mp4"
    />
  </video>


  <!-- ================= BLUE DARK OVERLAY ================= -->
  <div class="hero-overlay"></div>


  <!-- TEXT SCRIM (video end par fade-in) -->
  <div class="hero-text-scrim"></div>


  <!-- ================= BRAND MASK INTRO ================= -->
  <div class="brand-mask" aria-hidden="true">
    <video autoplay muted loop playsinline>
      <source
        src="/videos/hero-video.mp4"
        type="video/mp4"
      />
    </video>
  </div>


  <!-- =====================================================
       HERO CONTENT
       ===================================================== -->

  <div class="hero-scenes" id="heroScenes">

    <div class="hero-scenes-sticky">


      <div class="hero-content">

        <div class="hero-main">


          <!-- EYEBROW -->
          <div class="hero-eyebrow">
            Full-service
            <!-- NEW (UX): maqsad = "AEC" lafz na samajhne wale ko 1 tap par matlab mil jaye -->
            <span
              class="term"
              tabindex="0"
              data-tip="AEC = Architecture, Engineering &amp; Construction. In simple words: the building industry."
            > AEC </span>
            production partner
          </div>


          <!-- MAIN HEADING -->
          <h1>

            <span class="line line-1">
              AEC production
            </span>

            <span class="line line-2">
              without the production friction.
            </span>

          </h1>


          <!-- NEW (UX): PLAIN-WORDS LINE
               maqsad = heading industry ki zubaan mein hai; ye line aam banday ko
               pehle 5 second mein bata deti hai ke kaam kya hai. -->
          <p class="hero-lead">
            We turn architects' drawings into 3D models, renders and walkthroughs,
            so you can see the building before it's built.
          </p>


          <!-- HERO BUTTONS -->
          <div class="hero-buttons">

            <a
              href="/Services"
              class="primary-button"
            >
              <span>
                Review the full pipeline
              </span>

              <span class="arrow">
                ↗
              </span>
            </a>


            <a
              href="/Contact"
              class="secondary-button"
            >
              <span>
                Discuss a production package
              </span>

              <span class="arrow">
                ↗
              </span>
            </a>

          </div>


          <!-- NEW (UX): "WHO ARE YOU?" CHIPS
               maqsad = visitor ko khud apni jagah dhoondni na paray.
               Click karne par Buyer section tak scroll hota hai.
               NOTE: Buyer section par id="buyer-segments" lagana zaroori hai. -->
          <!-- <div class="hero-fit" role="group" aria-label="Find the right fit for you">
            <span class="hero-fit-label">Find your fit</span>

            <a href="#buyer-segments" class="fit-chip" data-segment="architect">I design buildings</a>
            <a href="#buyer-segments" class="fit-chip" data-segment="engineer">I coordinate engineering</a>
            <a href="#buyer-segments" class="fit-chip" data-segment="developer">I develop property</a>
          </div> -->

        </div>

      </div>


      <!-- =================================================
           SCROLL CUE
           ================================================= -->

      <!-- <div class="hero-scroll-cue">

        <span>
          Scroll
        </span>

        <span class="scroll-line"></span>

      </div> -->


    </div>

  </div>

</section>


<!-- =====================================================
     SCRIPTS (VIDEO TO TEXT HANDLER)
     ===================================================== -->

<script>
  const hero = document.getElementById("axysHero") as HTMLElement | null;
  const video = document.getElementById("heroVideo") as HTMLVideoElement | null;

  // Video End Logic
  if (hero && video) {
    const HOLD_MS = 6000;

    // NEW (UX): text video khatam hone ka intezar karta hai. Agar chahte ho ke
    // text zyada se zyada itni der baad aa jaye to ise ms mein likho (jaise 4000).
    // 0 = pehle jaisa (video end par).
    const MAX_WAIT_MS = 0;
    let holdTimer: number | undefined;

    const restartVideo = () => {
      hero.classList.remove("text-in");
      video.currentTime = 0;
      video.play().catch(() => {});
    };

    const showText = (loopAgain = true) => {
      if (hero.classList.contains("text-in")) return;
      hero.classList.add("text-in");
      window.clearTimeout(holdTimer);
      if (loopAgain) holdTimer = window.setTimeout(restartVideo, HOLD_MS);
    };

    if (MAX_WAIT_MS > 0) window.setTimeout(() => showText(true), MAX_WAIT_MS);

    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    if (reduceMotion) {
      video.pause();
      showText(false);
    } else {
      video.addEventListener("ended", () => showText(true));

      video.querySelector("source")?.addEventListener("error", () => showText(false));
      video.addEventListener("error", () => showText(false));
      window.setTimeout(() => {
        if (video.paused && video.currentTime === 0) showText(false);
      }, 3000);
    }
  }
</script>