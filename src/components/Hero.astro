---
import "../styles/Hero.css";
---

<section class="hero" id="axysHero">

  <!-- ================= FONTS ================= -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800;900&display=swap"
    rel="stylesheet"
  />


  <!-- ================= BACKGROUND VIDEO ================= -->
  <video
    class="hero-video"
    id="heroVideo"
    autoplay
    muted
    playsinline
  >
    <source
      src="/videos/hero-video.mp4"
      type="video/mp4"
    />
  </video>


  <!-- ================= BLUE DARK OVERLAY ================= -->
  <div class="hero-overlay"></div>


  <!-- TEXT SCRIM (video end par fade-in) -->
  <div class="hero-text-scrim"></div>


  <!-- ================= BRAND MASK INTRO ================= -->
  <div class="brand-mask" aria-hidden="true">
    <video autoplay muted loop playsinline>
      <source
        src="/videos/hero-video.mp4"
        type="video/mp4"
      />
    </video>
  </div>


  <!-- =====================================================
       TOP BAR / NAVBAR
       ===================================================== -->

  <div class="hero-topbar">

    <!-- LOGO -->
    <a href="/" class="logo">
      AXYS<span class="brown-text">3D</span>
    </a>


    <!-- FLOATING NAVBAR -->
    <nav class="floating-nav" aria-label="Primary">
      <ul>
        <li><a href="/" class="is-active">Home</a></li>
        <li><a href="/Services">Services</a></li>
        <li><a href="/Industries">Industries</a></li>
        <li><a href="/Work">Work</a></li>
        <li><a href="/Process">Process</a></li>
        <li><a href="/Insights">Insights</a></li>
        <li><a href="/Visuals">Visuals</a></li>
        <li><a href="/About">About</a></li>
      </ul>
    </nav>


    <!-- TOP RIGHT CTA -->
    <a href="/Contact" class="topbar-cta">
      <span>Discuss a production package</span>
      <span class="arrow">↗</span>
    </a>

  </div>


  <!-- =====================================================
       HERO CONTENT
       ===================================================== -->

  <div class="hero-scenes" id="heroScenes">

    <div class="hero-scenes-sticky">


      <div class="hero-content">

        <div class="hero-main">


          <!-- EYEBROW -->
          <div class="hero-eyebrow">
            Full-service AEC production partner
          </div>


          <!-- MAIN HEADING -->
          <h1>

            <span class="line line-1">
              AEC production
            </span>

            <span class="line line-2">
              without the production friction.
            </span>

          </h1>


          <!-- HERO BUTTONS -->
          <div class="hero-buttons">

            <a
              href="/Services"
              class="primary-button"
            >
              <span>
                Review the full pipeline
              </span>

              <span class="arrow">
                ↗
              </span>
            </a>


            <a
              href="/Contact"
              class="secondary-button"
            >
              <span>
                Scope a production package
              </span>

              <span class="arrow">
                ↗
              </span>
            </a>

          </div>

        </div>

      </div>


      <!-- =================================================
           SCROLL CUE
           ================================================= -->

      <div class="hero-scroll-cue">

        <span>
          Scroll
        </span>

        <span class="scroll-line"></span>

      </div>


    </div>

  </div>

</section>


<!-- =====================================================
     HERO VIDEO -> TEXT SCRIPT
     video khatam -> text aata hai, 6 sec ruk kar video dobara chalti hai
     ===================================================== -->

<script>
  const hero = document.getElementById("axysHero") as HTMLElement | null;
  const video = document.getElementById("heroVideo") as HTMLVideoElement | null;

  if (hero && video) {
    const HOLD_MS = 6000; // text ke saath kitni der ruke
    let holdTimer: number | undefined;

    const restartVideo = () => {
      hero.classList.remove("text-in");
      video.currentTime = 0;
      video.play().catch(() => {});
    };

    const showText = (loopAgain = true) => {
      if (hero.classList.contains("text-in")) return;
      hero.classList.add("text-in");
      window.clearTimeout(holdTimer);
      if (loopAgain) holdTimer = window.setTimeout(restartVideo, HOLD_MS);
    };

    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    if (reduceMotion) {
      video.pause();
      showText(false);
    } else {
      video.addEventListener("ended", () => showText(true));

      // fallback: video load / autoplay na ho to text phir bhi dikhe
      video.querySelector("source")?.addEventListener("error", () => showText(false));
      video.addEventListener("error", () => showText(false));
      window.setTimeout(() => {
        if (video.paused && video.currentTime === 0) showText(false);
      }, 3000);
    }
  }
</script>