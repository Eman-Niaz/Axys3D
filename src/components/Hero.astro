---
import "../styles/Hero.css";
---

<section class="hero" id="axysHero">

  <!-- ================= FONTS ================= -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800;900&display=swap"
    rel="stylesheet"
  />


  <!-- ================= BACKGROUND VIDEO ================= -->
  <video
    class="hero-video"
    id="heroVideo"
    autoplay
    muted
    loop
    playsinline
  >
    <source
      src="/videos/hero-video.mp4"
      type="video/mp4"
    />
  </video>


  <!-- ================= BLUE DARK OVERLAY ================= -->
  <div class="hero-overlay"></div>


  <!-- ================= BRAND MASK INTRO ================= -->
  <div class="brand-mask" aria-hidden="true">
    <video autoplay muted loop playsinline>
      <source
        src="/videos/hero-video.mp4"
        type="video/mp4"
      />
    </video>
  </div>


  <!-- =====================================================
       TOP BAR / NAVBAR
       ===================================================== -->

  <div class="hero-topbar">

    <!-- LOGO -->
    <a href="/" class="logo">
      AXYS<span class="brown-text">3D</span>
    </a>


    <!-- MENU TOGGLE -->
    <button
      class="menu-toggle-btn"
      id="menuToggle"
      aria-label="Open menu"
      aria-expanded="false"
      type="button"
    >
      <span class="menu-toggle-label">
        Menu
      </span>

      <span class="menu-toggle-lines">
        <i></i>
        <i></i>
        <i></i>
      </span>
    </button>

  </div>


  <!-- =====================================================
       NAVIGATION SCRIM
       ===================================================== -->

  <div
    class="side-nav-scrim"
    id="sideNavScrim"
  ></div>


  <!-- =====================================================
       RIGHT SIDE NAVIGATION
       ===================================================== -->

  <nav
    class="side-nav"
    id="sideNav"
    aria-hidden="true"
  >

    <!-- NAV PREVIEW -->
    <div
      class="side-nav-preview"
      id="sideNavPreview"
    >
      <span class="side-nav-preview-index">
        00
      </span>

      <p class="side-nav-preview-text">
        Hover a link to preview what's inside.
      </p>
    </div>


    <!-- KICKER -->
    <span class="side-nav-kicker">
      Navigation
    </span>


    <!-- NAV LINKS -->
    <ul class="side-nav-links">

      <!-- HOME -->
      <li>
        <a
          href="/"
          data-preview="Back to the Axys3D studio."
        >
          <span class="side-nav-link-index">
            01
          </span>

          <span class="side-nav-link-text">
            Home
          </span>

          <span class="side-nav-link-arrow">
            ↗
          </span>
        </a>
      </li>


      <!-- SERVICES -->
      <li>
        <a
          href="/Services"
          data-preview="AEC production services across the pipeline."
        >
          <span class="side-nav-link-index">
            02
          </span>

          <span class="side-nav-link-text">
            Services
          </span>

          <span class="side-nav-link-arrow">
            ↗
          </span>
        </a>
      </li>


      <!-- INDUSTRIES -->
      <li>
        <a
          href="/Industries"
          data-preview="Production support built around different AEC sectors."
        >
          <span class="side-nav-link-index">
            03
          </span>

          <span class="side-nav-link-text">
            Industries
          </span>

          <span class="side-nav-link-arrow">
            ↗
          </span>
        </a>
      </li>


      <!-- WORK -->
      <li>
        <a
          href="/Work"
          data-preview="Selected projects and production work."
        >
          <span class="side-nav-link-index">
            04
          </span>

          <span class="side-nav-link-text">
            Work
          </span>

          <span class="side-nav-link-arrow">
            ↗
          </span>
        </a>
      </li>


      <!-- INSIGHTS -->
      <li>
        <a
          href="/Insights"
          data-preview="Notes on AEC production, workflow and technology."
        >
          <span class="side-nav-link-index">
            05
          </span>

          <span class="side-nav-link-text">
            Insights
          </span>

          <span class="side-nav-link-arrow">
            ↗
          </span>
        </a>
      </li>


      <!-- VISUALS -->
      <li>
        <a
          href="/Visuals"
          data-preview="Renders, walkthroughs and visual production."
        >
          <span class="side-nav-link-index">
            06
          </span>

          <span class="side-nav-link-text">
            Visuals
          </span>

          <span class="side-nav-link-arrow">
            ↗
          </span>
        </a>
      </li>


      <!-- ABOUT -->
      <li>
        <a
          href="/About"
          data-preview="The studio, people and production standard."
        >
          <span class="side-nav-link-index">
            07
          </span>

          <span class="side-nav-link-text">
            About
          </span>

          <span class="side-nav-link-arrow">
            ↗
          </span>
        </a>
      </li>

    </ul>


    <!-- =================================================
         NAV CTA
         ================================================= -->

    <a
      href="/Contact"
      class="side-nav-cta"
    >
      <span>
        Discuss a production package
      </span>

      <span class="arrow">
        ↗
      </span>
    </a>

  </nav>


  <!-- =====================================================
       HERO CONTENT
       ===================================================== -->

  <div class="hero-scenes" id="heroScenes">

    <div class="hero-scenes-sticky">


      <div class="hero-content">

        <div class="hero-main">


          <!-- EYEBROW -->
          <div class="hero-eyebrow">
            Full-service AEC production partner
          </div>


          <!-- MAIN HEADING -->
          <h1>

            <span class="line line-1">
              AEC production
            </span>

            <span class="line line-2">
              without the production friction.
            </span>

          </h1>


          <!-- HERO BUTTONS -->
          <div class="hero-buttons">

            <a
              href="/Services"
              class="primary-button"
            >
              <span>
                Review the full pipeline
              </span>

              <span class="arrow">
                ↗
              </span>
            </a>


            <a
              href="/Contact"
              class="secondary-button"
            >
              <span>
                Scope a production package
              </span>

              <span class="arrow">
                ↗
              </span>
            </a>

          </div>

        </div>

      </div>


      <!-- =================================================
           SCROLL CUE
           ================================================= -->

      <div class="hero-scroll-cue">

        <span>
          Scroll
        </span>

        <span class="scroll-line"></span>

      </div>


    </div>

  </div>

</section>


<!-- =====================================================
     NAVIGATION SCRIPT
     ===================================================== -->

<script>
  document.addEventListener("DOMContentLoaded", () => {

    const heroSection =
      document.getElementById(
        "axysHero"
      ) as HTMLElement;

    const menuToggle =
      document.getElementById(
        "menuToggle"
      ) as HTMLButtonElement;

    const sideNav =
      document.getElementById(
        "sideNav"
      ) as HTMLElement;

    const scrim =
      document.getElementById(
        "sideNavScrim"
      ) as HTMLElement;

    const preview =
      document.getElementById(
        "sideNavPreview"
      ) as HTMLElement;

    const previewText =
      preview?.querySelector(
        ".side-nav-preview-text"
      ) as HTMLElement;

    const previewIndex =
      preview?.querySelector(
        ".side-nav-preview-index"
      ) as HTMLElement;


    /* =====================================================
       SAFETY CHECK
       ===================================================== */

    if (
      !heroSection ||
      !menuToggle ||
      !sideNav ||
      !scrim ||
      !preview ||
      !previewText ||
      !previewIndex
    ) {
      return;
    }


    /* =====================================================
       OPEN NAV
       ===================================================== */

    function openNav() {

      heroSection.classList.add(
        "nav-open"
      );

      menuToggle.classList.add(
        "is-open"
      );

      menuToggle.setAttribute(
        "aria-expanded",
        "true"
      );

      sideNav.setAttribute(
        "aria-hidden",
        "false"
      );

    }


    /* =====================================================
       CLOSE NAV
       ===================================================== */

    function closeNav() {

      heroSection.classList.remove(
        "nav-open"
      );

      menuToggle.classList.remove(
        "is-open"
      );

      menuToggle.setAttribute(
        "aria-expanded",
        "false"
      );

      sideNav.setAttribute(
        "aria-hidden",
        "true"
      );

      preview.classList.remove(
        "is-visible"
      );

    }


    /* =====================================================
       MENU BUTTON
       ===================================================== */

    menuToggle.addEventListener(
      "click",
      () => {

        const isOpen =
          heroSection.classList.contains(
            "nav-open"
          );

        if (isOpen) {
          closeNav();
        } else {
          openNav();
        }

      }
    );


    /* =====================================================
       CLICK OUTSIDE
       ===================================================== */

    scrim.addEventListener(
      "click",
      closeNav
    );


    /* =====================================================
       ESCAPE KEY
       ===================================================== */

    document.addEventListener(
      "keydown",
      (event) => {

        if (
          event.key === "Escape"
        ) {
          closeNav();
        }

      }
    );


    /* =====================================================
       NAV LINK PREVIEW
       ===================================================== */

    sideNav
      .querySelectorAll<HTMLAnchorElement>(
        ".side-nav-links a"
      )
      .forEach(
        (
          link: HTMLAnchorElement,
          index: number
        ) => {

          link.addEventListener(
            "mouseenter",
            () => {

              const rect =
                link.getBoundingClientRect();

              preview.style.top =
                `${rect.top + rect.height / 2}px`;

              previewText.textContent =
                link.dataset.preview || "";

              previewIndex.textContent =
                String(index + 1).padStart(
                  2,
                  "0"
                );

              preview.classList.add(
                "is-visible"
              );

            }
          );


          link.addEventListener(
            "mouseleave",
            () => {

              preview.classList.remove(
                "is-visible"
              );

            }
          );

        }
      );

  });
</script>