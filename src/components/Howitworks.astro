---
import "../styles/HowItWorks.css";

// Ek hi section: Approach + How it works (Drawings -> 3D model -> Renders)
const steps = [
  {
    num: "01",
    label: "YOU GIVE US",
    title: "Drawings or plans",
    desc: "Floor plans, sketches or design files. Whatever you already have is enough to start.",
    icon: "plan",
    checks: ["Floor plans", "Sketches", "Design files"],
  },
  {
    num: "02",
    label: "WE BUILD",
    title: "An accurate 3D model",
    desc: "Our team turns your drawings into a precise 3D model of the building.",
    icon: "cube",
    checks: ["Geometry modelled", "Dimensions verified", "Model approved"],
  },
  {
    num: "03",
    label: "YOU GET",
    title: "Renders, walkthroughs & stills",
    desc: "Photo-real images and videos you can show your client, before anything is built.",
    icon: "image",
    checks: ["Photo-real renders", "Walkthrough videos", "High-res stills"],
  },
];
---

<section class="hiw" id="howItWorks">
  <div class="hiw-inner">

    <!-- Heading -->
    <div class="hiw-top">
      <span class="hiw-tag">How we work</span>
      <h2>
        <span class="hiw-h-light">Our process is simple</span>
        <span class="hiw-h-bold">render before you build.</span>
      </h2>
      <p class="hiw-promise">
        We deliver architectural visuals that sell the space before it's built.
      </p>
    </div>

    <!-- Steps -->
    <div class="hiw-steps" id="hiwSteps">
      {steps.map((s, i) => (
        <>
          <article
            class={`hiw-step ${i === 0 ? "is-active" : ""}`}
            data-step={i}
            tabindex="0"
            role="button"
            aria-label={`Step ${s.num}: ${s.title}`}
          >
            <div class="hiw-step-head">
              <span class="hiw-step-num">{s.num}</span>
              <span class="hiw-step-label">{s.label}</span>
            </div>

            <div class="hiw-visual" aria-hidden="true">
              {s.icon === "plan" && (
                <svg viewBox="0 0 240 150" preserveAspectRatio="xMidYMid meet">
                  <defs>
                    <pattern id="hiwGrid" width="12" height="12" patternUnits="userSpaceOnUse">
                      <path d="M12 0H0V12" fill="none" stroke="rgba(127,182,230,.12)" stroke-width=".6" />
                    </pattern>
                  </defs>
                  <rect width="240" height="150" fill="url(#hiwGrid)" />
                  <g fill="none" stroke="#9cc7ee" stroke-width="1.6" stroke-linejoin="round" stroke-linecap="round">
                    <rect class="d" pathLength="1" x="40" y="30" width="160" height="94" />
                    <path class="d" pathLength="1" d="M40 80H108M108 30V80M108 100V124M148 80H200M148 80V124" />
                    <path class="d" pathLength="1" d="M108 80a14 14 0 0 1 14 -14" stroke-width="1" />
                    <path class="d" pathLength="1" d="M148 100a14 14 0 0 0 -14 14" stroke-width="1" />
                  </g>
                  <path class="d" pathLength="1" d="M40 18H200M40 14V22M200 14V22" stroke="#b38b4c" stroke-width="1" fill="none" />
                  <text class="r" x="120" y="13" fill="#b38b4c" font-size="7" font-weight="700" text-anchor="middle">12.0 m</text>
                </svg>
              )}
              {s.icon === "cube" && (
                <svg viewBox="0 0 240 150" preserveAspectRatio="xMidYMid meet">
                  <g fill="none" stroke="#e2cda5" stroke-width="1.4" stroke-linejoin="round" stroke-linecap="round">
                    <path class="d" pathLength="1" d="M120 24L192 60L120 96L48 60Z" />
                    <path class="d" pathLength="1" d="M48 60V92L120 128V96" />
                    <path class="d" pathLength="1" d="M192 60V92L120 128" />
                    <path class="d" pathLength="1" d="M84 42L156 78M156 42L84 78" stroke-opacity=".35" />
                    <path class="d" pathLength="1" d="M96 106L96 90L112 98L112 114Z" stroke-opacity=".7" />
                    <path class="d" pathLength="1" d="M132 114V98L148 90V106Z" stroke-opacity=".7" />
                  </g>
                  <g fill="#b38b4c" class="r">
                    <circle cx="120" cy="24" r="2.4" /><circle cx="192" cy="60" r="2.4" />
                    <circle cx="48" cy="60" r="2.4" /><circle cx="120" cy="96" r="2.4" />
                    <circle cx="48" cy="92" r="2.4" /><circle cx="192" cy="92" r="2.4" />
                    <circle cx="120" cy="128" r="2.4" />
                  </g>
                </svg>
              )}
              {s.icon === "image" && (
                <svg viewBox="0 0 240 150" preserveAspectRatio="xMidYMid slice">
                  <defs>
                    <linearGradient id="hiwSky" x1="0" y1="0" x2="0" y2="1">
                      <stop offset="0" stop-color="#14233d" />
                      <stop offset=".45" stop-color="#4c6a94" />
                      <stop offset=".8" stop-color="#e29a6b" />
                      <stop offset="1" stop-color="#f6c08a" />
                    </linearGradient>
                    <radialGradient id="hiwSun" cx=".78" cy=".68" r=".5">
                      <stop offset="0" stop-color="#ffe2b0" stop-opacity=".85" />
                      <stop offset="1" stop-color="#ffe2b0" stop-opacity="0" />
                    </radialGradient>
                    <linearGradient id="hiwWood" x1="0" y1="0" x2="1" y2="0">
                      <stop offset="0" stop-color="#8a6140" />
                      <stop offset="1" stop-color="#5a3d27" />
                    </linearGradient>
                    <linearGradient id="hiwConcrete" x1="0" y1="0" x2="0" y2="1">
                      <stop offset="0" stop-color="#e6eaee" />
                      <stop offset="1" stop-color="#b9c1c9" />
                    </linearGradient>
                    <linearGradient id="hiwGlassOff" x1="0" y1="0" x2="0" y2="1">
                      <stop offset="0" stop-color="#27384f" />
                      <stop offset="1" stop-color="#17243a" />
                    </linearGradient>
                    <linearGradient id="hiwGlassOn" x1="0" y1="0" x2="0" y2="1">
                      <stop offset="0" stop-color="#ffe2ac" />
                      <stop offset="1" stop-color="#f2a85c" />
                    </linearGradient>
                    <linearGradient id="hiwGround" x1="0" y1="0" x2="0" y2="1">
                      <stop offset="0" stop-color="#1b2735" />
                      <stop offset="1" stop-color="#0a121c" />
                    </linearGradient>
                    <linearGradient id="hiwWater" x1="0" y1="0" x2="0" y2="1">
                      <stop offset="0" stop-color="#2a3d57" />
                      <stop offset="1" stop-color="#0d1a2a" />
                    </linearGradient>
                    <filter id="hiwBlur" x="-20%" y="-20%" width="140%" height="140%">
                      <feGaussianBlur stdDeviation="3" />
                    </filter>
                  </defs>

                  <!-- sky -->
                  <rect width="240" height="150" fill="url(#hiwSky)" />
                  <rect width="240" height="150" fill="url(#hiwSun)" />
                  <g fill="#fff" opacity=".7">
                    <circle cx="26" cy="14" r=".7" /><circle cx="64" cy="9" r=".6" /><circle cx="118" cy="16" r=".7" />
                    <circle cx="160" cy="8" r=".6" /><circle cx="210" cy="17" r=".7" />
                  </g>

                  <g class="r">
                    <!-- distant tree line -->
                    <path d="M0 100 Q20 90 40 98 T80 96 T130 99 T180 94 T240 100 V108 H0Z" fill="#1a2a3a" />

                    <!-- ground + pool -->
                    <rect y="106" width="240" height="44" fill="url(#hiwGround)" />
                    <rect x="52" y="118" width="150" height="26" rx="2" fill="url(#hiwWater)" />

                    <!-- lower volume -->
                    <rect x="44" y="84" width="46" height="26" fill="url(#hiwWood)" />
                    <g stroke="#3d2818" stroke-opacity=".5" stroke-width=".6">
                      <path d="M52 84V110M60 84V110M68 84V110M76 84V110M84 84V110" />
                    </g>
                    <rect x="90" y="84" width="104" height="26" fill="#10192a" />
                    <rect x="93" y="87" width="98" height="22" fill="url(#hiwGlassOff)" />

                    <!-- upper volume -->
                    <rect x="72" y="58" width="130" height="26" fill="url(#hiwConcrete)" />
                    <rect x="84" y="63" width="108" height="14" fill="#10192a" />
                    <rect x="85" y="64" width="106" height="12" fill="url(#hiwGlassOff)" />

                    <!-- roof slab -->
                    <rect x="66" y="54.5" width="142" height="3.6" fill="#f2f4f6" />
                    <rect x="66" y="58" width="142" height="1.4" fill="#000" fill-opacity=".25" />
                    <!-- cantilever shadow -->
                    <rect x="72" y="84" width="130" height="5" fill="#000" fill-opacity=".28" />

                    <!-- trees -->
                    <g fill="#0f1c2a">
                      <circle cx="26" cy="96" r="12" /><circle cx="36" cy="102" r="9" />
                      <circle cx="214" cy="98" r="11" /><circle cx="224" cy="104" r="8" />
                    </g>
                    <rect x="24" y="104" width="2.4" height="8" fill="#0a1420" />
                  </g>

                  <!-- warm light turning on -->
                  <g class="lit">
                    <ellipse cx="142" cy="112" rx="62" ry="9" fill="#ffc77a" opacity=".35" filter="url(#hiwBlur)" />
                    <rect x="93" y="87" width="98" height="22" fill="url(#hiwGlassOn)" />
                    <rect x="85" y="64" width="106" height="12" fill="url(#hiwGlassOn)" />
                    <!-- interior silhouettes -->
                    <g fill="#7a4a24" fill-opacity=".55">
                      <rect x="102" y="100" width="26" height="9" rx="2" />
                      <rect x="102" y="96" width="26" height="5" rx="2" />
                      <rect x="150" y="98" width="16" height="11" rx="1" />
                    </g>
                    <g stroke="#ffe9c4" stroke-width=".6">
                      <path d="M140 87V93M176 87V92" />
                    </g>
                    <g fill="#fff3d6">
                      <circle cx="140" cy="94" r="1.8" /><circle cx="176" cy="93" r="1.8" />
                    </g>
                    <!-- reflection in pool -->
                    <rect x="93" y="120" width="98" height="9" fill="#ffc77a" opacity=".28" filter="url(#hiwBlur)" />
                    <rect x="100" y="132" width="84" height="4" fill="#ffc77a" opacity=".16" filter="url(#hiwBlur)" />
                  </g>

                  <!-- window mullions (always on top) -->
                  <g class="r" stroke="#0c1522" stroke-width="1">
                    <path d="M117 87V109M141 87V109M165 87V109M110 64V76M135 64V76M160 64V76" />
                    <path d="M93 98H191" stroke-opacity=".5" stroke-width=".6" />
                  </g>

                  <!-- subtle vignette -->
                  <rect width="240" height="150" fill="none" stroke="#000" stroke-opacity=".0" />
                </svg>
              )}
            </div>

            <h3>{s.title}</h3>
            <p>{s.desc}</p>

            <ul class="hiw-checks">
              {s.checks.map((c) => (
                <li>
                  <span class="hiw-check-dot">
                    <svg width="10" height="10" viewBox="0 0 12 12" fill="none"><path d="M2.5 6.5L5 9L9.5 3.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
                  </span>
                  <span>{c}</span>
                </li>
              ))}
            </ul>

            <div class="hiw-progress"></div>
          </article>

          {i < steps.length - 1 && (
            <span class="hiw-step-arrow" data-arrow={i} aria-hidden="true">→</span>
          )}
        </>
      ))}
    </div>


  </div>
</section>

<script>
  function setupHowItWorks() {
    const section = document.getElementById("howItWorks");
    const wrap = document.getElementById("hiwSteps");
    if (!section || !wrap || section.dataset.ready === "true") return;
    section.dataset.ready = "true";

    const steps = Array.from(wrap.querySelectorAll<HTMLElement>(".hiw-step"));
    const arrows = Array.from(wrap.querySelectorAll<HTMLElement>(".hiw-step-arrow"));
    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    let current = 0;
    let started = false;

    function render() {
      steps.forEach((step, i) => {
        step.classList.toggle("is-active", i === current);
        step.classList.toggle("is-done", i < current);
      });
      arrows.forEach((a, i) => a.classList.toggle("is-lit", i <= current));
    }

    function goTo(i: number) {
      current = (i + steps.length) % steps.length;
      render();
    }

    steps.forEach((step, i) => {
      step.querySelector(".hiw-progress")?.addEventListener("animationend", () => {
        if (i === current && !reduce) goTo(current + 1);
      });
      step.addEventListener("click", () => goTo(i));
      step.addEventListener("keydown", (e) => {
        if (e.key === "Enter" || e.key === " ") { e.preventDefault(); goTo(i); }
        if (e.key === "ArrowRight") { e.preventDefault(); goTo(current + 1); steps[current].focus(); }
        if (e.key === "ArrowLeft")  { e.preventDefault(); goTo(current - 1); steps[current].focus(); }
      });
    });

    // Start only when the section is visible
    new IntersectionObserver(([entry]) => {
      if (entry.isIntersecting && !started) {
        started = true;
        section.classList.add("is-in");
        if (reduce) { current = steps.length - 1; }
        render();
      }
      section.classList.toggle("is-offscreen", !entry.isIntersecting);
    }, { threshold: 0.3 }).observe(section);

    render();
  }

  document.addEventListener("DOMContentLoaded", setupHowItWorks);
  document.addEventListener("astro:page-load", setupHowItWorks);
</script>