---
import "../styles/Marquee.css";

// Items yahan se badlein. Total 8 (even) rakhein taake bright/dim ka pattern loop mein na tootay.
const items = [
  "Photoreal Renders",
  "Walkthroughs",
  "Real Time & VR",
  "BIM Production",
  "Revit Modeling",
  "MEP Coordination",
  "Archviz",
  "3D Visualization",
];
---

<section class="marquee" aria-label="Services">
  <div class="marquee-glow" aria-hidden="true"></div>

  <div class="marquee-track">
    {/* Set 1 */}
    <ul class="marquee-set">
      {items.map((t) => <li>{t}</li>)}
    </ul>
    {/* Set 2 (seamless loop ke liye duplicate) */}
    <ul class="marquee-set" aria-hidden="true">
      {items.map((t) => <li>{t}</li>)}
    </ul>
  </div>
</section>