---
import "../styles/process.css";

const steps = [
  {
    num: "01",
    tag: "INPUTS",
    title: "Confirm inputs, standards and responsibility matrix",
    detail: "Establish the source information, project standards, responsibilities and approval ownership before production begins."
  },
  {
    num: "02",
    tag: "PRODUCTION",
    title: "Produce against governed scope and change control",
    detail: "Work progresses against an agreed scope with structured revisions and controlled changes."
  },
  {
    num: "03",
    tag: "REVIEW",
    title: "Return decisions to client-authorized approvers",
    detail: "Review points are routed back to the people responsible for design and project decisions."
  },
  {
    num: "04",
    tag: "HANDOFF",
    title: "Issue status, assumptions and structured handoff",
    detail: "Final outputs are issued with clear status, assumptions and agreed delivery formats."
  }
];
---

<section class="production-layer" id="process">
  <div class="pl-wrap">
    <!-- Header Area -->
    <div class="pl-heading-area">
      <div class="pl-heading-line"></div>
      <div class="pl-heading-content">
        <p class="pl-tag">HOW WE WORK</p>
        <h2 class="pl-heading">
          Technically aligned <span>before production starts.</span>
        </h2>
        <p class="pl-intro">
          Clear inputs, controlled production and defined approval routes keep every package aligned from start to handoff.
        </p>
      </div>
      <div class="pl-heading-line"></div>
    </div>

    <!-- Process Steps Grid -->
    <div class="pl-grid">
      {steps.map((step) => (
        <article class="pl-card">
          <div class="pl-card-top">
            <span class="pl-num">{step.num}</span>
            <span class="pl-step-tag">{step.tag}</span>
          </div>
          <div class="pl-card-body">
            <h3>{step.title}</h3>
            <p>{step.detail}</p>
          </div>
          <div class="pl-card-indicator"></div>
        </article>
      ))}
    </div>
  </div>
</section>