---
import "../styles/process.css";

const steps = [
  {
    num: "01", tag: "INPUTS", title: "Confirm inputs & standards",
    detail: "Establish source information, project standards, and approval ownership.",
    items: ["Source files received", "Standards confirmed", "Approval owner set"],
  },
  {
    num: "02", tag: "PRODUCTION", title: "Governed production",
    detail: "Work progresses against an agreed scope with structured revisions.",
    items: ["Scope locked", "Revision R2 logged", "Progress tracked"],
  },
  {
    num: "03", tag: "REVIEW", title: "Client-authorized reviews",
    detail: "Review points are routed back to the key project decision-makers.",
    items: ["Routed to reviewer", "Comments resolved", "Sign-off received"],
  },
  {
    num: "04", tag: "HANDOFF", title: "Structured handoff",
    detail: "Final outputs are issued with clear status and agreed delivery formats.",
    items: ["Status: Issued", "Formats verified", "Package delivered"],
  },
];
---

<section class="production-layer" id="process">
  <div class="pl-sketch-bg"></div>
  <div class="pl-glow-orb orb-1"></div>
  <div class="pl-glow-orb orb-2"></div>
  <div class="pl-glow-orb orb-3"></div>

  <div class="pl-wrap">
    <header class="pl-head">
      <span class="pl-tag">HOW WE WORK</span>
      <h2 class="pl-heading">
        <span class="pl-hl">Technically aligned</span>
        <span>before production starts.</span>
      </h2>
      <p class="pl-intro">
        Clear inputs, controlled production, and defined approval routes keep every package aligned from start to handoff.
      </p>
    </header>

    <div class="pl-flow" data-flow>
      {steps.map((step, i) => (
        <>
          <article class="pl-card" data-step={i} style={`--i:${i}`} tabindex="0">
            <div class="pl-card-top">
              <span class="pl-num">{step.num}</span>
              <span class="pl-step-tag">{step.tag}</span>
            </div>

            <div class="pl-icon" aria-hidden="true">
              {i === 0 && (
                <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M12 6h16l10 10v26a2 2 0 0 1-2 2H12a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2z"/>
                  <path d="M28 6v10h10"/>
                  <path class="ic-draw" d="M17 30l5 5 9-10"/>
                </svg>
              )}
              {i === 1 && (
                <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <g class="ic-spin"><circle cx="24" cy="24" r="6"/>
                  <path d="M24 6v6M24 36v6M6 24h6M36 24h6M11.3 11.3l4.2 4.2M32.5 32.5l4.2 4.2M11.3 36.7l4.2-4.2M32.5 15.5l4.2-4.2"/></g>
                </svg>
              )}
              {i === 2 && (
                <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M4 24s7-12 20-12 20 12 20 12-7 12-20 12S4 24 4 24z"/>
                  <circle class="ic-pupil" cx="24" cy="24" r="5"/>
                </svg>
              )}
              {i === 3 && (
                <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M6 16l18-10 18 10v16L24 42 6 32z"/>
                  <path d="M6 16l18 10 18-10M24 26v16"/>
                </svg>
              )}
            </div>

            <h3 class="pl-card-title">{step.title}</h3>
            <p class="pl-card-detail">{step.detail}</p>

            <ul class="pl-mini">
              {step.items.map((it, k) => (
                <li style={`--d:${k * 260 + 250}ms`}>
                  <span class="pl-check">
                    <svg viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2.5 6.2l2.4 2.4 4.6-5"/></svg>
                  </span>
                  {it}
                </li>
              ))}
            </ul>
            <div class="pl-bar"><i></i></div>
          </article>

          {i < steps.length - 1 && (
            <div class="pl-arrow" data-arrow={i} aria-hidden="true">
              <span class="pl-arrow-dot">
                <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 8h10M9 4l4 4-4 4"/></svg>
              </span>
            </div>
          )}
        </>
      ))}
    </div>
  </div>
</section>

<script>
  const flow = document.querySelector<HTMLElement>("[data-flow]");
  if (flow) {
    const cards = [...flow.querySelectorAll<HTMLElement>(".pl-card")];
    const arrows = [...flow.querySelectorAll<HTMLElement>(".pl-arrow")];
    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    let current = -1, timer: number | undefined, paused = false;

    const activate = (n: number) => {
      current = n;
      cards.forEach((c, i) => c.classList.toggle("is-active", i === n));
      arrows.forEach((a, i) => a.classList.toggle("is-on", i < n || i === n));
    };
    const next = () => { if (!paused) activate((current + 1) % cards.length); };
    const start = () => { if (!timer && !reduce) timer = window.setInterval(next, 3200); };
    const stop = () => { clearInterval(timer); timer = undefined; };

    cards.forEach((c, i) => {
      c.addEventListener("mouseenter", () => { paused = true; activate(i); });
      c.addEventListener("mouseleave", () => { paused = false; });
      c.addEventListener("focus", () => { paused = true; activate(i); });
      c.addEventListener("blur", () => { paused = false; });
    });

    new IntersectionObserver(([e]) => {
      if (e.isIntersecting) { if (current < 0) activate(0); start(); } else stop();
    }, { threshold: 0.35 }).observe(flow);
  }
</script>