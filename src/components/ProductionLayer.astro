---

<!-- =====================================================
     UX BRIEF — SERVICES (PRODUCTION LAYER)
     Visitor ka sawal : "Mujhe in se kya milega?"
     Har card ab 3 cheezein batata hai: naam, "ye kya hai" (plain words), "You get" (deliverable).
     ===================================================== -->

<div class="px-services-wrapper" id="px-section">
  <div class="px-sketch-bg" aria-hidden="true"></div>

  <div class="px-container">
    <!-- Header -->
   <div class="px-header">
  <span class="px-eyebrow">SERVICES</span>
  <h2>
    <span class="px-line">From model information to</span>
    <span class="px-line px-highlight">stake holder ready output</span>
  </h2>
  <p class="px-subtext">
    <!-- <span class="px-line">Clear inputs, controlled production and defined approval routes keep every package aligned</span>
    <span class="px-line">from start to handoff.</span> -->
  </p>

  <!-- NEW (UX): maqsad = section kaise use karna hai, ye pehle hi bata do -->
  <p class="px-helper">
    Find the service you need. Each card shows what it is and what you receive.
  </p>

  <!-- NEW (UX): maqsad = khud chalti hui cheez ko rokne ka control (padhne ke liye) -->
  <button type="button" class="px-pause" id="px-pause" aria-pressed="false">
    <span class="px-pause-icon" aria-hidden="true">❚❚</span>
    <span id="px-pause-label">Pause scrolling</span>
  </button>
</div>

    <!-- Horizontal Auto-Scrolling Slider -->
    <div class="px-slider-wrap">
      <div class="px-slider-track">
        {infiniteSteps.map((step, i) => (
          <div class="px-card" aria-hidden={i >= steps.length ? "true" : undefined}>
            <img class="px-card-bg" src={small(step.image)} alt={step.detail} width="270" height="370" loading="lazy" decoding="async" />
            <div class="px-card-overlay"></div>
            <span class="px-card-num">{step.num}</span>
            <!-- NEW (UX): maqsad = service ka group (Model / Visuals / Interactive) -->
            <span class="px-card-kind">{step.kind}</span>

            <div class="px-card-content">
              <p class="px-card-desc">{step.detail}</p>

              {/* <p class="px-card-get"><strong>You get</strong> {step.get}</p>    */}

              <a href={`/services/${step.slug}`} class="px-scope-btn" tabindex={i >= steps.length ? -1 : undefined}>
                <span>Review technical scope</span>
                <span class="arrow">↗</span>
              </a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</div>

<script>
  // 1) warm up the images BEFORE the section arrives (load + decode)
  // 2) start the animations only when the section is visible AND the images are ready
  //    -> nothing heavy happens at the exact moment the user arrives
  const initProductionLayer = () => {
    const section = document.getElementById("px-section");
    if (!section || section.dataset.ready === "1") return;
    section.dataset.ready = "1";

    // NEW (UX): pause / play button
    const pauseBtn = document.getElementById("px-pause");
    const pauseLabel = document.getElementById("px-pause-label");
    if (pauseBtn) {
      pauseBtn.addEventListener("click", () => {
        const paused = section.classList.toggle("is-paused");
        pauseBtn.setAttribute("aria-pressed", String(paused));
        if (pauseLabel) pauseLabel.textContent = paused ? "Play scrolling" : "Pause scrolling";
      });
    }

    const imgs = Array.from(section.querySelectorAll<HTMLImageElement>(".px-card-bg"));
    let warmPromise: Promise<unknown> | null = null;

    const warm = () => {
      if (!warmPromise) {
        warmPromise = Promise.all(
          imgs.map((img) => {
            img.loading = "eager";
            return img.decode ? img.decode().catch(() => {}) : Promise.resolve();
          })
        );
      }
      return warmPromise;
    };

    // start loading when the section is still ~1.5 screens away
    const warmObserver = new IntersectionObserver(
      (entries) => {
        if (entries.some((e) => e.isIntersecting)) {
          warm();
          warmObserver.disconnect();
        }
      },
      { rootMargin: "1500px 0px" }
    );
    warmObserver.observe(section);

    // arrival: animate once images are decoded (max wait 800ms so it never gets stuck)
    const showObserver = new IntersectionObserver(
      (entries) => {
        if (!entries.some((e) => e.isIntersecting)) return;
        showObserver.disconnect();
        Promise.race([warm(), new Promise((r) => setTimeout(r, 800))]).then(() => {
          requestAnimationFrame(() => section.classList.add("is-visible"));
        });
      },
      { threshold: 0.15 }
    );
    showObserver.observe(section);
  };

  document.addEventListener("DOMContentLoaded", initProductionLayer);
  document.addEventListener("astro:page-load", initProductionLayer);
  if (document.readyState !== "loading") initProductionLayer();
</script>