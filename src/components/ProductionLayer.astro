---
import "../styles/production-layer.css";

const services = [
  {
    title: "BIM production",
    desc: "A coordinated model that carries every piece of building data, plus drawing sets. RVT, IFC, NWD.",
    image: "https://images.unsplash.com/photo-1600585154340-be6161a56a0c?auto=format&fit=crop&w=1200&q=80",
    slug: "bim-production",
    gridClass: "card-col-7",
  },
  {
    title: "Revit production",
    desc: "Construction drawing sets, plans, sections and schedules drafted directly in Revit.",
    image: "https://images.unsplash.com/photo-1600596542815-ffad4c1539a9?auto=format&fit=crop&w=1200&q=80",
    slug: "revit-production",
    gridClass: "card-col-5",
  },
  {
    title: "MEP coordination",
    desc: "Services modelled and clash checked before site.",
    // New high-detail MEP / Industrial Piping & Ductwork image
    image: "https://images.unsplash.com/photo-1581092160607-ee22621dd758?auto=format&fit=crop&w=1200&q=80",
    slug: "mep-coordination",
    gridClass: "card-col-4",
  },
  {
    title: "Archviz stills",
    desc: "Photoreal interiors and exteriors for sales and planning.",
    image: "https://images.unsplash.com/photo-1600585154526-990dced4db0d?auto=format&fit=crop&w=1200&q=80",
    slug: "archviz-stills",
    gridClass: "card-col-4",
  },
  {
    title: "Animation",
    desc: "Cinematic walkthrough films in 4K.",
    image: "https://images.unsplash.com/photo-1613977257363-707ba9348227?auto=format&fit=crop&w=1200&q=80",
    slug: "animation",
    gridClass: "card-col-4",
  },
  {
    title: "Real time & VR",
    desc: "Unreal Engine tours for web, screens and headsets.",
    image: "https://images.unsplash.com/photo-1600607687939-ce8a6c25118c?auto=format&fit=crop&w=1600&q=80",
    slug: "real-time-vr",
    gridClass: "card-col-12",
  },
];
---

<section class="pl-section" id="services">
  <div class="pl-container">
    
    <!-- Header with Screenshot Monospace Style -->
    <div class="pl-header">
      <span class="pl-tag">SERVICES</span>
      <h2 class="pl-title">
        The full <span class="pl-highlight">pipeline.</span>
      </h2>
    </div>

    <!-- Cards Grid -->
    <div class="pl-grid">
      {services.map((item) => (
        <a href={`/services/${item.slug}`} class={`pl-card ${item.gridClass}`} aria-label={item.title}>
          <img 
            src={item.image} 
            alt={item.title} 
            class="pl-card-img" 
            loading="lazy" 
            decoding="async" 
          />
          <div class="pl-card-overlay" aria-hidden="true"></div>
          
          <div class="pl-card-content">
            <h3 class="pl-card-title">{item.title}</h3>
            <p class="pl-card-desc">{item.desc}</p>
          </div>
        </a>
      ))}
    </div>

  </div>
</section>