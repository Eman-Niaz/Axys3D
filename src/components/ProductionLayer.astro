    detail: "Revit Production",
    slug: "revit-production",
    image: "https://fiverr-res.cloudinary.com/images/t_main1%2Cq_auto%2Cf_auto%2Cq_auto%2Cf_auto/gigs2/450084919/original/490fd759b0ef419af08efbe26f7acd7d9c79a822/build-complete-revit-bim-model-architecture-layout-and-3d-visualization.png",
  },
  {
    num: "03",
    detail: "MEP Coordination",
    slug: "mep-coordination",
    image: "https://www.teslacad.com.au/images/img2.webp",
  },
  {
    num: "04",
    detail: "3DModeling",
    slug: "3d-modeling",
    image: "https://images.unsplash.com/photo-1545324418-cc1a3fa10c00?auto=format&fit=crop&w=1200&q=85",
  },
  {
    num: "05",
    detail: "Architectural Visualization",
    slug: "architectural-visualization",
    image: "https://images.unsplash.com/photo-1600607687920-4e2a09cf159d?auto=format&fit=crop&w=1200&q=85",
  },
  {
    num: "06",
    detail: "Real-time Experiences",
    slug: "real-time",
    image: "https://images.unsplash.com/photo-1593508512255-86ab42a8e620?auto=format&fit=crop&w=1200&q=85",
  },
  {
    num: "07",
    detail: "3D Max Production",
    slug: "3ds-max-production",
    image: "https://tewbhv.vtexassets.com/arquivos/ids/158339/DN%7C547%7C401%7C935%7C118%7C399.png?v=638007725075500000",
  },
  {
    num: "08",
    detail: "Animation & Motion",
    slug: "animation-motion",
    image: "https://images.unsplash.com/photo-1486406146926-c627a92ad1ab?auto=format&fit=crop&w=1200&q=85",
  },
];

const infiniteSteps = [...steps, ...steps];
---

<div class="px-services-wrapper" id="px-section">
  <div class="px-sketch-bg" aria-hidden="true"></div>

  <div class="px-container">
    <!-- Header -->
   <div class="px-header">
  <span class="px-eyebrow">ONE PRODUCTION LAYER</span>
  <h2>
    <span class="px-line">From model information to</span>
    <span class="px-line px-highlight">stake-holder ready output</span>
  </h2>
  <p class="px-subtext">
    <span class="px-line">Clear inputs, controlled production and defined approval routes keep every package aligned</span>
    <span class="px-line">from start to handoff.</span>
  </p>
</div>

    <!-- Horizontal Auto-Scrolling Slider -->
    <div class="px-slider-wrap">
      <div class="px-slider-track">
        {infiniteSteps.map((step) => (
          <div class="px-card">
            <img class="px-card-bg" src={step.image} alt={step.detail} loading="lazy" />
            <div class="px-card-overlay"></div>
            <span class="px-card-num">{step.num}</span>

            <div class="px-card-content">
              <p class="px-card-desc">{step.detail}</p>
              
              <a href={`/services/${step.slug}`} class="px-scope-btn">
                <span>Review technical scope</span>
                <span class="arrow">↗</span>
              </a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</div>

<script>
  // Strict Scroll Trigger logic
  const initObserver = () => {
    const section = document.getElementById("px-section");
    if (!section) return;

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          // Jab tak section sach me screen par nahi dikhta, animation trigger nahi hogi
          if (entry.isIntersecting) {
            section.classList.add("is-visible");
            observer.unobserve(entry.target);
          }
        });
      },
      {
        root: null,
        rootMargin: "0px",
        threshold: 0.15 // Section ka kam se kam 15% hissa screen par visible hona zaruri hai
      }
    );

    observer.observe(section);
  };

  // Astro page transitions aur direct loads dono ko handle karta hai
  document.addEventListener("DOMContentLoaded", initObserver);
  document.addEventListener("astro:page-load", initObserver);
</script>