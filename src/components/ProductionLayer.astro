---
import "../styles/production-layer.css";

const steps = [
  {
    num: "01",
    label: "BIM execution",
    detail: "Model setup, standards and information input.",
    slug: "bim-execution",
    image:
      "https://tewbhv.vtexassets.com/arquivos/ids/158339/DN%7C547%7C401%7C935%7C118%7C399.png?v=638007725075500000",
  },
  {
    num: "02",
    label: "Revit production",
    detail: "Architectural, structural and documentation models.",
    slug: "revit-production",
    image:
      "https://fiverr-res.cloudinary.com/images/t_main1%2Cq_auto%2Cf_auto%2Cq_auto%2Cf_auto/gigs2/450084919/original/490fd759b0ef419af08efbe26f7acd7d9c79a822/build-complete-revit-bim-model-architecture-layout-and-3d-visualization.png",
  },
  {
    num: "03",
    label: "MEP support",
    detail: "Coordinated MEP models and clash resolution.",
    slug: "mep-coordination",
    image:
      "https://www.teslacad.com.au/images/img2.webp",
  },
  {
    num: "04",
    label: "3D modeling + animation",
    detail: "Clean geometry and motion where needed.",
    slug: "3d-modeling",
    image:
      "https://images.unsplash.com/photo-1545324418-cc1a3fa10c00?auto=format&fit=crop&w=1200&q=85",
  },
  {
    num: "05",
    label: "Visualization + animation",
    detail: "High-quality renders, views and narratives.",
    slug: "visualization",
    image:
      "https://images.unsplash.com/photo-1600607687920-4e2a09cf159d?auto=format&fit=crop&w=1200&q=85",
  },
  {
    num: "06",
    label: "Real-time + handoff",
    detail: "Interactive models and real-time experiences.",
    slug: "real-time",
    image:
      "https://images.unsplash.com/photo-1593508512255-86ab42a8e620?auto=format&fit=crop&w=1200&q=85",
  },
  {
    num: "07",
    label: "Technical documentation",
    detail: "Drawings, schedules and supporting documents.",
    slug: "handoff",
    image:
      "https://tewbhv.vtexassets.com/arquivos/ids/158339/DN%7C547%7C401%7C935%7C118%7C399.png?v=638007725075500000",
  },
  {
    num: "08",
    label: "Handoff + delivery",
    detail: "Organized deliverables and final handover.",
    slug: "handoff",
    image:
      "https://images.unsplash.com/photo-1486406146926-c627a92ad1ab?auto=format&fit=crop&w=1200&q=85",
  },
];
---

<style>
  /* Reset default <a> styling so the card keeps its original block layout */
  a.prod-card {
    display: block;
    text-decoration: none;
    color: inherit;
    cursor: pointer;
  }

  /* Let clicks pass through decorative inner layers straight to the link,
     without touching their original position/layout */
  a.prod-card .pl-image-wrap,
  a.prod-card .pl-image,
  a.prod-card .pl-image-overlay,
  a.prod-card .pl-detail,
  a.prod-card .pl-card-info {
    pointer-events: none;
  }
</style>

<section class="production-layer">

  <div class="pl-wrap">

   <div class="pl-heading-area">

  <div class="pl-heading-line"></div>

  <div class="pl-heading-content">
    <p class="pl-tag">Production pipeline</p>

    <h2 class="pl-heading">
      From model information to
      <span>stakeholder-ready output.</span>
    </h2>

    <p class="pl-intro">
      A controlled production workflow connecting approved design information
      to coordinated, presentation-ready and handoff-ready outputs.
    </p>
  </div>

  <div class="pl-heading-line"></div>

</div>

    <div class="pl-grid">

      {steps.map((step) => (
        <a class="prod-card" href={`/Services/${step.slug}`}>

          <div class="pl-image-wrap">

            <img
              src={step.image}
              alt={step.label}
              class="pl-image"
              loading="lazy"
            />

            <div class="pl-image-overlay"></div>

            <div class="pl-detail">
              {step.detail}
            </div>

          </div>

          <div class="pl-card-info">
            <span class="pl-num">{step.num}</span>

            <h3>{step.label}</h3>
          </div>

        </a>
      ))}

    </div>

  </div>

</section>