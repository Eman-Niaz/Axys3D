---
import "../styles/services.css";

const services = [
  {
    number: "01",
    title: "BIM execution and model production",
    shortTitle: "BIM execution",
    location: "AEC PRODUCTION • 01",
    description:
      "Disciplined BIM production from approved design information, with controlled model structure, geometry and documentation.",
    image:
      "https://images.unsplash.com/photo-1600585154340-be6161a56a0c?auto=format&fit=crop&w=1800&q=85",
  },
  {
    number: "02",
    title: "Revit production",
    shortTitle: "Revit production",
    location: "PARAMETRIC MODELING • 02",
    description:
      "Production-ready Revit modeling and documentation built around project standards, templates and approved design information.",
    image:
      "https://images.unsplash.com/photo-1600607687920-4e2a09cf159d?auto=format&fit=crop&w=1800&q=85",
  },
  {
    number: "03",
    title: "MEP coordination support",
    shortTitle: "MEP coordination",
    location: "CLASH REVIEW • 03",
    description:
      "Structured coordination support across architectural, structural and MEP information to reduce downstream production friction.",
    image:
      "https://images.unsplash.com/photo-1541888946425-d81bb19240f5?auto=format&fit=crop&w=1800&q=85",
  },
  {
    number: "04",
    title: "3D modeling and digital production",
    shortTitle: "3D modeling",
    location: "DIGITAL ASSETS • 04",
    description:
      "Controlled geometry and asset production from approved drawings, BIM references, surveys and client-issued design information.",
    image:
      "https://images.unsplash.com/photo-1542621334-a254cf47733d?auto=format&fit=crop&w=1800&q=85",
  },
  {
    number: "05",
    title: "Architectural visualization",
    shortTitle: "Visualization",
    location: "CGI RENDERING • 05",
    description:
      "High-quality architectural visuals that translate approved design information into clear, presentation-ready imagery.",
    image:
      "https://images.unsplash.com/photo-1600566753086-00f18fb6b3ea?auto=format&fit=crop&w=1800&q=85",
  },
  {
    number: "06",
    title: "Animation and walkthroughs",
    shortTitle: "Animation",
    location: "SPATIAL MOTION • 06",
    description:
      "Production-focused animation and walkthroughs that communicate spatial intent, design progression and project experience.",
    image:
      "https://images.unsplash.com/photo-1600607688969-a5bfcd646154?auto=format&fit=crop&w=1800&q=85",
  },
  {
    number: "07",
    title: "Real-time experiences",
    shortTitle: "Real-time",
    location: "INTERACTIVE SCENES • 07",
    description:
      "Interactive real-time environments built from controlled project geometry for review, communication and visual exploration.",
    image:
      "https://images.unsplash.com/photo-1593508512255-86ab42a8e620?auto=format&fit=crop&w=1800&q=85",
  },
  {
    number: "08",
    title: "Documentation and handoff",
    shortTitle: "Handoff",
    location: "DRAWING PACKAGES • 08",
    description:
      "Organized documentation, exports and structured handoff packages designed to keep production information usable downstream.",
    image:
      "https://images.unsplash.com/photo-1454165804606-c3d57bc86b40?auto=format&fit=crop&w=1800&q=85",
  },
];

// Duplicate dataset to support a seamless continuous loop
const loopedServices = [...services, ...services, ...services];

// smaller images = far less decoding / memory (was 1800px everywhere, even for 230px cards)
const bgUrl = (u: string) => u.replace("w=1800&q=85", "w=1600&q=70");
const cardUrl = (u: string) => u.replace("w=1800&q=85", "w=520&q=70");
---

<section class="cinematic-services-root" id="services">
  <!-- Horizontal Screen Slider Container -->
  <div class="horizontal-screen-slider" id="horizontalScreenSlider">
    
    <!-- =====================================================
         SCREEN 1: CLEAN FULLSCREEN SERVICE SHOWCASE
         ===================================================== -->
    <div class="screen-panel services-screen">
      
      <!-- Minimized Overlay Backgrounds -->
      <div class="screen-bg-stack">
        {services.map((item, idx) => (
          <div class={`screen-bg-image ${idx === 0 ? "is-active" : ""}`} data-bg-index={idx}>
            <img
              src={idx === 0 ? bgUrl(item.image) : undefined}
              data-src={bgUrl(item.image)}
              alt={item.title}
              decoding="async"
              fetchpriority={idx === 0 ? "high" : "low"}
            />
          </div>
        ))}
        <div class="screen-bg-darkener"></div>
      </div>

      <!-- Main Layout: Left Active Info & Right 3+ Card Carousel -->
      <div class="services-main-layout">
        
        <!-- LEFT: Active Service Detailed Information -->
        <div class="active-service-details">
          {services.map((service, idx) => (
            <div class={`service-info-pane ${idx === 0 ? "is-active" : ""}`} data-info-index={idx}>
              <span class="service-category-tag">{service.shortTitle}</span>
              <h2 class="service-primary-title">{service.title}</h2>
              <p class="service-primary-desc">{service.description}</p>
              
              <a
                class="service-discover-btn"
                href={`/Visuals?category=${encodeURIComponent(service.shortTitle)}`}
              >
                <span>DISCOVER LOCATION</span>
                <span class="btn-arrow">↗</span>
              </a>
            </div>
          ))}
        </div>

        <!-- RIGHT: Infinite Upcoming Cards Tray (Min 3 visible at all times) -->
        <div class="upcoming-cards-viewport">
          <div class="upcoming-cards-track" id="cardsTrack">
            {loopedServices.map((service, idx) => (
              <div
                class="upcoming-card-item"
                data-original-index={idx % services.length}
                data-loop-index={idx}
                tabindex="0"
                role="button"
                aria-label={`Switch to ${service.title}`}
              >
                <div class="upcoming-card-img">
                  <img src={cardUrl(service.image)} alt={service.title} width="230" height="350" loading="lazy" decoding="async" />
                  <div class="upcoming-card-shade"></div>
                </div>

                <div class="upcoming-card-content">
                  <span class="upcoming-card-mini">{service.shortTitle}</span>
                  <h3 class="upcoming-card-title">{service.title}</h3>
                </div>
              </div>
            ))}
          </div>
        </div>

      </div>

      <!-- BOTTOM NAVIGATION: Arrows, Timeline, Slide Counter, and Compare Trigger -->
      <div class="services-nav-bar">
        <div class="nav-arrow-group">
          <button class="nav-arrow-btn prev-btn" aria-label="Previous service">‹</button>
          <button class="nav-arrow-btn next-btn" aria-label="Next service">›</button>
        </div>

        <div class="nav-timeline-bar">
          <div class="nav-timeline-fill" id="timelineFill"></div>
        </div>

        <div class="nav-controls-right">
          <div class="nav-counter">
            <span id="currentNumber">01</span>
            <span class="counter-divider">/</span>
            <span class="total-number">08</span>
          </div>

          <button class="go-to-compare-btn" id="goToCompareBtn">
            <span>COMPARE MODEL</span>
            <span class="btn-arrow">→</span>
          </button>
        </div>
      </div>

    </div>

    <!-- =====================================================
         SCREEN 2: SEPARATE FROM MODEL TO EXPERIENCE SECTION
         ===================================================== -->
    <div class="screen-panel model-experience-screen">
      <div class="model-experience-container">
        
        <!-- HEADING -->
        <div class="model-experience-heading">
          <div>
            <span class="section-eyebrow">
              FROM MODEL TO EXPERIENCE
            </span>
            <h2>
              See the production
              <span>layer in motion.</span>
            </h2>
          </div>

          <p>
            Move the slider to compare the raw production model with the final visual output.
          </p>
        </div>

        <!-- COMPARISON WRAPPER -->
        <div class="comparison-wrapper">
          <!-- FINAL RENDER -->
          <div class="comparison-image comparison-final">
            <img
              src="https://images.unsplash.com/photo-1600607687939-ce8a6c25118c?auto=format&fit=crop&w=1400&q=75"
              alt="Final architectural render"
              loading="lazy"
              decoding="async"
            />
            <div class="comparison-label final-label">
              <span>02</span>
              FINAL RENDER
            </div>
          </div>

          <!-- RAW MODEL -->
          <div class="comparison-image comparison-before">
            <img
              src="https://images.unsplash.com/photo-1600585154340-be6161a56a0c?auto=format&fit=crop&w=1400&q=75"
              alt="Architectural production model"
              loading="lazy"
              decoding="async"
            />
            <div class="comparison-label model-label">
              <span>01</span>
              RAW BIM / WIREFRAME
            </div>
          </div>

          <!-- DRAG HANDLE -->
          <div class="comparison-handle">
            <div class="handle-line"></div>
            <div class="handle-circle">
              <span>←</span>
              <span>→</span>
            </div>
          </div>

          <!-- INVISIBLE RANGE CONTROL -->
          <input
            class="comparison-range"
            type="range"
            min="0"
            max="100"
            value="50"
            aria-label="Compare raw BIM model with final render"
          />
        </div>

        <!-- FOOTER -->
        <div class="comparison-footer">
          <span>RAW PRODUCTION MODEL</span>
          <div class="comparison-progress">
            <span></span>
            <span></span>
            <span></span>
          </div>
          <span>FINAL VISUAL OUTPUT</span>
        </div>

      </div>

      <!-- Back Button -->
      <button class="back-to-services-btn" id="backToServicesBtn" aria-label="Back to Services">
        <span>← Back to Services</span>
      </button>
    </div>

  </div>
</section>

<script>
  const N = 8; // number of services
  const cardsTrack = document.getElementById("cardsTrack");
  const horizontalSlider = document.getElementById("horizontalScreenSlider");
  const rootSection = document.querySelector<HTMLElement>(".cinematic-services-root");
  const bgItems = document.querySelectorAll<HTMLElement>(".screen-bg-image");
  const bgImgs = document.querySelectorAll<HTMLImageElement>(".screen-bg-image img");
  const infoPanes = document.querySelectorAll<HTMLElement>(".service-info-pane");
  const cardItems = document.querySelectorAll<HTMLElement>(".upcoming-card-item");
  const timelineFill = document.getElementById("timelineFill");
  const currentNumberElem = document.getElementById("currentNumber");

  // pos = position inside the 3 copies of the cards (starts in the middle copy)
  // so the loop is seamless in both directions, no long slide-back at the end
  let pos = N;
  let activeIndex = 0;
  let step = 250;
  let navLock = false;
  let showingCompare = false;

  const measureStep = () => {
    if (cardItems.length > 1) step = cardItems[1].offsetLeft - cardItems[0].offsetLeft || 250;
  };

  // load a background only when it is needed
  const ensureLoaded = (i: number) => {
    const img = bgImgs[((i % N) + N) % N];
    if (img && !img.getAttribute("src") && img.dataset.src) img.src = img.dataset.src;
  };

  function paint(animate = true) {
    activeIndex = ((pos % N) + N) % N;

    bgItems.forEach((el, i) => el.classList.toggle("is-active", i === activeIndex));
    infoPanes.forEach((el, i) => el.classList.toggle("is-active", i === activeIndex));

    if (timelineFill) timelineFill.style.width = `${((activeIndex + 1) / N) * 100}%`;
    if (currentNumberElem) currentNumberElem.textContent = String(activeIndex + 1).padStart(2, "0");

    ensureLoaded(activeIndex);
    ensureLoaded(activeIndex + 1);

    if (cardsTrack) {
      cardsTrack.style.transition = animate ? "" : "none";
      cardsTrack.style.transform = `translate3d(${-(pos + 1) * step}px, 0, 0)`;
    }
  }

  function hideCompare() {
    if (!showingCompare) return;
    showingCompare = false;
    if (horizontalSlider) horizontalSlider.style.transform = "translateX(0)";
  }

  function showCompare() {
    showingCompare = true;
    if (horizontalSlider) horizontalSlider.style.transform = "translateX(-50%)";
  }

  function goTo(newPos: number) {
    if (navLock) return;
    navLock = true;
    setTimeout(() => (navLock = false), 350);
    hideCompare();
    pos = newPos;
    paint(true);
  }

  // after the slide finishes, silently jump back into the middle copy (looks identical)
  cardsTrack?.addEventListener("transitionend", (e) => {
    if (e.propertyName !== "transform") return;
    if (pos < N || pos >= 2 * N) {
      pos = activeIndex + N;
      paint(false);
      void cardsTrack.offsetWidth;
      cardsTrack.style.transition = "";
    }
  });

  cardItems.forEach((card) => {
    card.addEventListener("click", () => goTo(Number(card.dataset.loopIndex)));
  });
  document.querySelector(".prev-btn")?.addEventListener("click", () => goTo(pos - 1));
  document.querySelector(".next-btn")?.addEventListener("click", () => goTo(pos + 1));
  document.getElementById("goToCompareBtn")?.addEventListener("click", showCompare);
  document.getElementById("backToServicesBtn")?.addEventListener("click", hideCompare);

  // Wheel: ONLY a sideways swipe changes slides. Normal (vertical) scrolling stays with the page.
  // passive:true => the browser never waits for this code before scrolling.
  rootSection?.addEventListener(
    "wheel",
    (e: WheelEvent) => {
      if ((e.target as HTMLElement).classList.contains("comparison-range")) return;
      if (Math.abs(e.deltaX) < 25 || Math.abs(e.deltaX) <= Math.abs(e.deltaY)) return;
      goTo(pos + (e.deltaX > 0 ? 1 : -1));
    },
    { passive: true }
  );

  // Touch swipe (phones / tablets)
  let tx = 0, ty = 0;
  rootSection?.addEventListener("touchstart", (e) => { tx = e.touches[0].clientX; ty = e.touches[0].clientY; }, { passive: true });
  rootSection?.addEventListener("touchend", (e) => {
    const dx = e.changedTouches[0].clientX - tx;
    const dy = e.changedTouches[0].clientY - ty;
    if (Math.abs(dx) > 50 && Math.abs(dx) > Math.abs(dy)) goTo(pos + (dx < 0 ? 1 : -1));
  }, { passive: true });

  // Comparison slider
  const comparisonRange = document.querySelector<HTMLInputElement>(".comparison-range");
  const comparisonBefore = document.querySelector<HTMLElement>(".comparison-before");
  const comparisonHandle = document.querySelector<HTMLElement>(".comparison-handle");
  if (comparisonRange && comparisonBefore && comparisonHandle) {
    const updateComparison = () => {
      const value = Number(comparisonRange.value);
      comparisonBefore.style.width = `${value}%`;
      comparisonHandle.style.left = `${value}%`;
    };
    comparisonRange.addEventListener("input", updateComparison);
    updateComparison();
  }

  window.addEventListener("resize", () => { measureStep(); paint(false); }, { passive: true });

  // init
  measureStep();
  paint(false);

  // load the other backgrounds one by one when the browser is idle (not all 8 at once)
  const idle = (cb: () => void) =>
    "requestIdleCallback" in window ? (window as any).requestIdleCallback(cb, { timeout: 4000 }) : setTimeout(cb, 2500);
  idle(() => {
    let i = 0;
    const next = () => { if (i >= N) return; ensureLoaded(i++); setTimeout(next, 700); };
    next();
  });
</script>