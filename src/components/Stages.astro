---
import "../styles/stages.css";

// ====== IMAGES ======
// 1 & 2 maine generate ki hain (public/images mein).
// 3 & 4 aap ki apni hain: unhein public/images mein "before" aur "after" naam se rakhein.
// Agar extension .jpg nahi (jaise .png / .webp) to yahan badal dein.
const stages = [
  { tab: "Sketch",       chip: "Sketch",       tag: "Linework · 1:100", qc: "Brief OK",  model: "Revit · LOD 100", img: "/images/stage1.jpg" },
  { tab: "Massing",      chip: "Massing",      tag: "Volume study",     qc: "Area OK",   model: "Massing · v2",    img: "/images/stage2.jpg" },
  { tab: "BIM model",    chip: "BIM model",    tag: "Revit · LOD 300",  qc: "0 clashes", model: "Revit · LOD 300", img: "/images/before.jpg" },
  { tab: "Final render", chip: "Final render", tag: "Corona · 4K",      qc: "QC passed", model: "Render · 4K",     img: "/images/after.png" },
];
---

<section class="stages" id="stages">
  <div class="stages-inner">

    <!-- LEFT: text -->
    <div class="stages-copy">
      <div class="stages-eyebrow">One building, four stages</div>
      <h2>
        <span class="line">Sketch in.</span>
        <span class="line"><em>Render out.</em></span>
      </h2>
      <p>
        A real Axys3D project moving from linework to coordinated BIM to the
        final render. Hover the card, or pick a stage.
      </p>
    </div>

    <!-- RIGHT: card + tabs -->
    <div class="stages-visual">
      <div class="stage-card" id="stageCard">
        <div class="stage-media">
          {stages.map((s, i) => (
            <img class:list={["stage-img", i === 0 && "is-under"]} src={s.img} alt={`${s.chip} stage`} loading="lazy" />
          ))}
          <span class="stage-beam" aria-hidden="true"></span>
        </div>

        <span class="stage-chip"><i></i><b id="stChip">{stages[0].chip}</b></span>
        <span class="stage-tag" id="stTag">{stages[0].tag}</span>

        <div class="stage-badge badge-qc">
          <small>QC</small>
          <strong id="stQc">{stages[0].qc}</strong>
        </div>
        <div class="stage-badge badge-model">
          <small>Model</small>
          <strong id="stModel">{stages[0].model}</strong>
        </div>
      </div>

      <div class="stage-tabs" role="tablist">
        {stages.map((s, i) => (
          <button
            class:list={["stage-tab", i === 0 && "is-active"]}
            role="tab"
            type="button"
            data-i={i}
            data-chip={s.chip}
            data-tag={s.tag}
            data-qc={s.qc}
            data-model={s.model}
          >
            <span class="tab-num">0{i + 1}</span>
            <span class="tab-name">{s.tab}</span>
            <span class="tab-line"></span>
          </button>
        ))}
      </div>
    </div>

  </div>
</section>

<script>
  const root = document.getElementById("stages") as HTMLElement;
  const card = document.getElementById("stageCard") as HTMLElement;
  const imgs = Array.from(root.querySelectorAll<HTMLElement>(".stage-img"));
  const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>(".stage-tab"));
  const beam = root.querySelector<HTMLElement>(".stage-beam")!;
  const $ = (id: string) => document.getElementById(id)!;
  const labels = { chip: $("stChip"), tag: $("stTag"), qc: $("stQc"), model: $("stModel") };

  const DURATION = 3800; // har stage kitni der rukay (ms)
  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  let cur = 0, timer: number | undefined, startedAt = 0, remaining = DURATION, inView = false, hover = false;

  function setLabels(t: HTMLButtonElement) {
    const targets = [labels.chip, labels.tag, labels.qc, labels.model];
    targets.forEach((el) => el.classList.add("is-swap"));
    window.setTimeout(() => {
      labels.chip.textContent = t.dataset.chip!;
      labels.tag.textContent = t.dataset.tag!;
      labels.qc.textContent = t.dataset.qc!;
      labels.model.textContent = t.dataset.model!;
      targets.forEach((el) => el.classList.remove("is-swap"));
    }, 350);
  }

  function schedule(ms: number) {
    window.clearTimeout(timer);
    remaining = ms;
    startedAt = performance.now();
    if (!reduce) timer = window.setTimeout(() => go((cur + 1) % tabs.length), ms);
  }

  function go(i: number) {
    const prev = cur;
    cur = i;
    imgs.forEach((im, k) => {
      im.classList.remove("is-top", "is-under");
      if (k === prev && prev !== i) im.classList.add("is-under");
    });
    void imgs[i].offsetWidth;
    imgs[i].classList.add("is-top");

    beam.classList.remove("run");
    void beam.offsetWidth;
    beam.classList.add("run");

    tabs.forEach((t, k) => {
      t.classList.toggle("is-active", k === i);
      t.classList.toggle("is-done", k < i);
      if (k === i) { t.classList.remove("is-active"); void t.offsetWidth; t.classList.add("is-active"); }
    });
    setLabels(tabs[i]);
    schedule(DURATION);
  }

  tabs.forEach((t) => t.addEventListener("click", () => { if (Number(t.dataset.i) !== cur) go(Number(t.dataset.i)); }));

  function pause() {
    hover = true;
    window.clearTimeout(timer);
    remaining = Math.max(300, remaining - (performance.now() - startedAt));
    root.classList.add("is-paused");
  }
  function resume() {
    hover = false;
    root.classList.remove("is-paused");
    if (inView) schedule(remaining);
  }
  card.addEventListener("mouseenter", pause);
  card.addEventListener("mouseleave", () => { resume(); card.style.setProperty("--rx", "0deg"); card.style.setProperty("--ry", "0deg"); });
  card.addEventListener("mousemove", (e) => {
    const r = card.getBoundingClientRect();
    card.style.setProperty("--ry", `${((e.clientX - r.left) / r.width - 0.5) * 5}deg`);
    card.style.setProperty("--rx", `${-((e.clientY - r.top) / r.height - 0.5) * 4}deg`);
  });

  // sirf screen par aaye tab chalay
  new IntersectionObserver(([e]) => {
    inView = e.isIntersecting;
    if (inView && !hover) { tabs[cur].classList.remove("is-active"); void tabs[cur].offsetWidth; tabs[cur].classList.add("is-active"); schedule(DURATION); }
    else { window.clearTimeout(timer); }
  }, { threshold: 0.35 }).observe(root);
</script>