---
import "../styles/Visual-Gallery.css";


// 8 services = 8 gallery slides.
// To change an image: paste only the Unsplash photo id (the "photo-xxxx" part) into the matching unsplash("...") line.
// `slug` is used for the Visuals page filter (?service=slug).
const unsplash = (id: string) =>
  `https://images.unsplash.com/${id}?auto=format&fit=crop&w=1800&q=85`;

const gallery = [
  {
    slug: "bim-production",
    short: "BIM Production",
    service: "BIM Execution & Model Production",
    headline: "Coordinated building models, ready for construction",
    description: "See the BIM models we build, with every wall, floor and opening set up to your firm's standards.",
    image: unsplash("photo-1678388583153-f0e667c97288"),
  },
  {
    slug: "revit-production",
    short: "Revit Documentation",
    service: "Revit Production & Documentation",
    headline: "Drawing sets that always match the model",
    description: "Plans, sections and construction drawings produced in Revit and issued on schedule.",
    image: unsplash("photo-1746308674931-12bacad54df7"),
  },
  {
    slug: "mep-coordination",
    short: "MEP Coordination",
    service: "MEP Coordination Support",
    headline: "Pipes, ducts and wiring, without clashes",
    description: "See mechanical, electrical and plumbing systems checked and resolved before site.",
    image: unsplash("photo-1615309662243-70f6df917b59"),
  },
  {
    slug: "3d-modeling",
    short: "3D Modeling",
    service: "3D Modeling",
    headline: "Buildings, interiors and objects, modeled to scale",
    description: "Accurate architectural, interior and furniture models, ready for any visualization.",
    image: unsplash("photo-1722876599298-dbdf5c4006f5"),
  },
  {
    slug: "3ds-max-production",
    short: "3ds Max Production",
    service: "3ds Max Production",
    headline: "Scenes textured and lit, ready to render",
    description: "See how scenes, materials and lighting are set up in 3ds Max.",
    image: unsplash("photo-1749834553226-b0f0651a2a96"),
  },
  {
    slug: "architectural-visualization",
    short: "Visualization",
    service: "Architectural Visualization",
    headline: "Photo-real images before the building exists",
    description: "Exterior, interior and site visuals that read as photography.",
    image: unsplash("photo-1633109713362-031e75973c1b"),
  },
  {
    slug: "animation-motion",
    short: "Animation & Motion",
    service: "Animation & Motion",
    headline: "Walk through the project on camera",
    description: "Walkthroughs and fly-throughs that show scale and flow.",
    image: unsplash("photo-1633109633238-e982d5b61f9f"),
  },
  {
    slug: "unreal-engine",
    short: "Unreal Engine",
    service: "Real-time / Unreal Engine",
    headline: "Explore the design live, in real time",
    description: "Interactive walkthroughs and virtual showrooms your clients can navigate.",
    image: unsplash("photo-1633109611134-c41b5c0bbc1a"),
  },
];

const compare = {
  before: "public/images/before.jpg",
  after: "public/images/after.png",
};

const looped = [...gallery, ...gallery, ...gallery];

const bgUrl = (u: string) => u.replace("w=1800&q=85", "w=1600&q=70");
const cardUrl = (u: string) => u.replace("w=1800&q=85", "w=520&q=70");
---

<section class="cinematic-services-root" id="visual-gallery" aria-label="Visual gallery">
  <div class="horizontal-screen-slider" id="horizontalScreenSlider">

    <!-- SCREEN 1: GALLERY -->
    <div class="screen-panel services-screen">

      <div class="screen-bg-stack">
        {gallery.map((item, idx) => (
          <div class={`screen-bg-image ${idx === 0 ? "is-active" : ""}`} data-bg-index={idx}>
            <img
              src={idx === 0 ? bgUrl(item.image) : undefined}
              data-src={bgUrl(item.image)}
              alt={`${item.service}: ${item.headline}`}
              decoding="async"
              fetchpriority={idx === 0 ? "high" : "low"}
            />
          </div>
        ))}
        <div class="screen-bg-darkener"></div>
      </div>

      <div class="gallery-header">
        <div class="gallery-intro">
          <span class="gallery-eyebrow">Visual gallery</span>
        </div>

        <div class="gallery-counter" aria-live="polite" aria-label="Current visual">
          <span class="gallery-counter-now" id="galleryNow">01</span>
          <span class="gallery-counter-total">/ {String(gallery.length).padStart(2, "0")}</span>
          <span class="gallery-counter-bar" aria-hidden="true"><i id="galleryBar"></i></span>
        </div>
      </div>

      <div class="services-main-layout">

        <div class="active-service-details">
          {gallery.map((item, idx) => (
            <div
              class={`service-info-pane ${idx === 0 ? "is-active" : ""}`}
              data-info-index={idx}
              data-service={item.slug}
            >
              <span class="service-category-tag">{item.service}</span>
              <h2 class="service-primary-title">{item.headline}</h2>
              <p class="service-primary-desc">{item.description}</p>

              <a class="service-discover-btn" href={`/Visuals?service=${item.slug}`}>
                <span>VIEW {item.short.toUpperCase()} VISUALS</span>
                <span class="btn-arrow">↗</span>
              </a>
            </div>
          ))}
        </div>

        <div class="upcoming-cards-viewport">
          <div class="upcoming-cards-track" id="cardsTrack">
            {looped.map((item, idx) => (
              <div
                class="upcoming-card-item"
                data-original-index={idx % gallery.length}
                data-loop-index={idx}
                tabindex="0"
                role="button"
                aria-label={`Show ${item.service}`}
              >
                <div class="upcoming-card-img">
                  <img src={cardUrl(item.image)} alt="" width="230" height="350" loading="lazy" decoding="async" />
                  <div class="upcoming-card-shade"></div>
                </div>

                <div class="upcoming-card-content">
                  <h3 class="upcoming-card-title">{item.short}</h3>
                </div>
              </div>
            ))}
          </div>
        </div>

      </div>

      <div class="services-nav-bar">
        <button class="go-to-compare-btn" id="goToCompareBtn">
          <span>BEFORE &amp; AFTER</span>
          <span class="btn-arrow">→</span>
        </button>
      </div>

    </div>

    <!-- SCREEN 2: BEFORE & AFTER -->
    <div class="screen-panel model-experience-screen">
      <div class="model-experience-container">

        <!-- Button container ke top par move ho gaya hai -->
        <button class="back-to-services-btn" id="backToServicesBtn" aria-label="Back to the gallery">
          <span>← Back to gallery</span>
        </button>

        <div class="model-experience-heading">
          <div>
            <h2>
              Same building,
              <span>two stages.</span>
            </h2>
          </div>

          <p>
            Drag the handle. On the left is the 3D model we build first.
            On the right is the finished visual you receive.
          </p>
        </div>

        <div class="comparison-wrapper">
          <div class="comparison-image comparison-final">
            <img src={compare.after} alt="Finished visual" loading="lazy" decoding="async" />
            <div class="comparison-label final-label">
              <span>02</span>
              FINISHED VISUAL
            </div>
          </div>

          <div class="comparison-image comparison-before">
            <img src={compare.before} alt="3D model of the same building" loading="lazy" decoding="async" />
            <div class="comparison-label model-label">
              <span>01</span>
              3D MODEL
            </div>
          </div>

          <div class="comparison-handle">
            <div class="handle-line"></div>
            <div class="handle-circle">
              <span>←</span>
              <span>→</span>
            </div>
          </div>

          <input
            class="comparison-range"
            type="range"
            min="0"
            max="100"
            value="50"
            aria-label="Drag to compare the 3D model with the finished visual"
          />
        </div>

        <div class="comparison-footer">
          <span>STAGE 1 · 3D MODEL</span>
          <div class="comparison-progress">
            <span></span>
            <span></span>
            <span></span>
          </div>
          <span>STAGE 2 · FINISHED VISUAL</span>
        </div>

      </div>
    </div>

  </div>
</section>

<script>
  const infoPanes = document.querySelectorAll<HTMLElement>(".service-info-pane");
  const N = infoPanes.length;
  const cardsTrack = document.getElementById("cardsTrack");
  const horizontalSlider = document.getElementById("horizontalScreenSlider");
  const rootSection = document.querySelector<HTMLElement>(".cinematic-services-root");
  const bgItems = document.querySelectorAll<HTMLElement>(".screen-bg-image");
  const bgImgs = document.querySelectorAll<HTMLImageElement>(".screen-bg-image img");
  const cardItems = document.querySelectorAll<HTMLElement>(".upcoming-card-item");
  const counterNow = document.getElementById("galleryNow");
  const counterBar = document.getElementById("galleryBar");

  let pos = N;
  let activeIndex = 0;
  let step = 250;
  let navLock = false;
  let showingCompare = false;

  const measureStep = () => {
    if (cardItems.length > 1) step = cardItems[1].offsetLeft - cardItems[0].offsetLeft || 250;
  };

  const ensureLoaded = (i: number) => {
    const img = bgImgs[((i % N) + N) % N];
    if (img && !img.getAttribute("src") && img.dataset.src) img.src = img.dataset.src;
  };

  function paint(animate = true) {
    activeIndex = ((pos % N) + N) % N;

    bgItems.forEach((el, i) => el.classList.toggle("is-active", i === activeIndex));
    infoPanes.forEach((el, i) => el.classList.toggle("is-active", i === activeIndex));

    ensureLoaded(activeIndex);
    ensureLoaded(activeIndex + 1);

    if (counterNow) counterNow.textContent = String(activeIndex + 1).padStart(2, "0");
    if (counterBar) counterBar.style.transform = `scaleX(${(activeIndex + 1) / N})`;

    if (cardsTrack) {
      cardsTrack.style.transition = animate ? "" : "none";
      cardsTrack.style.transform = `translate3d(${-(pos + 1) * step}px, 0, 0)`;
    }
  }

  function hideCompare() {
    if (!showingCompare) return;
    showingCompare = false;
    if (horizontalSlider) horizontalSlider.style.transform = "translateX(0)";
  }

  function showCompare() {
    showingCompare = true;
    if (horizontalSlider) horizontalSlider.style.transform = "translateX(-50%)";
  }

  function goTo(newPos: number) {
    if (navLock) return;
    navLock = true;
    setTimeout(() => (navLock = false), 350);
    hideCompare();
    pos = newPos;
    paint(true);
  }

  cardsTrack?.addEventListener("transitionend", (e) => {
    if (e.propertyName !== "transform") return;
    if (pos < N || pos >= 2 * N) {
      pos = activeIndex + N;
      paint(false);
      void cardsTrack.offsetWidth;
      cardsTrack.style.transition = "";
    }
  });

  cardItems.forEach((card) => {
    card.addEventListener("click", () => goTo(Number(card.dataset.loopIndex)));
    card.addEventListener("keydown", (e) => {
      if (e.key === "Enter" || e.key === " ") {
        e.preventDefault();
        goTo(Number(card.dataset.loopIndex));
      }
    });
  });

  document.getElementById("goToCompareBtn")?.addEventListener("click", showCompare);
  document.getElementById("backToServicesBtn")?.addEventListener("click", hideCompare);

  rootSection?.addEventListener(
    "wheel",
    (e: WheelEvent) => {
      if ((e.target as HTMLElement).classList.contains("comparison-range")) return;
      if (Math.abs(e.deltaX) < 25 || Math.abs(e.deltaX) <= Math.abs(e.deltaY)) return;
      goTo(pos + (e.deltaX > 0 ? 1 : -1));
    },
    { passive: true }
  );

  let tx = 0, ty = 0, ignoreSwipe = false;
  rootSection?.addEventListener("touchstart", (e) => {
    tx = e.touches[0].clientX;
    ty = e.touches[0].clientY;
    ignoreSwipe = !!(e.target as HTMLElement).closest(".comparison-wrapper");
  }, { passive: true });
  rootSection?.addEventListener("touchend", (e) => {
    if (ignoreSwipe) return;
    const dx = e.changedTouches[0].clientX - tx;
    const dy = e.changedTouches[0].clientY - ty;
    if (Math.abs(dx) > 50 && Math.abs(dx) > Math.abs(dy)) goTo(pos + (dx < 0 ? 1 : -1));
  }, { passive: true });

  const comparisonRange = document.querySelector<HTMLInputElement>(".comparison-range");
  const comparisonBefore = document.querySelector<HTMLElement>(".comparison-before");
  const comparisonHandle = document.querySelector<HTMLElement>(".comparison-handle");
  if (comparisonRange && comparisonBefore && comparisonHandle) {
    const updateComparison = () => {
      const value = Number(comparisonRange.value);
      comparisonBefore.style.clipPath = `inset(0 ${100 - value}% 0 0)`;
      comparisonHandle.style.left = `${value}%`;
    };
    comparisonRange.addEventListener("input", updateComparison);
    updateComparison();
  }

  window.addEventListener("resize", () => { measureStep(); paint(false); }, { passive: true });

  measureStep();
  paint(false);

  const idle = (cb: () => void) =>
    "requestIdleCallback" in window ? (window as any).requestIdleCallback(cb, { timeout: 4000 }) : setTimeout(cb, 2500);
  idle(() => {
    let i = 0;
    const next = () => { if (i >= N) return; ensureLoaded(i++); setTimeout(next, 700); };
    next();
  });
</script>