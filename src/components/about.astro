---
// About.astro
import "../styles/HomeAbout.css";

const mainImage =
  "public/images/SAMPLE.png";

// UX: 3 short promises (plain words)
const points = [
  "A clear scope before any work starts",
  "You keep approvals and authorship",
  "Organised files at handoff",
];

// 2 x 2 tiles (all text tiles)
type AboutTile =
  | { type: "text"; label: string; title: string; href: string }
  | { type: "image"; label: string; img: string; href: string };

const tiles: AboutTile[] = [
  { type: "text", label: "Explore", title: "Services", href: "/Services" },
  { type: "text", label: "Explore", title: "Industries", href: "/Industries" },
  { type: "text", label: "See our", title: "Process", href: "/Process" },
  { type: "text", label: "Start a", title: "Project", href: "/Contact" },
];
---

<section class="about" data-about>
  <div class="about-orb about-orb--1" aria-hidden="true"></div>
  <div class="about-orb about-orb--2" aria-hidden="true"></div>

  <div class="about-wrap">
    <!-- ================= LEFT: TEXT + TILES ================= -->
    <div class="about-content">
      <span class="about-tag a-anim" style="--d:.05s">About us</span>

      <h2 class="about-heading">
        <span class="about-h-light a-anim" style="--d:.12s">Why</span>
        <span class="about-h-bold a-anim" style="--d:.2s">
          <span class="about-mark">Axys3D</span>
        </span>
      </h2>

      <p class="about-promise a-anim" style="--d:.32s">
        We add production capacity to your team, and you stay in control.
      </p>

      <p class="about-copy a-anim" style="--d:.4s">
        Every project starts with a clear scope, the inputs we need, who is
        responsible for what, and how files are handed over.
      </p>

      <ul class="about-points">
        {points.map((p, i) => (
          <li class="a-anim" style={`--a:aUp; --t:.6s; --d:${0.48 + i * 0.08}s`}>
            <span class="about-point-dot" aria-hidden="true">
              <svg viewBox="0 0 12 12" fill="none"><path d="M2.5 6.5L5 9L9.5 3.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </span>
            <span>{p}</span>
          </li>
        ))}
      </ul>

      <div class="about-tiles">
        {tiles.map((t, i) => (
          <a
            class={`about-tile about-tile--${t.type} a-anim`}
            href={t.href}
            style={`--a:aPop; --t:.6s; --d:${0.75 + i * 0.08}s`}
          >
            {t.type === "text" ? (
              <>
                <span class="about-tile-text">
                  <small>{t.label}</small>
                  <strong>{t.title}</strong>
                </span>
                <span class="about-pill" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12h15M14 7l5 5-5 5" /></svg>
                </span>
              </>
            ) : (
              <>
                <img src={t.img} alt="" loading="lazy" decoding="async" />
                <span class="about-tile-shade"></span>
                <span class="about-tile-label">{t.label}</span>
                <span class="about-badge" aria-hidden="true">&#8599;</span>
              </>
            )}
          </a>
        ))}
      </div>
    </div>

    <!-- ================= RIGHT: IMAGE PANEL ================= -->
    <div class="about-visual a-anim" style="--a:aFade; --t:.7s; --d:0s">
      <div class="about-photo a-anim" style="--a:aReveal; --t:.9s; --d:.15s">
        <img src={mainImage} alt="Architectural production by Axys3D" loading="lazy" decoding="async" />
        <span class="about-photo-shade"></span>
      </div>

      <a class="about-card a-anim" href="/Process" style="--a:aCard; --t:.7s; --d:.9s">
        <span class="about-card-badge" aria-hidden="true">&#8599;</span>
        <strong>Controlled handoff</strong>
        <p>Scope, inputs and approvals stay with your team.</p>
      </a>
    </div>
  </div>
</section>

<noscript>
  <style>
    .about .a-anim,
    .about .about-mark,
    .about .about-photo img {
      animation: none !important;
      opacity: 1 !important;
      clip-path: none !important;
    }
    .about .about-mark { background-size: 100% 100% !important; }
  </style>
</noscript>

<script>
  document.querySelectorAll<HTMLElement>("[data-about]").forEach((section) => {
    if (!("IntersectionObserver" in window)) {
      section.classList.add("is-in");
      return;
    }
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            section.classList.add("is-in");
            io.disconnect();
          }
        });
      },
      { threshold: 0.25 }
    );
    io.observe(section);
  });
</script>