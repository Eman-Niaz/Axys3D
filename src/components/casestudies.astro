    tagline: "FEDERATED WORKFLOW",
    title: "Federated Delivery Study",
    video: "/videos/interior-1.mp4",
    poster: "/images/case-studies/interior-1.jpg",
    href: "/work/aec-study-01/",
    cards: [
      {
        title: "24/7 Live Sync",
        value: "99.8%",
        desc: "Automated clash detection across structural & MEP layers."
      },
      {
        title: "Unified Hub",
        value: "1 Central Model",
        desc: "Single source of truth for design teams."
      },
      {
        title: "Multi-Format Compatibility",
        value: "Revit + IFC",
        desc: "Seamless data exchange across disparate BIM software platforms."
      }
    ]
  },
  {
    id: "cs2",
    num: "02",
    tagline: "CAMPUS INTEGRATION",
    title: "Real-Time Campus Study",
    video: "/videos/landscape.mp4",
    poster: "/images/case-studies/landscape.jpg",
    href: "/work/aec-study-02/",
    cards: [
      {
        title: "High Performance",
        value: "60 FPS",
        desc: "Smooth real-time walkthroughs in Unreal Engine."
      },
      {
        title: "Digital Twin",
        value: "IoT Ready",
        desc: "Live sensor data mapped on geometry."
      },
      {
        title: "Cross-Platform Delivery",
        value: "Web & VR",
        desc: "Accessible from standard desktop browsers and immersive headsets."
      }
    ]
  },
  {
    id: "cs3",
    num: "03",
    tagline: "PRODUCTION PACKAGE",
    title: "Production Package Study",
    video: "/videos/exterior-1.mp4",
    poster: "/images/case-studies/exterior-1.jpg",
    href: "/work/aec-study-03/",
    cards: [
      {
        title: "Fast Turnaround",
        value: "40% Faster",
        desc: "Standardized drafting templates."
      },
      {
        title: "Quality Assurance",
        value: "Zero Conflicts",
        desc: "Pre-checked component library."
      },
      {
        title: "Standardized Documentation",
        value: "ISO 19650",
        desc: "Compliant documentation for direct on-site execution."
      }
    ]
  }
];
---

<section class="cs-carousel-wrapper" id="caseStudyWrapper">
  <!-- SLOW ANIMATED LUXURY BACKGROUND GRADIENT -->
  <div class="cs-ambient-gradient-bg"></div>

  <div class="cs-carousel-container">

    <!-- Top Header -->
    <div class="cs-carousel-head">
      <div>
        <span class="cs-tag">CASE STUDIES</span>
        <h2 class="cs-heading">Delivery evidence, <span>not unverified claims.</span></h2>
      </div>
      <div class="cs-nav-controls">
        <a href="/Work" class="cs-view-all-btn">
          View All Case Studies
          <svg width="12" height="12" viewBox="0 0 14 14" fill="none">
            <path d="M1 13L13 1M13 1H3M13 1V11" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
        <div class="cs-nav-arrows">
          <button id="csPrevBtn" aria-label="Previous Case Study">←</button>
          <button id="csNextBtn" aria-label="Next Case Study">→</button>
        </div>
      </div>
    </div>

    <!-- Expanding panels -->
    <div class="cs-panels" id="csPanels">
      {caseStudies.map((cs, idx) => (
        <div
          class={`cs-panel ${idx === 0 ? "active" : ""}`}
          data-index={idx}
          tabindex="0"
          role="button"
          aria-label={`Open ${cs.title}`}
          aria-expanded={idx === 0 ? "true" : "false"}
        >
          <div class="cs-panel-media">
            <video muted loop playsinline preload="metadata" poster={cs.poster} aria-hidden="true">
              <source src={`${cs.video}#t=0.1`} type="video/mp4" />
            </video>
          </div>
          <div class="cs-panel-shade"></div>

          <!-- Collapsed label -->
          <div class="cs-panel-label">
            <span class="cs-name-num">{cs.num}</span>
            <h3 class="cs-main-title">{cs.title}</h3>
          </div>

          <!-- Active: just the name (links to the case study) -->
          <div class="cs-panel-content" inert={idx !== 0}>
            <a href={cs.href} class="cs-name-link" aria-label={`Open ${cs.title}`}>
              <span class="cs-name-text">
                <span class="cs-name-num">{cs.num}</span>
                <h3 class="cs-main-title">{cs.title}</h3>
              </span>
              <span class="cs-name-arrow" aria-hidden="true">
                <svg width="16" height="16" viewBox="0 0 14 14" fill="none">
                  <path d="M1 13L13 1M13 1H3M13 1V11" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </span>
            </a>
          </div>

          <div class="cs-progress"></div>
        </div>
      ))}
    </div>

  </div>
</section>

<script>
  function setupCaseStudiesCarousel() {
    const wrapper = document.getElementById("caseStudyWrapper");
    const panelsEl = document.getElementById("csPanels");
    if (!wrapper || !panelsEl || wrapper.dataset.ready === "true") return;
    wrapper.dataset.ready = "true";

    const panels = Array.from(panelsEl.querySelectorAll<HTMLElement>(".cs-panel"));
    const prevBtn = document.getElementById("csPrevBtn");
    const nextBtn = document.getElementById("csNextBtn");
    const total = panels.length;
    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    let current = 0;
    let inView = true;

    function playActive() {
      panels.forEach((panel, i) => {
        const vid = panel.querySelector("video");
        if (!vid) return;
        if (i === current && inView) {
          vid.play().catch(() => {});
        } else {
          vid.pause();
        }
      });
    }

    function goTo(index: number) {
      current = (index + total) % total;
      panels.forEach((panel, i) => {
        const on = i === current;
        panel.classList.toggle("active", on);
        panel.setAttribute("aria-expanded", String(on));
        const content = panel.querySelector<HTMLElement>(".cs-panel-content");
        if (content) content.inert = !on;
        if (on) {
          const vid = panel.querySelector("video");
          if (vid) vid.currentTime = 0;
        }
      });
      playActive();
    }

    // Autoplay is driven by the CSS progress bar finishing
    panels.forEach((panel, i) => {
      panel.querySelector(".cs-progress")?.addEventListener("animationend", () => {
        if (i === current && !reduceMotion) goTo(current + 1);
      });

      // Click / keyboard to open a panel
      panel.addEventListener("click", () => {
        if (i !== current) goTo(i);
      });
      panel.addEventListener("keydown", (e) => {
        if ((e.key === "Enter" || e.key === " ") && e.target === panel && i !== current) {
          e.preventDefault();
          goTo(i);
        }
        if (e.key === "ArrowRight") { e.preventDefault(); goTo(current + 1); panels[current].focus(); }
        if (e.key === "ArrowLeft")  { e.preventDefault(); goTo(current - 1); panels[current].focus(); }
      });
    });

    prevBtn?.addEventListener("click", () => goTo(current - 1));
    nextBtn?.addEventListener("click", () => goTo(current + 1));

    // Pause autoplay while hovering / focusing inside
    wrapper.addEventListener("mouseenter", () => wrapper.classList.add("is-paused"));
    wrapper.addEventListener("mouseleave", () => wrapper.classList.remove("is-paused"));
    wrapper.addEventListener("focusin", () => wrapper.classList.add("is-paused"));
    wrapper.addEventListener("focusout", () => wrapper.classList.remove("is-paused"));

    // Swipe on touch (horizontal only, so page scroll still works)
    let startX = 0, startY = 0;
    panelsEl.addEventListener("touchstart", (e) => {
      startX = e.touches[0].clientX;
      startY = e.touches[0].clientY;
    }, { passive: true });
    panelsEl.addEventListener("touchend", (e) => {
      const dx = e.changedTouches[0].clientX - startX;
      const dy = e.changedTouches[0].clientY - startY;
      if (Math.abs(dx) > 50 && Math.abs(dx) > Math.abs(dy) * 1.5) {
        goTo(dx < 0 ? current + 1 : current - 1);
      }
    }, { passive: true });

    // Only run video + autoplay while the section is on screen
    new IntersectionObserver(([entry]) => {
      inView = entry.isIntersecting;
      wrapper.classList.toggle("is-paused", !inView);
      playActive();
    }, { threshold: 0.25 }).observe(wrapper);

    // Videos ko pehle se load kar lo, taaki inactive panel kala na dikhe
    const warmVideos = () => {
      panels.forEach((panel, i) => {
        const vid = panel.querySelector("video");
        if (!vid || vid.preload === "auto") return;
        vid.preload = "auto";
        if (i !== current) vid.load();
      });
    };
    const warmObserver = new IntersectionObserver(([entry]) => {
      if (entry.isIntersecting) {
        warmVideos();
        warmObserver.disconnect();
      }
    }, { rootMargin: "1200px 0px" });
    warmObserver.observe(wrapper);

    goTo(0);
  }

  document.addEventListener("DOMContentLoaded", setupCaseStudiesCarousel);
  document.addEventListener("astro:page-load", setupCaseStudiesCarousel);
</script>