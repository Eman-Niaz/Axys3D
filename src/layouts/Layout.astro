---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Axys3D | Architectural Visualization",
  description = "Premium architectural visualization and 3D design services.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />

    <title>{title}</title>
    <meta name="description" content={description} />

    <link rel="canonical" href={Astro.url} />
  </head>

  <body>
    <slot />
  </body>
</html>
