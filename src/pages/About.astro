---
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import "../styles/token.css";
import "../styles/global.css";
import "../styles/Navbar.css";
import "../styles/footer.css";
import "../styles/about.css";
import { getCollection } from "astro:content";

const aboutEntries = await getCollection("aboutPage");
const pageData = aboutEntries[0]?.data;

if (!pageData) {
  throw new Error("Could not find index.md in src/content/aboutPage/");
}

/* Hero title formatting */
const heroWords = pageData.heroTitle.trim().split(/\s+/);
const mutedFrom = Math.ceil(heroWords.length / 2);

const splitHalf = (text: string = "") => {
  const w = text.trim().split(/\s+/);
  const m = Math.ceil(w.length / 2);
  return [w.slice(0, m).join(" "), w.slice(m).join(" ")];
};

const [whyA, whyB] = splitHalf(pageData.whySubtitle);
const [delA, delB] = splitHalf(pageData.deliveryTitle);

/* Refined Centered Isometric Architectural Building Model */
type P = [number, number];
const U: P = [28, -16];
const V: P = [-28, -16];
const add = (a: P, d: P, k = 1): P => [a[0] + d[0] * k, a[1] + d[1] * k];
const up = (p: P, h: number): P => [p[0], p[1] - h];
const pts = (a: P[]) => a.map((p) => `${p[0].toFixed(1)},${p[1].toFixed(1)}`).join(" ");

function makeDetailedTower(F: P, dx: number, dy: number, H: number, rows: number, colsR: number, colsL: number) {
  const R = add(F, U, dx);
  const L = add(F, V, dy);
  const B = add(R, V, dy);
  
  const at = (side: "l" | "r", s: number, hf: number): P =>
    side === "r" ? up(add(F, U, s * dx), H * hf) : up(add(F, V, s * dy), H * hf);

  const glassPanels: string[] = [];
  const addPanels = (side: "l" | "r", cols: number) => {
    for (let r = 0; r < rows; r++) {
      for (let c = 0; c < cols; c++) {
        const s0 = (c + 0.12) / cols, s1 = (c + 0.88) / cols;
        const h0 = (r + 0.18) / rows, h1 = (r + 0.82) / rows;
        glassPanels.push(pts([at(side, s0, h0), at(side, s1, h0), at(side, s1, h1), at(side, s0, h1)]));
      }
    }
  };
  addPanels("r", colsR);
  addPanels("l", colsL);

  const floorLines: string[] = [];
  for (let r = 1; r < rows; r++) {
    floorLines.push(pts([up(L, (H * r) / rows), up(F, (H * r) / rows), up(R, (H * r) / rows)]));
  }

  // Spire / Crown Top Accent
  const crownF = up(F, H);
  const crownR = up(R, H);
  const crownL = up(L, H);
  const crownB = up(B, H);
  const spireTip = up(add(crownF, [0, -25]), 40);

  return {
    right: pts([F, R, up(R, H), up(F, H)]),
    left: pts([F, L, up(L, H), up(F, H)]),
    top: pts([up(F, H), up(R, H), up(B, H), up(L, H)]),
    crown: pts([crownF, crownR, crownB, crownL]),
    spire: pts([add(crownF, [0, -10]), spireTip]),
    floorLines,
    glassPanels,
    at,
  };
}

// Center Offset Adjusted Visual Geometry (Base center around ~260, 390)
const mainTower = makeDetailedTower([250, 390], 3.5, 3.5, 250, 11, 4, 4);
const podiumWing = makeDetailedTower([340, 415], 3.0, 2.2, 110, 4, 3, 2);

const pipePaths = [
  { c: "cyan", d: pts([mainTower.at("l", 1, 0.2), mainTower.at("l", 0, 0.2), mainTower.at("r", 0.8, 0.2)]) },
  { c: "gold", d: pts([mainTower.at("r", 0.2, 0), mainTower.at("r", 0.2, 1)]) },
  { c: "gold", d: pts([mainTower.at("r", 0.2, 0.5), mainTower.at("r", 0.95, 0.5)]) },
  { c: "cyan", d: pts([podiumWing.at("l", 1, 0.35), podiumWing.at("l", 0, 0.35), podiumWing.at("r", 0.85, 0.35)]) },
];

const gridLines: string[] = [];
{
  const O: P = [250, 480], N = 11;
  for (let i = 0; i <= N; i++) {
    const a1 = add(O, V, i), a2 = add(a1, U, N);
    const b1 = add(O, U, i), b2 = add(b1, V, N);
    gridLines.push(`M${a1[0]},${a1[1]}L${a2[0]},${a2[1]}`, `M${b1[0]},${b1[1]}L${b2[0]},${b2[1]}`);
  }
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={pageData.heroDescription} />
    <title>About Us — AXYS3D</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <script is:inline>
      document.documentElement.classList.add("js");
    </script>
  </head>

  <body class="page-about">
    <div class="abt-page-bg" aria-hidden="true"></div>

    <Navbar variant="solid" />

    <main class="about-page">
      <!-- ================= HERO ================= -->
      <section class="abt-intro">
        <div class="abt-wrap">
          <div class="abt-intro-row">
            <div class="abt-intro-header">
              <span class="abt-kicker">{pageData.heroEyebrow}</span>
              <h1 class="abt-h1">
                <span class="abt-h1-visual">
                  {heroWords.map((w, i) => (
                    <Fragment>
                      <span
                        class:list={["abt-word", { "abt-word--muted": i >= mutedFrom }]}
                        style={`--i:${i}`}
                      >{w}</span>
                      {i === mutedFrom - 1 && <br />}
                    </Fragment>
                  ))}
                </span>
              </h1>
              <p class="abt-lead">{pageData.heroDescription}</p>
            </div>

            <!-- Centered & Realistic Architectural Glass Skyscraper Visual -->
            <div class="abt-intro-media">
              <div class="abt-viz">
                <svg class="abt-viz-svg" viewBox="0 0 540 520" aria-hidden="true" focusable="false">
                  <defs>
                    <!-- Realistic Glass Façade Gradients -->
                    <linearGradient id="glassRight" x1="0" y1="0" x2="1" y2="1">
                      <stop offset="0%" stop-color="#3b729f" stop-opacity="0.9" />
                      <stop offset="50%" stop-color="#1e486b" stop-opacity="0.95" />
                      <stop offset="100%" stop-color="#0f2940" stop-opacity="1" />
                    </linearGradient>

                    <linearGradient id="glassLeft" x1="1" y1="0" x2="0" y2="1">
                      <stop offset="0%" stop-color="#1d4d75" stop-opacity="0.9" />
                      <stop offset="50%" stop-color="#10324f" stop-opacity="0.95" />
                      <stop offset="100%" stop-color="#071b2d" stop-opacity="1" />
                    </linearGradient>

                    <linearGradient id="glassRoof" x1="0" y1="0" x2="1" y2="1">
                      <stop offset="0%" stop-color="#e2c89d" />
                      <stop offset="100%" stop-color="#8c6d46" />
                    </linearGradient>

                    <radialGradient id="buildingGlow" cx="50%" cy="50%" r="50%">
                      <stop offset="0%" stop-color="#4a90e2" stop-opacity="0.25" />
                      <stop offset="100%" stop-color="#4a90e2" stop-opacity="0" />
                    </radialGradient>

                    <radialGradient id="gridFade">
                      <stop offset="0.3" stop-color="#fff" />
                      <stop offset="1" stop-color="#000" />
                    </radialGradient>
                    <mask id="gridMask"><rect width="540" height="520" fill="url(#gridFade)" /></mask>
                  </defs>

                  <!-- Ambient Architectural Glow -->
                  <circle cx="270" cy="270" r="210" fill="url(#buildingGlow)" />

                  <!-- Structural Grid Ground -->
                  <g class="abt-grid" mask="url(#gridMask)">{gridLines.map((d) => <path d={d} />)}</g>

                  <!-- Main Tower Base Volume -->
                  <g class="abt-fill">
                    <polygon points={mainTower.left} fill="url(#glassLeft)" />
                    <polygon points={mainTower.right} fill="url(#glassRight)" />
                    <polygon points={mainTower.top} fill="url(#glassRoof)" />
                  </g>

                  <!-- Wireframe Structural Lines -->
                  <g class="abt-wires">
                    <polygon class="abt-wire abt-wa" pathLength="1" points={mainTower.left} />
                    <polygon class="abt-wire abt-wa" pathLength="1" points={mainTower.right} />
                    <polygon class="abt-wire abt-wa" pathLength="1" points={mainTower.top} />
                    {mainTower.floorLines.map((f) => <polyline class="abt-wire abt-wb" pathLength="1" points={f} />)}
                  </g>

                  <!-- Realistic Glass Window Panels with Subtle Glow -->
                  <g class="abt-win">
                    {mainTower.glassPanels.map((w, i) => <polygon points={w} style={`--w:${((i * 19) % 11) / 4}s`} />)}
                  </g>

                  <!-- Building MEP & Structural Details -->
                  <g class="abt-mepg">
                    {pipePaths.slice(0, 3).map((m) => <polyline class={`abt-mep abt-mep-${m.c}`} pathLength="1" points={m.d} />)}
                  </g>

                  <!-- Podium Wing Volume -->
                  <g class="abt-fill">
                    <polygon points={podiumWing.left} fill="url(#glassLeft)" />
                    <polygon points={podiumWing.right} fill="url(#glassRight)" />
                    <polygon points={podiumWing.top} fill="url(#glassRoof)" />
                  </g>
                  <g class="abt-wires">
                    <polygon class="abt-wire abt-wa" pathLength="1" points={podiumWing.left} />
                    <polygon class="abt-wire abt-wa" pathLength="1" points={podiumWing.right} />
                    <polygon class="abt-wire abt-wa" pathLength="1" points={podiumWing.top} />
                    {podiumWing.floorLines.map((f) => <polyline class="abt-wire abt-wb" pathLength="1" points={f} />)}
                  </g>
                  <g class="abt-win">
                    {podiumWing.glassPanels.map((w, i) => <polygon points={w} style={`--w:${((i * 13) % 7) / 3}s`} />)}
                  </g>

                  <!-- Animated Drone / Camera Orbit Ring -->
                  <g class="abt-orbit">
                    <path class="abt-orbit-path" d="M60,350 A210,110 0 0 1 480,350 A210,110 0 0 1 60,350" />
                  </g>
                  <g class="abt-orbit abt-cam">
                    <circle r="6" fill="#d2b487" class="abt-cam-dot">
                      <animateMotion dur="8s" repeatCount="indefinite" path="M60,350 A210,110 0 0 1 480,350 A210,110 0 0 1 60,350" />
                    </circle>
                  </g>
                </svg>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- ================= WHY ================= -->
      <section class="abt-why">
        <div class="abt-wrap">
          <div class="abt-why-panel" data-reveal>
            <div>
              <span class="abt-kicker">{pageData.whyTitle}</span>
              <h2 class="abt-why-h2">{whyA} <span>{whyB}</span></h2>
            </div>
            <p class="abt-why-desc">{pageData.whyDescription}</p>
          </div>
        </div>
      </section>

      <!-- ================= PRINCIPLES ================= -->
      <section class="abt-principles">
        <div class="abt-wrap">
          <div class="abt-principles-header" data-reveal>
            <div class="abt-principles-header-left">
              <span class="abt-kicker">Principles</span>
              <h2 class="abt-principles-h2">What guides <span>our work</span></h2>
            </div>
          </div>

          <div class="abt-principles-grid">
            {
              pageData.principles &&
                pageData.principles.map((item) => (
                  <div class="abt-principle-card" data-reveal>
                    <span class="abt-card-num">{item.num}</span>
                    <h3 class="abt-card-title">{item.title}</h3>
                    <p class="abt-card-desc">{item.description}</p>
                  </div>
                ))
            }
          </div>
        </div>
      </section>

      <!-- ================= FINAL CTA ================= -->
      <section class="abt-final-cta">
        <div class="abt-wrap">
          <div class="abt-final-inner" data-reveal>
            <h2>{delA} <span>{delB}</span></h2>
            <p>{pageData.deliveryDescription}</p>
            <a href="/Process" class="abt-final-button">
              <span>{pageData.ctaLabel || "See the six-stage process"}</span>
              <span>↗</span>
            </a>
          </div>
        </div>
      </section>
    </main>

    <Footer />

    <script is:inline>
      // Scroll Reveal Observer
      const revealObserver = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add("is-visible");
              revealObserver.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.12 }
      );
      document.querySelectorAll("[data-reveal]").forEach((el) => revealObserver.observe(el));
    </script>
  </body>
</html>