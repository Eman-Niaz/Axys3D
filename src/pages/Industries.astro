---
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import "../styles/token.css";
import "../styles/global.css";
import "../styles/Navbar.css";
import "../styles/industries.css";
import "../styles/footer.css";
import { getEntry } from "astro:content";

interface IndustrySection {
  id: string;
  title: string;
  targetBuyer: string;
  description: string;
  ctaLink: string;
  ctaLabel: string;
}

const pageEntry = await getEntry("industriesPage", "index");

if (!pageEntry) {
  throw new Error("Could not find index.md in src/content/industriesPage/");
}

const {
  heroTitle,
  heroSubtitle,
  heroDescription,
  industrySections,
} = pageEntry.data as {
  heroTitle: string;
  heroSubtitle: string;
  heroDescription: string;
  industrySections: IndustrySection[];
};

/* Temporary industry images (hero + slider cards) */
const industryImages = [
  "https://images.unsplash.com/photo-1600607687920-4e2a09cf159d?auto=format&fit=crop&w=1600&q=85",
  "https://images.unsplash.com/photo-1600585154340-be6161a56a0c?auto=format&fit=crop&w=1600&q=85",
  "https://images.unsplash.com/photo-1600566753086-00f18fb6b3ea?auto=format&fit=crop&w=1600&q=85",
  "https://images.unsplash.com/photo-1600566753190-17f0baa2a6c3?auto=format&fit=crop&w=1600&q=85",
  "https://images.unsplash.com/photo-1600607688969-a5bfcd646154?auto=format&fit=crop&w=1600&q=85",
  "https://images.unsplash.com/photo-1541888946425-d81bb19240f5?auto=format&fit=crop&w=1600&q=85",
  "https://images.unsplash.com/photo-1504307651254-35680f356dfd?auto=format&fit=crop&w=1600&q=85",
  "https://images.unsplash.com/photo-1503387762-592deb58ef4e?auto=format&fit=crop&w=1600&q=85",
];

/*
 * ROTATING SPHERE GALLERY (hero) — images yahan se aati hain.
 * Abhi industryImages use ho rahi hain (w=1600 -> w=320 chhota thumbnail).
 * Apni renders lagani hon to sirf sphereSource array badal do,
 * e.g. ["/images/sphere/01.jpg", "/images/sphere/02.jpg", ...]  (public/images/sphere/ me rakho, ~400px wide)
 */
const sphereSource = industryImages.map((u) =>
  u.replace("w=1600", "w=320").replace("q=85", "q=70")
);

const SPHERE_COLS = 30; // sphere ke gird me kitne columns (kam karoge to halka chalega)
const SPHERE_ROWS = 5;
const SPHERE_ROW_STEP = 12; // degrees

const blobShapes = [
  "52% 48% 55% 45% / 48% 54% 46% 52%",
  "46% 54% 48% 52% / 55% 45% 55% 45%",
  "58% 42% 50% 50% / 46% 52% 48% 54%",
  "50% 50% 44% 56% / 54% 46% 54% 46%",
  "44% 56% 52% 48% / 50% 58% 42% 50%",
  "55% 45% 47% 53% / 44% 50% 50% 56%",
];

const sphereTiles: { yaw: number; pitch: number; src: string; shape: string; n: number }[] = [];
for (let c = 0; c < SPHERE_COLS; c++) {
  for (let r = 0; r < SPHERE_ROWS; r++) {
    const stagger = c % 2 ? 0.25 : -0.25; // alternate columns half-step upar/neechay
    sphereTiles.push({
      yaw: c * (360 / SPHERE_COLS),
      pitch: (r - (SPHERE_ROWS - 1) / 2 + stagger) * SPHERE_ROW_STEP,
      src: sphereSource[(c * 3 + r * 2) % sphereSource.length],
      shape: blobShapes[(c * 5 + r * 7) % blobShapes.length],
      n: c * SPHERE_ROWS + r,
    });
  }
}

/*
 * Trusted-across-borders stats — yahan se numbers / labels badal sakte hain.
 * value = final number, from = count-up jahan se shuru ho (optional), plus = "+" dikhana hai ya nahi.
 */
const icon = (paths: string) =>
  `<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${paths}</svg>`;

const stats = [
  {
    label: "Founded in",
    value: 2012,
    from: 1990,
    plus: false,
    icon: icon('<path d="M4 20l4-11 7 7-11 4z"/><path d="M14 4v2M19 9h2M17 6l1.5-1.5M9 3.5l.5 1.5M20 14l-1.5-.5"/>'),
  },
  {
    label: "Network clients",
    value: 100,
    plus: true,
    icon: icon('<path d="M3 12l4-4 4 1 3-2 5 4-5 6-3-1-2 2-3-1z"/><path d="M8 8l-2 2M11 9l2 2"/>'),
  },
  {
    label: "Markets served",
    value: 10,
    plus: true,
    icon: icon('<path d="M4 9l1.5-5h13L20 9"/><path d="M4 9h16v2a2.5 2.5 0 01-5 0 2.5 2.5 0 01-5 0 2.5 2.5 0 01-5 0z"/><path d="M5.5 13.5V20h13v-6.5"/><path d="M10 20v-4h4v4"/>'),
  },
  {
    label: "Certification marks",
    value: 4,
    plus: true,
    icon: icon('<circle cx="12" cy="9" r="5.5"/><path d="M9 14l-1.5 7L12 18.5 16.5 21 15 14"/>'),
  },
];

/* Hero title: pehla aadha white, doosra aadha muted (Services jaisa) */
const heroWords = heroSubtitle.trim().split(/\s+/);
const mutedFrom = Math.ceil(heroWords.length / 2);

const total = industrySections.length;
const pad = (n: number) => String(n).padStart(2, "0");
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={heroDescription} />
    <title>Industries & Workflows — Axys3D</title>
    <script is:inline>
      document.documentElement.classList.add("js");
    </script>
  </head>

  <body class="page-industries">
    <!-- PAGE BACKGROUND — soft gradient with a drifting corner glow -->
    <div class="ind-page-bg" aria-hidden="true"></div>

    <Navbar variant="solid" />

    <main class="industries-page">
      <!-- ================= HERO ================= -->
      <section class="ind-intro">
        <div class="ind-wrap">
          <div class="ind-intro-row">
            <div class="ind-intro-header">
              <span class="ind-kicker">{heroTitle}</span>
              <h1 class="ind-h1">
                <span class="ind-h1-visual" aria-hidden="true">
                  {heroWords.map((w, i) => (
                    <Fragment>
                      <span
                        class:list={["ind-word", { "ind-word--muted": i >= mutedFrom }]}
                        style={`--i:${i}`}
                      >{w}</span>
                      {i === mutedFrom - 1 && <br />}
                    </Fragment>
                  ))}
                </span>
                <span class="sr-only">{heroSubtitle}</span>
              </h1>
              <p class="ind-lead">{heroDescription}</p>
            </div>

            <div class="ind-intro-media">
              <div
                class="ind-sphere-stage"
                data-sphere
                role="img"
                aria-label="Interactive rotating gallery of Axys3D architectural visuals. Drag to rotate."
              >
                <div class="ind-sphere">
                  {sphereTiles.map((t) => (
                    <span
                      class="ind-tile"
                      style={`--yaw:${t.yaw}deg;--pitch:${t.pitch}deg;--n:${t.n};border-radius:${t.shape}`}
                    >
                      <img
                        src={t.src}
                        alt=""
                        loading="eager"
                        decoding="async"
                        draggable="false"
                      />
                    </span>
                  ))}
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- ================= TRUSTED ACROSS BORDERS ================= -->
      <section class="ind-trust">
        <div class="ind-wrap">
          <div class="ind-sec-head" data-reveal>
            <h2 class="ind-sec-h2">Trusted <br /><span>across borders</span></h2>
          </div>

          <div class="ind-stats">
            {stats.map((s, i) => (
              <article class="ind-stat" data-reveal data-stat style={`--d: ${i * 100}ms`}>
                <div class="ind-stat-top">
                  <span class="ind-stat-label">{s.label}</span>
                  <span class="ind-stat-icon" set:html={s.icon} />
                </div>
                <div class="ind-stat-value">
                  <span
                    class="ind-stat-num"
                    data-count={s.value}
                    data-from={s.from ?? 0}
                  >{s.value}</span>
                  {s.plus && <sup class="ind-stat-plus">+</sup>}
                </div>
              </article>
            ))}
          </div>
        </div>
      </section>

      <!-- ================= INDUSTRIES (2 x 2 CARDS) ================= -->
      <section class="ind-cards-sec" id="industries">
        <div class="ind-wrap">
          <div class="ind-sec-head" data-reveal>
            <span class="ind-kicker">INDUSTRIES</span>
            <h2 class="ind-sec-h2">Built for every <br /><span>production workflow.</span></h2>
          </div>

          <div class="ind-cards-grid">
            {industrySections.map((item, i) => (
              <a
                class="ind-card"
                id={`industry-${item.id}`}
                href={item.ctaLink}
                data-reveal
                style={`--d: ${(i % 2) * 120}ms`}
                aria-label={`${item.title} — ${item.ctaLabel}`}
              >
                <img
                  src={industryImages[i % industryImages.length]}
                  alt=""
                  loading="lazy"
                  decoding="async"
                  draggable="false"
                />
                <div class="ind-card-overlay"></div>
                <div class="ind-card-shine"></div>

                <div class="ind-card-body">
                  <span class="ind-card-num">{pad(i + 1)}</span>
                  <span class="ind-card-target">{item.targetBuyer}</span>
                  <h3 class="ind-card-title">{item.title}</h3>
                  <p class="ind-card-desc">{item.description}</p>
                  <span class="ind-card-arrow" aria-hidden="true">
                    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
                  </span>
                </div>
              </a>
            ))}
          </div>
        </div>
      </section>

      <!-- ================= FINAL CTA ================= -->
      <section class="ind-final-cta">
        <div class="ind-wrap">
          <div class="ind-final-inner" data-reveal>
            <h2>Your industry. <br /><span>Our production layer.</span></h2>
            <p>Tell us what you're building, where you are in the workflow, and what needs to move next.</p>
            <a href="/contact" class="ind-final-button">
              <span>Discuss a production package</span>
              <span>↗</span>
            </a>
          </div>
        </div>
      </section>
    </main>

    <Footer />

    <script is:inline>
      const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

      // Count-up for the stat numbers
      const countUp = (card) => {
        const el = card.querySelector("[data-count]");
        if (!el || reduceMotion) return;
        const to = Number(el.dataset.count);
        const from = Number(el.dataset.from || 0);
        const dur = 1600;
        const t0 = performance.now();
        const tick = (now) => {
          const p = Math.min((now - t0) / dur, 1);
          const eased = 1 - Math.pow(1 - p, 4);
          el.textContent = Math.round(from + (to - from) * eased);
          if (p < 1) requestAnimationFrame(tick);
        };
        el.textContent = from;
        requestAnimationFrame(tick);
      };

      // Reveal on scroll
      const revealItems = document.querySelectorAll("[data-reveal]");
      const revealObserver = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add("is-visible");
              if (entry.target.hasAttribute("data-stat")) {
                const d = parseInt(entry.target.style.getPropertyValue("--d")) || 0;
                setTimeout(() => countUp(entry.target), d + 200);
              }
              revealObserver.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.12 }
      );
      revealItems.forEach((item) => revealObserver.observe(item));

      // Card spotlight: light follows the cursor
      document.querySelectorAll(".ind-card").forEach((card) => {
        card.addEventListener("pointermove", (e) => {
          const r = card.getBoundingClientRect();
          card.style.setProperty("--mx", `${e.clientX - r.left}px`);
          card.style.setProperty("--my", `${e.clientY - r.top}px`);
        });
      });

      /* ===== Sphere gallery (hero): auto-rotate + drag + mouse-follow ===== */
      (() => {
        const stage = document.querySelector("[data-sphere]");
        if (!stage) return;
        const sphere = stage.querySelector(".ind-sphere");
        const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

        let R = 300;
        const layout = () => {
          const W = stage.clientWidth;
          const H = stage.clientHeight;
          if (!W || !H) return;
          R = Math.min(W * 0.52, H * 0.9);
          stage.style.perspective = `${R * 3}px`;
          stage.style.setProperty("--R", `${R}px`);
          stage.style.setProperty("--tw", `${R * 0.15}px`);
          stage.style.setProperty("--tht", `${R * 0.16}px`);
        };
        layout();
        new ResizeObserver(layout).observe(stage);

        const BASE_PITCH = -6;
        const AUTO_SPEED = reduce ? 0 : 0.07; // degrees per frame
        let yaw = 0, pitch = BASE_PITCH, vYaw = 0, vPitch = 0;
        let dragging = false, inside = false;
        let lastX = 0, lastY = 0, hoverX = 0, hoverY = 0;
        let running = true, last = performance.now();
        const clamp = (v, a, b) => Math.max(a, Math.min(b, v));

        const render = () => {
          sphere.style.transform = `translateZ(${-R}px) rotateX(${pitch}deg) rotateY(${yaw}deg)`;
        };

        const frame = (now) => {
          const dt = Math.min((now - last) / 16.667, 3);
          last = now;
          if (running && !dragging) {
            const hoverSpin = inside && !reduce ? hoverX * 0.16 : 0;
            yaw = (yaw + (vYaw + AUTO_SPEED + hoverSpin) * dt) % 360;
            pitch += vPitch * dt;
            const target = BASE_PITCH + (inside && !reduce ? hoverY * 8 : 0);
            pitch += (target - pitch) * 0.035 * dt;
            pitch = clamp(pitch, -40, 40);
            const decay = Math.pow(0.95, dt);
            vYaw *= decay;
            vPitch *= decay;
          }
          if (running) render();
          requestAnimationFrame(frame);
        };

        stage.addEventListener("pointerdown", (e) => {
          dragging = true;
          lastX = e.clientX;
          lastY = e.clientY;
          vYaw = 0;
          vPitch = 0;
          stage.classList.add("is-dragging");
          stage.setPointerCapture(e.pointerId);
        });

        stage.addEventListener("pointermove", (e) => {
          const r = stage.getBoundingClientRect();
          hoverX = ((e.clientX - r.left) / r.width - 0.5) * 2;
          hoverY = ((e.clientY - r.top) / r.height - 0.5) * 2;
          inside = true;
          if (!dragging) return;
          const dx = e.clientX - lastX;
          const dy = e.clientY - lastY;
          lastX = e.clientX;
          lastY = e.clientY;
          yaw += dx * 0.3;
          pitch = clamp(pitch - dy * 0.2, -40, 40);
          vYaw = clamp(dx * 0.3, -8, 8);
          vPitch = clamp(-dy * 0.2, -5, 5);
        });

        const endDrag = () => {
          dragging = false;
          stage.classList.remove("is-dragging");
        };
        stage.addEventListener("pointerup", endDrag);
        stage.addEventListener("pointercancel", endDrag);
        stage.addEventListener("pointerleave", () => { inside = false; });

        // screen se bahar ho to animation rok do
        new IntersectionObserver(([entry]) => {
          running = entry.isIntersecting;
          last = performance.now();
        }).observe(stage);

        render();
        requestAnimationFrame(frame);
      })();
    </script>
  </body>
</html>