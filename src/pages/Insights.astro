---
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import "../styles/token.css";
import "../styles/global.css";
import "../styles/Navbar.css";
import "../styles/insights.css";
import "../styles/footer.css";
import { getCollection } from "astro:content";

// Fetch Master Insights Page Header Content
const insightsPageEntries = await getCollection("insightsPage");
const pageData = insightsPageEntries[0]?.data || {
  heroTitle: "Insights / Technical production",
  heroSubtitle: "Practical notes for controlled AEC delivery.",
  heroDescription:
    "Fictional development articles demonstrate the editorial structure. They are not client evidence, legal advice or published thought leadership.",
};

// Fetch All Insight Articles
const articles = await getCollection("insights");

/*
 * Article card images fallback list
 */
const q = "?auto=format&fit=crop&w=1400&q=80";
const articleImages = [
  `https://images.unsplash.com/photo-1486406146926-c627a92ad1ab${q}`,
  `https://images.unsplash.com/photo-1503387762-592deb58ef4e${q}`,
  `https://images.unsplash.com/photo-1487958449943-2429e8be8625${q}`,
  `https://images.unsplash.com/photo-1541888946425-d81bb19240f5${q}`,
  `https://images.unsplash.com/photo-1518005020951-eccb494ad742${q}`,
  `https://images.unsplash.com/photo-1504307651254-35680f356dfd${q}`,
  `https://images.unsplash.com/photo-1497366216548-37526070297c${q}`,
  `https://images.unsplash.com/photo-1511818966892-d7d671e672a2${q}`,
];

/* Hero title typography split */
const heroWords = pageData.heroSubtitle.trim().split(/\s+/);
const mutedFrom = Math.ceil(heroWords.length / 2);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={pageData.heroDescription} />
    <title>{pageData.heroTitle} — Axys3D</title>
    <script is:inline>
      document.documentElement.classList.add("js");
    </script>
  </head>

  <body class="page-insights-list">
    <!-- PAGE BACKGROUND -->
    <div class="isl-page-bg" aria-hidden="true"></div>

    <Navbar variant="solid" />

    <main class="isl-page">
      <!-- ================= HERO ================= -->
      <section class="isl-intro">
        <div class="isl-wrap">
          <div class="isl-intro-row">
            <div class="isl-intro-header">
              <span class="isl-kicker">{pageData.heroTitle}</span>
              <h1 class="isl-h1">
                <span class="isl-h1-visual" aria-hidden="true">
                  {heroWords.map((w, i) => (
                    <Fragment>
                      <span
                        class:list={["isl-word", { "isl-word--muted": i >= mutedFrom }]}
                        style={`--i:${i}`}
                      >{w}</span>
                      {i === mutedFrom - 1 && <br />}
                    </Fragment>
                  ))}
                </span>
                <span class="sr-only">{pageData.heroSubtitle}</span>
              </h1>
              <p class="isl-lead">{pageData.heroDescription}</p>
            </div>

            <!-- SEAMLESS / BORDERLESS HIGH-CONTRAST VISUAL -->
            <div class="isl-intro-media isl-intro-media--seamless">
              <svg class="isl-flow" viewBox="0 0 920 540" role="img" aria-label="Axys3D Intelligence Hub Visual" preserveAspectRatio="xMidYMid meet">
                <defs>
                  <!-- Gradient Definitions -->
                  <linearGradient id="isl-trace-grad" x1="0%" y1="0%" x2="100%" y2="100%">
                    <stop offset="0%" stop-color="#408ce0" stop-opacity="0.5"/>
                    <stop offset="50%" stop-color="#d2b487" stop-opacity="1"/>
                    <stop offset="100%" stop-color="#ffffff" stop-opacity="1"/>
                  </linearGradient>

                  <linearGradient id="card-dark" x1="0%" y1="0%" x2="0%" y2="100%">
                    <stop offset="0%" stop-color="#122b40" stop-opacity="0.95"/>
                    <stop offset="100%" stop-color="#081726" stop-opacity="0.98"/>
                  </linearGradient>

                  <radialGradient id="isl-coreGlow" cx="50%" cy="50%" r="50%">
                    <stop offset="0%" stop-color="#d2b487" stop-opacity="0.35"/>
                    <stop offset="100%" stop-color="#d2b487" stop-opacity="0"/>
                  </radialGradient>

                  <filter id="isl-laserGlow" x="-30%" y="-30%" width="160%" height="160%">
                    <feGaussianBlur stdDeviation="4" result="coloredBlur"/>
                    <feMerge>
                      <feMergeNode in="coloredBlur"/>
                      <feMergeNode in="SourceGraphic"/>
                    </feMerge>
                  </filter>
                </defs>

                <!-- Blueprint Grid Lines -->
                <g class="isl-cad-grid" opacity="0.22" stroke="#5f86a8" stroke-width="0.8">
                  <path d="M 30 100 H 890 M 30 200 H 890 M 30 300 H 890 M 30 400 H 890" stroke-dasharray="3 9"/>
                  <path d="M 120 30 V 510 M 280 30 V 510 M 460 30 V 510 M 640 30 V 510 M 800 30 V 510" stroke-dasharray="3 9"/>
                  <circle cx="460" cy="270" r="210" stroke="#d2b487" stroke-width="1" fill="none" stroke-dasharray="3 7"/>
                  <circle cx="460" cy="270" r="280" stroke="#408ce0" stroke-width="0.8" fill="none" stroke-dasharray="4 12"/>
                </g>

                <!-- Central Radial Glow -->
                <circle cx="460" cy="270" r="200" fill="url(#isl-coreGlow)"/>

                <!-- Network Beam Lines -->
                <g stroke="rgba(210,180,135,0.4)" stroke-width="1.4">
                  <line x1="150" y1="160" x2="460" y2="270" stroke-dasharray="3 5"/>
                  <line x1="150" y1="390" x2="460" y2="270" stroke-dasharray="3 5"/>
                  <line x1="770" y1="150" x2="460" y2="270" stroke-dasharray="3 5"/>
                  <line x1="770" y1="400" x2="460" y2="270" stroke-dasharray="3 5"/>
                  <line x1="460" y1="95" x2="460" y2="270"/>
                </g>

                <!-- Animated Lasers -->
                <path class="isl-laser-beam" d="M 150 160 Q 290 200 460 270 T 770 400" fill="none" filter="url(#isl-laserGlow)"/>
                <path class="isl-laser-tail" d="M 150 390 Q 300 340 460 270 T 770 150" fill="none"/>

                <!-- CENTRAL KNOWLEDGE HUB -->
                <g transform="translate(460, 270)">
                  <circle class="isl-orbit-ring" r="75" fill="none" stroke="#d2b487" stroke-width="1.5" stroke-dasharray="10 6" opacity="0.8"/>
                  <circle r="52" fill="url(#card-dark)" stroke="#d2b487" stroke-width="2"/>
                  <circle r="34" fill="none" stroke="rgba(64,140,224,0.7)" stroke-width="1.5" stroke-dasharray="4 4"/>
                  <circle r="7" fill="#d2b487" class="isl-pulse-sensor"/>
                  <polygon points="0,-18 16,-9 16,9 0,18 -16,9 -16,-9" fill="none" stroke="#ffffff" stroke-width="1.5"/>
                  
                  <g class="isl-stage-tag" transform="translate(0, 86)">
                    <text class="isl-tag-num" x="0" y="0">AXYS3D INTELLIGENCE</text>
                    <text class="isl-tag-title" x="0" y="14">KNOWLEDGE & ADVISORY HUB</text>
                  </g>
                </g>

                <!-- TOP LEFT: METHODOLOGY -->
                <g transform="translate(150, 160)">
                  <circle class="isl-anchor-ring isl-ring1" r="28" fill="none"/>
                  <circle class="isl-anchor-dot isl-node1" r="5" fill="#d2b487"/>
                  <g class="isl-module isl-stage1" transform="translate(0, -32)">
                    <g class="isl-hover-float">
                      <rect x="-75" y="-32" width="150" height="48" rx="8" fill="url(#card-dark)" stroke="#d2b487" stroke-width="1.5"/>
                      <text x="-60" y="-12" fill="#d2b487" font-size="9" font-family="monospace" font-weight="bold">METHODOLOGY</text>
                      <text x="-60" y="4" fill="#ffffff" font-size="10.5" font-family="sans-serif" font-weight="700">LOD 350+ Standards</text>
                      <circle cx="56" cy="-9" r="9" fill="#408ce0" fill-opacity="0.3" stroke="#408ce0" stroke-width="1.2"/>
                      <path d="M 53 -9 L 55 -7 L 59 -11" fill="none" stroke="#ffffff" stroke-width="1.5"/>
                    </g>
                  </g>
                </g>

                <!-- BOTTOM LEFT: DELIVERY NETWORK -->
                <g transform="translate(150, 390)">
                  <circle class="isl-anchor-ring isl-ring2" r="28" fill="none"/>
                  <circle class="isl-anchor-dot isl-node2" r="5" fill="#408ce0"/>
                  <g class="isl-module isl-stage2" transform="translate(0, 40)">
                    <g class="isl-hover-float" style="animation-delay: -1.5s">
                      <rect x="-75" y="-16" width="150" height="48" rx="8" fill="url(#card-dark)" stroke="rgba(255,255,255,0.3)" stroke-width="1.2"/>
                      <text x="-60" y="2" fill="#8997a1" font-size="8.5" font-family="monospace">DELIVERY NETWORK</text>
                      <text x="-60" y="18" fill="#ffffff" font-size="10" font-family="sans-serif" font-weight="600">Architects & Consultants</text>
                    </g>
                  </g>
                </g>

                <!-- TOP RIGHT: AUDITED IMPACT -->
                <g transform="translate(770, 150)">
                  <circle class="isl-anchor-ring isl-ring4" r="28" fill="none"/>
                  <circle class="isl-anchor-dot isl-node4" r="5" fill="#2ac288"/>
                  <g class="isl-module isl-stage4" transform="translate(0, -32)">
                    <g class="isl-hover-float" style="animation-delay: -0.8s">
                      <rect x="-75" y="-32" width="150" height="48" rx="8" fill="url(#card-dark)" stroke="#2ac288" stroke-width="1.5"/>
                      <text x="-60" y="-12" fill="#2ac288" font-size="9" font-family="monospace" font-weight="bold">AUDITED IMPACT</text>
                      <text x="-60" y="4" fill="#ffffff" font-size="10.5" font-family="sans-serif" font-weight="700">40% Efficiency Gain</text>
                      <circle cx="56" cy="-9" r="9" fill="#2ac288" fill-opacity="0.3" stroke="#2ac288" stroke-width="1.2"/>
                      <path d="M 53 -9 L 55 -7 L 59 -11" fill="none" stroke="#2ac288" stroke-width="1.5"/>
                    </g>
                  </g>
                </g>

                <!-- BOTTOM RIGHT: EXECUTION FRAMEWORK -->
                <g transform="translate(770, 400)">
                  <circle class="isl-anchor-ring isl-ring5" r="28" fill="none"/>
                  <circle class="isl-anchor-dot isl-node5" r="5" fill="#408ce0"/>
                  <g class="isl-module isl-stage5" transform="translate(0, 40)">
                    <g class="isl-hover-float" style="animation-delay: -2.2s">
                      <rect x="-75" y="-16" width="150" height="48" rx="8" fill="url(#card-dark)" stroke="rgba(64,140,224,0.6)" stroke-width="1.2"/>
                      <text x="-60" y="2" fill="#408ce0" font-size="8.5" font-family="monospace">EXECUTION FRAMEWORK</text>
                      <text x="-60" y="18" fill="#ffffff" font-size="10" font-family="sans-serif" font-weight="600">Controlled Handover</text>
                    </g>
                  </g>
                </g>

                <!-- TOP CENTER BADGE -->
                <g transform="translate(460, 85)">
                  <rect x="-80" y="-18" width="160" height="32" rx="16" fill="#071522" stroke="#d2b487" stroke-width="1.2"/>
                  <circle cx="-60" cy="0" r="3.5" fill="#2ac288" class="isl-pulse-sensor"/>
                  <text x="-46" y="3.5" fill="#ffffff" font-size="9" font-family="monospace" letter-spacing="0.08em">LIVE AEC INSIGHTS</text>
                </g>
              </svg>
            </div>
          </div>
        </div>
      </section>

      <!-- ================= ARTICLES ================= -->
      <section class="isl-cards-sec" id="articles">
        <div class="isl-wrap">
          <div class="isl-sec-head isl-sec-head--row" data-reveal>
            <div>
              <span class="isl-kicker">LATEST ARTICLES</span>
              <h2 class="isl-sec-h2">Latest reading <br /><span>from our team.</span></h2>
            </div>
          </div>

          {articles.length > 0 ? (
            <div class="isl-cards-grid">
              {articles.map((article, i) => (
                <a
                  class="isl-card"
                  href={`/insights/${article.id}`}
                  data-reveal
                  style={`--d: ${(i % 2) * 120}ms`}
                  aria-label={`${article.data.title} — ${article.data.ctaLabel}`}
                >
                  <img
                    src={(article.data as any).image ?? articleImages[i % articleImages.length]}
                    alt=""
                    loading={i < 2 ? "eager" : "lazy"}
                    decoding="async"
                    draggable="false"
                  />
                  <div class="isl-card-overlay"></div>
                  <div class="isl-card-shine"></div>

                  <div class="isl-card-top">
                    <span class="isl-card-meta">
                      {article.data.category} / {article.data.readTime}
                    </span>
                    <span class="isl-card-badge">{article.data.badgeText}</span>
                  </div>

                  <div class="isl-card-body">
                    <h3 class="isl-card-title">{article.data.title}</h3>
                    <p class="isl-card-desc">{article.data.summary}</p>
                    <span class="isl-card-cta">
                      <span class="isl-card-arrow" aria-hidden="true">
                        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
                      </span>
                      <span class="isl-card-cta-label">{article.data.ctaLabel}</span>
                    </span>
                  </div>
                </a>
              ))}
            </div>
          ) : (
            <p class="isl-empty">No articles found in src/content/insights/</p>
          )}
        </div>
      </section>

      <!-- ================= FINAL CTA ================= -->
      <section class="isl-final-cta">
        <div class="isl-wrap">
          <div class="isl-final-inner" data-reveal>
            <h2>Have a question? <br /><span>Let's talk production.</span></h2>
            <p>Tell us what you're working on and we'll point you to the right technical approach.</p>
            <a href="/contact" class="isl-final-button">
              <span>Get in touch</span>
              <span>↗</span>
            </a>
          </div>
        </div>
      </section>
    </main>

    <Footer />

    <script is:inline>
      const revealItems = document.querySelectorAll("[data-reveal]");
      const revealObserver = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add("is-visible");
              revealObserver.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.12 }
      );
      revealItems.forEach((item) => revealObserver.observe(item));

      document.querySelectorAll(".isl-card").forEach((card) => {
        card.addEventListener("pointermove", (e) => {
          const r = card.getBoundingClientRect();
          card.style.setProperty("--mx", `${e.clientX - r.left}px`);
          card.style.setProperty("--my", `${e.clientY - r.top}px`);
        });
      });
    </script>
  </body>
</html>