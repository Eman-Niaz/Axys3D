---
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import "../styles/token.css";
import "../styles/global.css";
import "../styles/Navbar.css";
import "../styles/processPage.css";
import "../styles/footer.css";
import { getEntry } from "astro:content";

// Aap ke schema ke exact loader ke mutabiq entry fetch kar rahe hain
const processEntry = await getEntry("process", "index");

if (!processEntry) {
  throw new Error("Could not find index.md in src/content/process/");
}

const {
  heroTitle,
  heroSubtitle,
  heroDescription,
  steps,
  controlPointsTitle,
  controlPointsSubtitle,
  controlPoints = [],
  ctaTitle,
  ctaSubtitle,
  ctaLabel,
  ctaLink,
} = processEntry.data;

const stepsCount = steps.length.toString().padStart(2, "0");
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={heroDescription} />
    <title>{heroSubtitle} — Axys3D</title>
  </head>

  <body class="page-process">
    <!-- BACKGROUND LAYER -->
    <div class="prc-page-bg"><div class="prc-page-bg-overlay"></div></div>

    <Navbar variant="solid" />

    <main class="process-page">
      <!-- HERO SECTION -->
      <header class="prc-hero">
        <div class="prc-wrap">
          <div class="prc-hero-label">
            <span>Methodology</span>
          </div>
          <div class="prc-hero-content">
            <p class="prc-eyebrow">{heroTitle}</p>
            <h1 class="prc-h1">{heroSubtitle}</h1>
            <p class="prc-lead">{heroDescription}</p>
          </div>
        </div>
      </header>

      <!-- STEPS LIST SECTION (01 - 06) -->
      <section class="prc-steps-section">
        <div class="prc-wrap">
          <div class="prc-intro">
            <div>
              <span class="prc-section-label">The Workflow</span>
              <h2>A Structured <span>Delivery Process</span></h2>
            </div>
            <div class="prc-intro-meta">
              <span class="prc-count">{stepsCount} STEPS</span>
              <span class="prc-intro-line"></span>
            </div>
          </div>

          <div class="prc-steps-grid">
            {steps.map((step) => (
              <div class="prc-step-card">
                <div class="prc-step-header">
                  <span class="prc-step-num">{step.id}</span>
                  <h3 class="prc-step-title">{step.title}</h3>
                </div>
                <p class="prc-step-desc">{step.description}</p>
              </div>
            ))}
          </div>
        </div>
      </section>

      <!-- CONTROL POINTS SECTION -->
      {controlPoints.length > 0 && (
        <section class="prc-controls-section">
          <div class="prc-wrap">
            <div class="prc-controls-grid">
              <div class="prc-controls-left">
                {controlPointsTitle && <p class="prc-eyebrow-small">{controlPointsTitle}</p>}
                {controlPointsSubtitle && (
                  <h2 class="prc-controls-subtitle">{controlPointsSubtitle}</h2>
                )}
              </div>

              <div class="prc-controls-right">
                <ul class="prc-controls-list">
                  {controlPoints.map((point) => (
                    <li class="prc-control-item">
                      <span class="prc-check-icon">✓</span>
                      <span>{point}</span>
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          </div>
        </section>
      )}

      <!-- CTA / TECHNICAL BRIEF SECTION -->
      {ctaTitle && (
        <section class="prc-final-cta">
          <div class="prc-wrap prc-final-inner">
            {ctaTitle && <span class="prc-cta-kicker">{ctaTitle}</span>}
            {ctaSubtitle && <h3 class="prc-cta-h3">{ctaSubtitle}</h3>}
            {ctaLabel && (
              <a href={ctaLink || "/Contact/"} class="prc-cta-btn">
                <span>{ctaLabel}</span> <span class="prc-arrow">→</span>
              </a>
            )}
          </div>
        </section>
      )}
    </main>

    <Footer />

    <script>
      // Scroll-reveal: step cards aur control items ko andar aate waqt
      // fade-up karta hai, Work page ke card-reveal animation ki tarah.
      const revealTargets = document.querySelectorAll<HTMLElement>(
        ".prc-step-card, .prc-control-item"
      );

      revealTargets.forEach((el, i) => {
        el.style.setProperty("--prc-delay", `${(i % 6) * 0.08}s`);
      });

      const revealObserver = new IntersectionObserver(
        (entries, observer) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add("prc-reveal-visible");
              observer.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.15, rootMargin: "0px 0px -40px 0px" }
      );

      revealTargets.forEach((el) => revealObserver.observe(el));
    </script>
  </body>
</html>