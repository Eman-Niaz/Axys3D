---
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import "../styles/token.css";
import "../styles/global.css";
import "../styles/Navbar.css";
import "../styles/processPage.css";
import "../styles/footer.css";
import { getEntry } from "astro:content";

const processEntry = await getEntry("process", "index");

if (!processEntry) {
  throw new Error("Could not find index.md in src/content/process/");
}

const {
  heroTitle,
  heroSubtitle,
  heroDescription,
  steps,
  controlPointsTitle,
  controlPointsSubtitle,
  controlPoints = [],
  ctaTitle,
  ctaSubtitle,
  ctaLabel,
  ctaLink,
} = processEntry.data;

const pad = (n: number) => String(n).padStart(2, "0");
const stepsCount = pad(steps.length);

/*
 * ROTATING SPHERE GALLERY (hero) — images yahan se aati hain.
 * Sirf in links ko badlo (https://... ya /images/... dono chalte hain), sphere khud update ho jayega.
 */
const sphereImages = [
  "https://images.unsplash.com/photo-1627141234469-24711efb373c?auto=format&fit=crop&w=240&h=240&q=75",
  "https://images.unsplash.com/photo-1721244654392-9c912a6eb236?auto=format&fit=crop&w=240&h=240&q=75",
  "https://images.unsplash.com/photo-1765850262030-1ae93e474473?auto=format&fit=crop&w=240&h=240&q=75",
  "https://images.unsplash.com/photo-1726471809607-b7f016a1696e?auto=format&fit=crop&w=240&h=240&q=75",
  "https://images.unsplash.com/photo-1722421492323-eaf9c401befe?auto=format&fit=crop&w=240&h=240&q=75",
  "https://images.unsplash.com/photo-1706808849780-7a04fbac83ef?auto=format&fit=crop&w=240&h=240&q=75",
  "https://images.unsplash.com/photo-1706808849802-8f876ade0d1f?auto=format&fit=crop&w=240&h=240&q=75",
  "https://images.unsplash.com/photo-1503387837-b154d5074bd2?auto=format&fit=crop&w=240&h=240&q=75",
  "https://images.unsplash.com/photo-1532323544230-7191fd51bc1b?auto=format&fit=crop&w=240&h=240&q=75",
  "https://images.unsplash.com/photo-1721244654394-36a7bc2da288?auto=format&fit=crop&w=240&h=240&q=75",
  "https://images.unsplash.com/photo-1633109741715-59b57495bbdc?auto=format&fit=crop&w=240&h=240&q=75",
  "https://images.unsplash.com/photo-1634114582073-c34f96202b65?auto=format&fit=crop&w=240&h=240&q=75",
  "https://images.unsplash.com/photo-1617850687395-620757feb1f3?auto=format&fit=crop&w=240&h=240&q=75",
  "https://images.unsplash.com/photo-1721244653757-b76cc4679dfb?auto=format&fit=crop&w=240&h=240&q=75",
  "https://images.unsplash.com/photo-1678575326996-a1bf09b86158?auto=format&fit=crop&w=240&h=240&q=75",
  "https://images.unsplash.com/photo-1776279876113-514976038186?auto=format&fit=crop&w=240&h=240&q=75",
];

const SPHERE_STEP_WANT = 14; // degrees — kam karoge to balls chhoti + zyada, barhaoge to balls bari + kam
const SPHERE_ROWS = Math.round(180 / SPHERE_STEP_WANT) + 1; // -90° (bottom pole) se +90° (top pole) tak
const SPHERE_STEP = 180 / (SPHERE_ROWS - 1); // exact step taake dono poles par row aaye
const SPHERE_COLS_EQ = Math.round(360 / SPHERE_STEP); // equator par kitni balls
const SPHERE_FILL = 0.78; // 1 = balls aapas me chipki hui, kam = zyada gap
const SPHERE_TILE = ((SPHERE_STEP * Math.PI) / 180) * SPHERE_FILL; // ball size (sphere radius ka hissa)

const blobShapes = [
  "52% 48% 55% 45% / 48% 54% 46% 52%",
  "46% 54% 48% 52% / 55% 45% 55% 45%",
  "58% 42% 50% 50% / 46% 52% 48% 54%",
  "50% 50% 44% 56% / 54% 46% 54% 46%",
  "44% 56% 52% 48% / 50% 58% 42% 50%",
  "55% 45% 47% 53% / 44% 50% 50% 56%",
];

// Poora sphere: har latitude row me cos(lat) ke hisaab se balls (poles par 1 ball, equator par sab se zyada)
const sphereTiles: { yaw: number; pitch: number; src: string; shape: string; n: number }[] = [];
let tileN = 0;
for (let r = 0; r < SPHERE_ROWS; r++) {
  const lat = -90 + r * SPHERE_STEP;
  const cols = Math.max(1, Math.round(SPHERE_COLS_EQ * Math.cos((lat * Math.PI) / 180)));
  const offset = r % 2 ? 0.5 : 0; // alternate rows half-step — brick jaisa pattern
  for (let c = 0; c < cols; c++) {
    sphereTiles.push({
      yaw: (c + offset) * (360 / cols),
      pitch: lat,
      src: sphereImages[(c * 3 + r * 5) % sphereImages.length],
      shape: blobShapes[(c * 5 + r * 7) % blobShapes.length],
      n: tileN++,
    });
  }
}

/* Hero title: pehla aadha white, doosra aadha muted (Industries / Work jaisa) */
const heroWords = heroSubtitle.trim().split(/\s+/);
const mutedFrom = Math.ceil(heroWords.length / 2);

/* Text ko do hisson mein todta hai: pehla white, doosra muted */
const splitHalf = (text: string = "") => {
  const w = text.trim().split(/\s+/);
  const m = Math.ceil(w.length / 2);
  return [w.slice(0, m).join(" "), w.slice(m).join(" ")];
};

const [ctrlA, ctrlB] = splitHalf(controlPointsSubtitle);
const [ctaA, ctaB] = splitHalf(ctaSubtitle);

/* Step icons (6 alag icons, steps zyada hon to dobara shuru) */
const svg = (p: string) =>
  `<svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${p}</svg>`;
const stepIcons = [
  svg('<path d="M14 3H7a2 2 0 00-2 2v14a2 2 0 002 2h10a2 2 0 002-2V8z"/><path d="M14 3v5h5"/>'),
  svg('<circle cx="12" cy="12" r="3.2"/><path d="M12 3v2.5M12 18.5V21M3 12h2.5M18.5 12H21M5.6 5.6l1.8 1.8M16.6 16.6l1.8 1.8M18.4 5.6l-1.8 1.8M7.4 16.6l-1.8 1.8"/>'),
  svg('<path d="M12 3l9 5-9 5-9-5z"/><path d="M3 13l9 5 9-5"/>'),
  svg('<path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7S2 12 2 12z"/><circle cx="12" cy="12" r="3"/>'),
  svg('<circle cx="12" cy="12" r="9"/><path d="M8 12.5l3 3 5-6"/>'),
  svg('<path d="M12 3l8 4.5v9L12 21l-8-4.5v-9z"/><path d="M4 7.5l8 4.5 8-4.5M12 12v9"/>'),
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={heroDescription} />
    <title>{heroSubtitle} — Axys3D</title>
    <script is:inline>
      document.documentElement.classList.add("js");
    </script>
  </head>

  <body class="page-process">
    <!-- PAGE BACKGROUND — soft gradient with a drifting corner glow -->
    <div class="prc-page-bg" aria-hidden="true"></div>

    <Navbar variant="solid" />

    <main class="process-page">
      <!-- ================= HERO ================= -->
      <section class="prc-intro">
        <div class="prc-wrap">
          <div class="prc-intro-row">
            <div class="prc-intro-header">
              <span class="prc-kicker">{heroTitle}</span>
              <h1 class="prc-h1">
                <span class="prc-h1-visual" aria-hidden="true">
                  {heroWords.map((w, i) => (
                    <Fragment>
                      <span
                        class:list={["prc-word", { "prc-word--muted": i >= mutedFrom }]}
                        style={`--i:${i}`}
                      >{w}</span>
                      {i === mutedFrom - 1 && <br />}
                    </Fragment>
                  ))}
                </span>
                <span class="sr-only">{heroSubtitle}</span>
              </h1>
              <p class="prc-lead">{heroDescription}</p>
            </div>

            <div class="prc-intro-media">
              <div
                class="prc-sphere-stage"
                data-sphere
                data-tile={SPHERE_TILE}
                role="img"
                aria-label="Interactive rotating gallery of Axys3D project visuals. Drag to rotate."
              >
                <div class="prc-sphere">
                  {sphereTiles.map((t) => (
                    <span
                      class="prc-tile"
                      style={`--yaw:${t.yaw}deg;--pitch:${t.pitch}deg;--n:${t.n};border-radius:${t.shape}`}
                    >
                      <img
                        src={t.src}
                        alt=""
                        loading="eager"
                        decoding="async"
                        draggable="false"
                      />
                    </span>
                  ))}
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- ================= WORKFLOW (3 + 3 STEP CARDS) ================= -->
      <section class="prc-steps-sec" data-steps>
        <div class="prc-wrap">
          <div class="prc-sec-head prc-sec-head--row" data-reveal>
            <div>
              <span class="prc-kicker">THE WORKFLOW</span>
              <h2 class="prc-sec-h2">A Structured <br /><span>Delivery Process</span></h2>
            </div>
            <!-- <span class="prc-count">{stepsCount} STEPS</span> -->
          </div>

          <div class="prc-steps-grid">
            {steps.map((step, i) => (
              <article
                class="prc-step"
                data-step-card
                data-reveal
                style={`--d: ${(i % 3) * 120}ms`}
              >
                <div class="prc-step-top">
                  <span class="prc-step-num">{step.id}</span>
                  <span class="prc-step-of">{pad(i + 1)} / {stepsCount}</span>
                </div>
                <span class="prc-step-icon" set:html={stepIcons[i % stepIcons.length]} />
                <h3 class="prc-step-title">{step.title}</h3>
                <p class="prc-step-desc">{step.description}</p>
                <div class="prc-step-bar"><i></i></div>

                {i % 3 !== 2 && i < steps.length - 1 && (
                  <span class="prc-step-link" aria-hidden="true">
                    <span class="prc-step-dot">
                      <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
                    </span>
                  </span>
                )}
              </article>
            ))}
          </div>
        </div>
      </section>

      <!-- ================= CONTROL POINTS (ONE ROW) ================= -->
      {controlPoints.length > 0 && (
        <section class="prc-controls-sec">
          <div class="prc-wrap">
            <div class="prc-sec-head" data-reveal>
              {controlPointsTitle && <span class="prc-kicker">{controlPointsTitle}</span>}
              {controlPointsSubtitle && (
                <h2 class="prc-sec-h2">{ctrlA} <br /><span>{ctrlB}</span></h2>
              )}
            </div>

            <ul class="prc-controls-row" style={`--n: ${controlPoints.length}`}>
              {controlPoints.map((point, i) => (
                <li class="prc-control" data-reveal style={`--d: ${i * 90}ms`}>
                  <span class="prc-check">
                    <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg>
                  </span>
                  <span>{point}</span>
                </li>
              ))}
            </ul>
          </div>
        </section>
      )}

      <!-- ================= FINAL CTA ================= -->
      {ctaSubtitle && (
        <section class="prc-final-cta">
          <div class="prc-wrap">
            <div class="prc-final-inner" data-reveal>
              {ctaTitle && <span class="prc-kicker">{ctaTitle}</span>}
              <h2>{ctaA} <br /><span>{ctaB}</span></h2>
              {ctaLabel && (
                <a href={ctaLink || "/contact"} class="prc-final-button">
                  <span>{ctaLabel}</span>
                  <span>↗</span>
                </a>
              )}
            </div>
          </div>
        </section>
      )}
    </main>

    <Footer />

    <script is:inline>
      const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

      // Reveal on scroll
      const revealItems = document.querySelectorAll("[data-reveal]");
      const revealObserver = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add("is-visible");
              revealObserver.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.12 }
      );
      revealItems.forEach((item) => revealObserver.observe(item));

      // Workflow: cards light up one after another (loop). Hover = jump to that card.
      const section = document.querySelector("[data-steps]");
      const cards = Array.from(document.querySelectorAll("[data-step-card]"));

      if (section && cards.length && !reduceMotion) {
        const STEP_MS = 2800;
        let idx = -1;
        let timer = null;
        let hovering = false;

        const paint = (active) => {
          cards.forEach((c, i) => {
            c.classList.toggle("is-active", i === active);
            c.classList.toggle("is-done", active >= 0 && i < active);
          });
        };

        const tick = () => {
          if (hovering) return;
          idx = idx + 1 >= cards.length ? -1 : idx + 1;
          // short pause with everything reset before the loop restarts
          paint(idx);
        };

        const start = () => {
          if (timer) return;
          tick();
          timer = setInterval(tick, STEP_MS);
        };

        const stop = () => {
          clearInterval(timer);
          timer = null;
        };

        cards.forEach((card, i) => {
          card.addEventListener("pointerenter", () => {
            hovering = true;
            idx = i;
            paint(i);
          });
          card.addEventListener("pointerleave", () => {
            hovering = false;
          });
        });

        new IntersectionObserver(
          (entries) => {
            entries[0].isIntersecting ? start() : stop();
          },
          { threshold: 0.25 }
        ).observe(section);
      }

      /* ===== Sphere gallery (hero): auto-rotate + drag + mouse-follow ===== */
      (() => {
        const stage = document.querySelector("[data-sphere]");
        if (!stage) return;
        const sphere = stage.querySelector(".prc-sphere");
        const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

        const TILE = Number(stage.dataset.tile) || 0.2;
        let R = 300;
        const layout = () => {
          const W = stage.clientWidth;
          const H = stage.clientHeight;
          if (!W || !H) return;
          R = Math.min(W, H) * 0.49; // poora sphere (top + bottom) box ke andar fit
          const tile = R * TILE;
          stage.style.perspective = `${R * 3}px`;
          stage.style.setProperty("--R", `${R}px`);
          stage.style.setProperty("--tw", `${tile}px`);
          stage.style.setProperty("--tht", `${tile}px`);
        };
        layout();
        new ResizeObserver(layout).observe(stage);

        const BASE_PITCH = -8;
        const MAX_PITCH = 80; // drag karke poles tak dekh sakte ho
        const AUTO_SPEED = reduce ? 0 : 0.07; // degrees per frame
        let yaw = 0, pitch = BASE_PITCH, vYaw = 0, vPitch = 0;
        let dragging = false, inside = false;
        let lastX = 0, lastY = 0, hoverX = 0, hoverY = 0;
        let running = true, last = performance.now();
        const clamp = (v, a, b) => Math.max(a, Math.min(b, v));

        const render = () => {
          sphere.style.transform = `translateZ(${-R}px) rotateX(${pitch}deg) rotateY(${yaw}deg)`;
        };

        const frame = (now) => {
          const dt = Math.min((now - last) / 16.667, 3);
          last = now;
          if (running && !dragging) {
            const hoverSpin = inside && !reduce ? hoverX * 0.16 : 0;
            yaw = (yaw + (vYaw + AUTO_SPEED + hoverSpin) * dt) % 360;
            pitch += vPitch * dt;
            const target = BASE_PITCH + (inside && !reduce ? hoverY * 8 : 0);
            pitch += (target - pitch) * 0.035 * dt;
            pitch = clamp(pitch, -MAX_PITCH, MAX_PITCH);
            const decay = Math.pow(0.95, dt);
            vYaw *= decay;
            vPitch *= decay;
          }
          if (running) render();
          requestAnimationFrame(frame);
        };

        stage.addEventListener("pointerdown", (e) => {
          dragging = true;
          lastX = e.clientX;
          lastY = e.clientY;
          vYaw = 0;
          vPitch = 0;
          stage.classList.add("is-dragging");
          stage.setPointerCapture(e.pointerId);
        });

        stage.addEventListener("pointermove", (e) => {
          const r = stage.getBoundingClientRect();
          hoverX = ((e.clientX - r.left) / r.width - 0.5) * 2;
          hoverY = ((e.clientY - r.top) / r.height - 0.5) * 2;
          inside = true;
          if (!dragging) return;
          const dx = e.clientX - lastX;
          const dy = e.clientY - lastY;
          lastX = e.clientX;
          lastY = e.clientY;
          yaw += dx * 0.3;
          pitch = clamp(pitch - dy * 0.2, -MAX_PITCH, MAX_PITCH);
          vYaw = clamp(dx * 0.3, -8, 8);
          vPitch = clamp(-dy * 0.2, -5, 5);
        });

        const endDrag = () => {
          dragging = false;
          stage.classList.remove("is-dragging");
        };
        stage.addEventListener("pointerup", endDrag);
        stage.addEventListener("pointercancel", endDrag);
        stage.addEventListener("pointerleave", () => { inside = false; });

        // screen se bahar ho to animation rok do
        new IntersectionObserver(([entry]) => {
          running = entry.isIntersecting;
          last = performance.now();
        }).observe(stage);

        render();
        requestAnimationFrame(frame);
      })();
    </script>
  </body>
</html>