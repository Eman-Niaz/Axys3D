---
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import "../styles/token.css";
import "../styles/global.css";
import "../styles/Navbar.css";
import "../styles/Services.css";
import "../styles/footer.css";

const services = [
  {
    num: "01",
    title: "BIM Execution & Model Production",
    blurb:
      "Coordinated BIM models built to firm standards, from concept development through construction-ready detail.",
    videos: [
      { src: "/videos/BIM-Modeling.mp4", label: "BIM Modeling" },
      { src: "/videos/ModelDevelopement.mp4", label: "Model Development" },
      { src: "/videos/BIM-Model-Setup-Standards.mp4", label: "Model Setup & Standards" },
    ],
  },
  {
    num: "02",
    title: "Revit Production & Documentation",
    blurb:
      "Production-ready Revit documentation and drawing sets, coordinated across disciplines and issued on schedule.",
    videos: [
      { src: "/videos/Construction-drawing.mp4", label: "Construction Drawings" },
      { src: "/videos/revit-documentation.mp4", label: "Revit Documentation" },
      { src: "/videos/drawing-coordination.mp4", label: "Drawing Coordination" },
    ],
  },
  {
    num: "03",
    title: "MEP Coordination Support",
    blurb:
      "Clash-checked mechanical, electrical and plumbing coordination that keeps every system resolved before it hits site.",
    videos: [
      { src: "/videos/mechanical_coordination.mp4", label: "Mechanical" },
      { src: "/videos/electrical_coordination.mp4", label: "Electrical" },
      { src: "/videos/plumbing_coordination.mp4", label: "Plumbing" },
    ],
  },
  {
    num: "04",
    title: "3D Modeling",
    blurb:
      "Accurate architectural, interior and object models built to support every downstream visualization need.",
    videos: [
      { src: "/videos/Architectural.mp4", label: "Architectural Modeling" },
      { src: "/videos/interior.mp4", label: "Interior Modeling" },
      { src: "/videos/furniture.mp4", label: "Furniture & Objects" },
    ],
  },
  {
    num: "05",
    title: "3ds Max Production",
    blurb: "Scene setup, materials and lighting built in 3ds Max to a consistent, production-grade pipeline.",
    videos: [
      { src: "/videos/scene.mp4", label: "Scene Setup" },
      { src: "/videos/texture-material.mp4", label: "Materials & Texturing" },
      { src: "/videos/lightening.mp4", label: "Lighting & Camera" },
    ],
  },
  {
    num: "06",
    title: "Architectural Visualization",
    blurb: "Exterior, interior and site visualizations that read as photography long before the building exists.",
    videos: [
      { src: "/videos/Exterior.mp4", label: "Exterior Visualization" },
      { src: "/videos/interior_visualization.mp4", label: "Interior Visualization" },
      { src: "/videos/site-visualization.mp4", label: "Site Visualization" },
    ],
  },
  {
    num: "07",
    title: "Animation & Motion",
    blurb: "Walkthroughs, fly-throughs and camera sequences that move a project through space with intent.",
    videos: [
      { src: "/videos/walkthrough.mp4", label: "Walkthroughs" },
      { src: "/videos/Fly-through.mp4", label: "Fly-through Animations" },
      { src: "/videos/Camera-Motion.mp4", label: "Camera & Motion" },
    ],
  },
  {
    num: "08",
    title: "Real-time / Unreal Engine",
    blurb:
      "Real-time environments in Unreal Engine — interactive walkthroughs and virtual showrooms your clients can explore.",
    videos: [
      { src: "/videos/3D-Walkthroughs.mp4", label: "Interactive Walkthroughs" },
      { src: "/videos/Architectural_visualization.mp4", label: "Real-time Visualization" },
      { src: "/videos/Virtual_showroom.mp4", label: "Virtual Showrooms" },
    ],
  },
];

// ⬇⬇ SIRF YAHAN IMAGE LINKS BADLO (https://... ya /images/... dono chalte hain) ⬇⬇
const orbitImages = {
  bim: "https://images.unsplash.com/photo-1627141234469-24711efb373c?auto=format&fit=crop&w=400&h=400&q=75",
  revit: "https://images.unsplash.com/photo-1721244654392-9c912a6eb236?auto=format&fit=crop&w=400&h=400&q=75",
  mep: "https://images.unsplash.com/photo-1765850262030-1ae93e474473?auto=format&fit=crop&w=400&h=400&q=75",
  max3ds: "https://images.unsplash.com/photo-1726471809607-b7f016a1696e?auto=format&fit=crop&w=400&h=400&q=75",
  motion: "https://images.unsplash.com/photo-1722421492323-eaf9c401befe?auto=format&fit=crop&w=400&h=400&q=75",
  unreal: "https://images.unsplash.com/photo-1706808849780-7a04fbac83ef?auto=format&fit=crop&w=400&h=400&q=75",
  visualization: "https://images.unsplash.com/photo-1706808849802-8f876ade0d1f?auto=format&fit=crop&w=400&h=400&q=75",
  model3d: "https://images.unsplash.com/photo-1503387837-b154d5074bd2?auto=format&fit=crop&w=400&h=400&q=75",
};

// ⬇⬇ OUTER CIRCLE KI IMAGES (sirf links, 8 images = andar wale jitni) ⬇⬇
const orbitOuterImages = [
  "https://images.unsplash.com/photo-1532323544230-7191fd51bc1b?auto=format&fit=crop&w=300&h=300&q=75",
  "https://images.unsplash.com/photo-1721244654394-36a7bc2da288?auto=format&fit=crop&w=300&h=300&q=75",
  "https://images.unsplash.com/photo-1633109741715-59b57495bbdc?auto=format&fit=crop&w=300&h=300&q=75",
  "https://images.unsplash.com/photo-1634114582073-c34f96202b65?auto=format&fit=crop&w=300&h=300&q=75",
  "https://images.unsplash.com/photo-1617850687395-620757feb1f3?auto=format&fit=crop&w=300&h=300&q=75",
  "https://images.unsplash.com/photo-1721244653757-b76cc4679dfb?auto=format&fit=crop&w=300&h=300&q=75",
  "https://images.unsplash.com/photo-1678575326996-a1bf09b86158?auto=format&fit=crop&w=300&h=300&q=75",
  "https://images.unsplash.com/photo-1776279876113-514976038186?auto=format&fit=crop&w=300&h=300&q=75",
];

/*
 * ROTATING SPHERE GALLERY (hero) — images upar wali orbitImages + orbitOuterImages se aati hain.
 * Sirf un links ko badlo, sphere khud update ho jayega.
 */
const sphereSource = [...Object.values(orbitImages), ...orbitOuterImages].map((u) =>
  u.replace(/w=\d+&h=\d+/, "w=240&h=240")
);

const SPHERE_STEP_WANT = 14; // degrees — kam karoge to balls chhoti + zyada, barhaoge to balls bari + kam
const SPHERE_ROWS = Math.round(180 / SPHERE_STEP_WANT) + 1; // -90° (bottom pole) se +90° (top pole) tak
const SPHERE_STEP = 180 / (SPHERE_ROWS - 1); // exact step taake dono poles par row aaye
const SPHERE_COLS_EQ = Math.round(360 / SPHERE_STEP); // equator par kitni balls
const SPHERE_FILL = 0.78; // 1 = balls aapas me chipki hui, kam = zyada gap
const SPHERE_TILE = ((SPHERE_STEP * Math.PI) / 180) * SPHERE_FILL; // ball size (sphere radius ka hissa)

const blobShapes = [
  "52% 48% 55% 45% / 48% 54% 46% 52%",
  "46% 54% 48% 52% / 55% 45% 55% 45%",
  "58% 42% 50% 50% / 46% 52% 48% 54%",
  "50% 50% 44% 56% / 54% 46% 54% 46%",
  "44% 56% 52% 48% / 50% 58% 42% 50%",
  "55% 45% 47% 53% / 44% 50% 50% 56%",
];

// Poora sphere: har latitude row me cos(lat) ke hisaab se balls (poles par 1 ball, equator par sab se zyada)
const sphereTiles: { yaw: number; pitch: number; src: string; shape: string; n: number }[] = [];
let tileN = 0;
for (let r = 0; r < SPHERE_ROWS; r++) {
  const lat = -90 + r * SPHERE_STEP;
  const cols = Math.max(1, Math.round(SPHERE_COLS_EQ * Math.cos((lat * Math.PI) / 180)));
  const offset = r % 2 ? 0.5 : 0; // alternate rows half-step — brick jaisa pattern
  for (let c = 0; c < cols; c++) {
    sphereTiles.push({
      yaw: (c + offset) * (360 / cols),
      pitch: lat,
      src: sphereSource[(c * 3 + r * 5) % sphereSource.length],
      shape: blobShapes[(c * 5 + r * 7) % blobShapes.length],
      n: tileN++,
    });
  }
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Services</title>
    <script is:inline>
      document.documentElement.classList.add("js");
    </script>
  </head>

  <body class="page-services">
    <!-- PAGE BACKGROUND — soft gradient with a drifting corner glow -->
    <div class="svc-page-bg" aria-hidden="true"></div>

    <Navbar variant="solid" />

    <main class="services-page">
      <!-- ================= HERO ================= -->
      <section class="svc-intro">
        <div class="svc-wrap">
          <div class="svc-intro-row">
            <div class="svc-intro-header">
              <span class="svc-kicker">Services</span>
              <h1 class="svc-h1">
                <span class="svc-h1-visual" aria-hidden="true">
                  <span class="svc-word" style="--i:0">AEC</span>
                  <span class="svc-word" style="--i:1">production</span>
                  <br />
                  <span class="svc-word svc-word--muted" style="--i:2">without</span>
                  <span class="svc-word svc-word--muted" style="--i:3">the</span>
                  <span class="svc-word svc-word--muted" style="--i:4">friction.</span>
                </span>
                <span class="sr-only">AEC production without the friction.</span>
              </h1>
              <p class="svc-lead">
                Axys3D provides integrated AEC production support across BIM, Revit, coordination,
                visualization, animation and real-time workflows.
              </p>
            </div>

            <div class="svc-intro-media">
              <div
                class="svc-sphere-stage"
                data-sphere
                data-tile={SPHERE_TILE}
                role="img"
                aria-label="Interactive rotating gallery of Axys3D service visuals. Drag to rotate."
              >
                <div class="svc-sphere">
                  {sphereTiles.map((t) => (
                    <span
                      class="svc-tile"
                      style={`--yaw:${t.yaw}deg;--pitch:${t.pitch}deg;--n:${t.n};border-radius:${t.shape}`}
                    >
                      <img
                        src={t.src}
                        alt=""
                        loading="eager"
                        decoding="async"
                        draggable="false"
                      />
                    </span>
                  ))}
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- ================= SERVICE REEL (full-bleed panels) ================= -->
      <section class="svc-reel">
        {services.map((s) => (
          <article class="svc-panel" data-reveal data-service>
            <div class="svc-panel-media">
              {s.videos.map((v, i) => (
                <video
                  class={`svc-panel-video${i === 0 ? " is-active" : ""}`}
                  src={v.src}
                  autoplay
                  muted
                  playsinline
                  preload="metadata"
                  onerror="this.closest('.svc-panel-media').classList.add('svc-media-fallback')"
                ></video>
              ))}
              <div class="svc-panel-overlay"></div>
            </div>

            <div class="svc-panel-content">
              <div class="svc-panel-text">
                <span class="svc-panel-num">{s.num}</span>
                <h2 class="svc-panel-title">{s.title}</h2>
                <p class="svc-panel-blurb">{s.blurb}</p>
                <div class="svc-panel-tabs" role="tablist">
                  {s.videos.map((v, i) => (
                    <button
                      type="button"
                      class={`svc-tab${i === 0 ? " is-active" : ""}`}
                      data-tab-index={i}
                      role="tab"
                      aria-selected={i === 0 ? "true" : "false"}
                    >
                      {v.label}
                    </button>
                  ))}
                </div>
              </div>

              <a href="/contact" class="svc-panel-cta">
                <span>Discuss this scope</span>
                <span>↗</span>
              </a>
            </div>
          </article>
        ))}
      </section>

      <!-- ================= FINAL CTA ================= -->
      <section class="svc-final-cta">
        <div class="svc-wrap">
          <div class="svc-final-inner" data-reveal>
            <h2>Bring us the <br /><span>production problem.</span></h2>
            <p>Tell us where the project stands and what needs to move next. We'll help define the right production package.</p>
            <a href="/contact" class="final-cta-button">
              <span>Discuss a production package</span>
              <span>↗</span>
            </a>
          </div>
        </div>
      </section>
    </main>

    <Footer />

    <script is:inline>
      // Reveal on scroll
      const revealItems = document.querySelectorAll("[data-reveal]");
      const revealObserver = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add("is-visible");
              revealObserver.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.12 }
      );
      revealItems.forEach((item) => revealObserver.observe(item));

      // Tab-driven video switching within each service panel, with
      // auto-advance to the next sub-service once a video finishes.
      document.querySelectorAll("[data-service]").forEach((panel) => {
        const videos = Array.from(panel.querySelectorAll(".svc-panel-video"));
        const tabs = Array.from(panel.querySelectorAll(".svc-tab"));
        let current = 0;

        const showIndex = (i) => {
          current = i;
          videos.forEach((v, vi) => {
            if (vi === i) {
              v.classList.add("is-active");
              v.currentTime = 0;
              v.play?.().catch(() => {});
            } else {
              v.classList.remove("is-active");
              v.pause();
            }
          });
          tabs.forEach((t, ti) => {
            t.classList.toggle("is-active", ti === i);
            t.setAttribute("aria-selected", ti === i ? "true" : "false");
          });
        };

        videos.forEach((v, i) => {
          if (i !== 0) v.pause();
          v.addEventListener("ended", () => showIndex((current + 1) % videos.length));
        });

        tabs.forEach((tab, i) => {
          tab.addEventListener("click", () => showIndex(i));
        });
      });

      /* ===== Sphere gallery (hero): auto-rotate + drag + mouse-follow ===== */
      (() => {
        const stage = document.querySelector("[data-sphere]");
        if (!stage) return;
        const sphere = stage.querySelector(".svc-sphere");
        const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

        const TILE = Number(stage.dataset.tile) || 0.2;
        let R = 300;
        const layout = () => {
          const W = stage.clientWidth;
          const H = stage.clientHeight;
          if (!W || !H) return;
          R = Math.min(W, H) * 0.49; // poora sphere (top + bottom) box ke andar fit
          const tile = R * TILE;
          stage.style.perspective = `${R * 3}px`;
          stage.style.setProperty("--R", `${R}px`);
          stage.style.setProperty("--tw", `${tile}px`);
          stage.style.setProperty("--tht", `${tile}px`);
        };
        layout();
        new ResizeObserver(layout).observe(stage);

        const BASE_PITCH = -8;
        const MAX_PITCH = 80; // drag karke poles tak dekh sakte ho
        const AUTO_SPEED = reduce ? 0 : 0.07; // degrees per frame
        let yaw = 0, pitch = BASE_PITCH, vYaw = 0, vPitch = 0;
        let dragging = false, inside = false;
        let lastX = 0, lastY = 0, hoverX = 0, hoverY = 0;
        let running = true, last = performance.now();
        const clamp = (v, a, b) => Math.max(a, Math.min(b, v));

        const render = () => {
          sphere.style.transform = `translateZ(${-R}px) rotateX(${pitch}deg) rotateY(${yaw}deg)`;
        };

        const frame = (now) => {
          const dt = Math.min((now - last) / 16.667, 3);
          last = now;
          if (running && !dragging) {
            const hoverSpin = inside && !reduce ? hoverX * 0.16 : 0;
            yaw = (yaw + (vYaw + AUTO_SPEED + hoverSpin) * dt) % 360;
            pitch += vPitch * dt;
            const target = BASE_PITCH + (inside && !reduce ? hoverY * 8 : 0);
            pitch += (target - pitch) * 0.035 * dt;
            pitch = clamp(pitch, -MAX_PITCH, MAX_PITCH);
            const decay = Math.pow(0.95, dt);
            vYaw *= decay;
            vPitch *= decay;
          }
          if (running) render();
          requestAnimationFrame(frame);
        };

        stage.addEventListener("pointerdown", (e) => {
          dragging = true;
          lastX = e.clientX;
          lastY = e.clientY;
          vYaw = 0;
          vPitch = 0;
          stage.classList.add("is-dragging");
          stage.setPointerCapture(e.pointerId);
        });

        stage.addEventListener("pointermove", (e) => {
          const r = stage.getBoundingClientRect();
          hoverX = ((e.clientX - r.left) / r.width - 0.5) * 2;
          hoverY = ((e.clientY - r.top) / r.height - 0.5) * 2;
          inside = true;
          if (!dragging) return;
          const dx = e.clientX - lastX;
          const dy = e.clientY - lastY;
          lastX = e.clientX;
          lastY = e.clientY;
          yaw += dx * 0.3;
          pitch = clamp(pitch - dy * 0.2, -MAX_PITCH, MAX_PITCH);
          vYaw = clamp(dx * 0.3, -8, 8);
          vPitch = clamp(-dy * 0.2, -5, 5);
        });

        const endDrag = () => {
          dragging = false;
          stage.classList.remove("is-dragging");
        };
        stage.addEventListener("pointerup", endDrag);
        stage.addEventListener("pointercancel", endDrag);
        stage.addEventListener("pointerleave", () => { inside = false; });

        // screen se bahar ho to animation rok do
        new IntersectionObserver(([entry]) => {
          running = entry.isIntersecting;
          last = performance.now();
        }).observe(stage);

        render();
        requestAnimationFrame(frame);
      })();
    </script>
  </body>
</html>