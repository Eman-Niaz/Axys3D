<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Visual Asset Library — Axys3D</title>
  </head>

  <body class="page-visual-library">
    <!-- BACKGROUND LAYER -->
    <div class="lib-page-bg"><div class="lib-page-bg-overlay"></div></div>

    <!-- Navbar Moved Outside Section Container -->
    <Navbar variant="solid" />

    <main class="library-page">
      <section class="library-section" id="visual-library">
        <div class="library-container">

          <!-- Section Header -->
          <div class="library-header">
            <div>
              <span class="library-eyebrow">Visual Asset Library</span>
              <h2>Explore production assets & renders.</h2>
            </div>
            <p class="library-desc">
              A curated archive of photorealistic visual sets, BIM coordination models, and interactive real-time environments.
            </p>
          </div>

          <!-- Filter Buttons -->
          <div class="library-filters">
            {libraryCategories.map((cat, idx) => (
              <button
                class={`filter-btn ${idx === 0 ? "active" : ""}`}
                data-category={cat}
              >
                {cat}
              </button>
            ))}
          </div>

          <!-- Masonry Grid Asset Gallery -->
          <div class="library-grid" id="libraryGrid">
            {assets.map((item) => (
              <div class={`gallery-item ${item.ratio}`} data-category={item.category}>
                <div class="gallery-card">
                  <img src={item.image} alt={item.title} loading="lazy" />
                  <div class="gallery-overlay">
                    <span class="asset-tag">{item.tag}</span>
                    <h3 class="asset-title">{item.title}</h3>
                    <button class="view-btn" data-img={item.image} data-title={item.title}>
                      View Asset <span>↗</span>
                    </button>
                  </div>
                </div>
              </div>
            ))}
          </div>

        </div>

        <!-- Lightbox Modal -->
        <div class="lightbox" id="lightboxModal">
          <span class="lightbox-close">&times;</span>
          <div class="lightbox-content">
            <img id="lightboxImg" src="" alt="Expanded View" />
            <div id="lightboxCaption" class="lightbox-caption"></div>
          </div>
        </div>
      </section>
    </main>

    <!-- Footer Outside Main Section -->
    <Footer />

    <script>
      // Scroll-reveal for gallery items, matching Work/Process pages
      const revealTargets = document.querySelectorAll(".gallery-item");

      revealTargets.forEach((el, i) => {
        (el as HTMLElement).style.setProperty("--lib-delay", `${(i % 6) * 0.08}s`);
      });

      const revealObserver = new IntersectionObserver(
        (entries, observer) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add("lib-reveal-visible");
              observer.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.1, rootMargin: "0px 0px -40px 0px" }
      );

      revealTargets.forEach((el) => revealObserver.observe(el));

      // Filter Functionality
      const filterBtns = document.querySelectorAll('.filter-btn');
      const items = document.querySelectorAll('.gallery-item');

      function applyFilter(selectedCategory: string) {
        filterBtns.forEach(b => b.classList.remove('active'));

        const matchedBtn = Array.from(filterBtns).find(
          (b) => b.getAttribute('data-category') === selectedCategory
        );
        (matchedBtn || filterBtns[0])?.classList.add('active');

        items.forEach(item => {
          const itemCategory = item.getAttribute('data-category');
          if (selectedCategory === 'All' || itemCategory === selectedCategory) {
            (item as HTMLElement).style.display = 'block';
          } else {
            (item as HTMLElement).style.display = 'none';
          }
        });
      }

      filterBtns.forEach(btn => {
        btn.addEventListener('click', () => {
          const selectedCategory = btn.getAttribute('data-category') || 'All';
          applyFilter(selectedCategory);
        });
      });

      // Auto-select category from the URL (e.g. coming from a Services card click)
      const urlParams = new URLSearchParams(window.location.search);
      const categoryFromUrl = urlParams.get('category');

      if (categoryFromUrl) {
        applyFilter(categoryFromUrl);

        document.getElementById('visual-library')?.scrollIntoView({
          behavior: 'smooth',
          block: 'start',
        });
      }

      // Lightbox Modal Functionality
      const lightbox = document.getElementById('lightboxModal');
      const lightboxImg = document.getElementById('lightboxImg') as HTMLImageElement;
      const lightboxCaption = document.getElementById('lightboxCaption');
      const viewBtns = document.querySelectorAll('.view-btn');
      const closeBtn = document.querySelector('.lightbox-close');

      viewBtns.forEach(btn => {
        btn.addEventListener('click', (e) => {
          e.stopPropagation();
          const imgUrl = btn.getAttribute('data-img');
          const title = btn.getAttribute('data-title');

          if(lightboxImg && lightboxCaption && lightbox) {
            lightboxImg.src = imgUrl || '';
            lightboxCaption.textContent = title || '';
            lightbox.classList.add('show');
          }
        });
      });

      closeBtn?.addEventListener('click', () => {
        lightbox?.classList.remove('show');
      });

      lightbox?.addEventListener('click', (e) => {
        if (e.target === lightbox) {
          lightbox.classList.remove('show');
        }
      });
    </script>
  </body>
</html>