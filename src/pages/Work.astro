---
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import "../styles/token.css";
import "../styles/global.css";
import "../styles/Navbar.css";
import "../styles/work.css";
import "../styles/footer.css";
import { getEntry, getCollection } from "astro:content";

const workPageEntry = await getEntry("workPage", "index");

if (!workPageEntry) {
  throw new Error("Could not find index.md in src/content/workPage/");
}

const pageData = workPageEntry.data;

const rawProjects = await getCollection("projects");

const projects = rawProjects.map((item, index) => ({
  id: item.id,
  ...item.data,
  video: `/videos/video${(index % 3) + 1}.mp4`,
}));

const heroPoster =
  "https://images.unsplash.com/photo-1600607687920-4e2a09cf159d?auto=format&fit=crop&w=1600&q=85";

/* Hero title: pehla aadha white, doosra aadha muted (Industries jaisa) */
const heroWords = pageData.heroSubtitle.trim().split(/\s+/);
const mutedFrom = Math.ceil(heroWords.length / 2);

const pad = (n: number) => String(n).padStart(2, "0");
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={pageData.heroDescription} />
    <title>{pageData.heroTitle}</title>
    <script is:inline>
      document.documentElement.classList.add("js");
    </script>
  </head>

  <body class="page-work">
    <!-- PAGE BACKGROUND — soft gradient with a drifting corner glow -->
    <div class="wrk-page-bg" aria-hidden="true"></div>

    <Navbar variant="solid" />

    <main class="work-page">
      <!-- ================= HERO ================= -->
      <section class="wrk-intro">
        <div class="wrk-wrap">
          <div class="wrk-intro-row">
            <div class="wrk-intro-header">
              <span class="wrk-kicker">{pageData.heroTitle}</span>
              <h1 class="wrk-h1">
                <span class="wrk-h1-visual" aria-hidden="true">
                  {heroWords.map((w, i) => (
                    <Fragment>
                      <span
                        class:list={["wrk-word", { "wrk-word--muted": i >= mutedFrom }]}
                        style={`--i:${i}`}
                      >{w}</span>
                      {i === mutedFrom - 1 && <br />}
                    </Fragment>
                  ))}
                </span>
                <span class="sr-only">{pageData.heroSubtitle}</span>
              </h1>
              <p class="wrk-lead">{pageData.heroDescription}</p>
            </div>

            <div class="wrk-intro-media">
              <video
                class="wrk-hero-video"
                src="/videos/service-hero.mp4"
                poster={heroPoster}
                autoplay
                muted
                loop
                playsinline
                preload="metadata"
              ></video>
            </div>
          </div>
        </div>
      </section>

      <!-- ================= CASE STUDIES (2 x 2 CARDS) ================= -->
      <section class="wrk-cards-sec" id="case-studies">
        <div class="wrk-wrap">
          <div class="wrk-sec-head wrk-sec-head--row" data-reveal>
            <div>
              <span class="wrk-kicker">CASE STUDIES</span>
              <h2 class="wrk-sec-h2">A closer look at <br /><span>our selected work.</span></h2>
            </div>
            <!-- <span class="wrk-count">{pad(projects.length)} PROJECTS</span> -->
          </div>

          <div class="wrk-cards-grid">
            {projects.map((project, index) => (
              <a
                class="wrk-card"
                href={`/work/${project.id}`}
                data-reveal
                style={`--d: ${(index % 2) * 120}ms`}
                aria-label={`View ${project.title} case study`}
              >
                <video
                  src={project.video}
                  autoplay
                  muted
                  loop
                  playsinline
                  preload="metadata"
                ></video>
                <div class="wrk-card-overlay"></div>
                <div class="wrk-card-shine"></div>

                <div class="wrk-card-body">
                  <span class="wrk-card-num">{pad(index + 1)}</span>
                  <span class="wrk-card-target">{project.badgeText}</span>
                  <h3 class="wrk-card-title">{project.title}</h3>
                  <p class="wrk-card-desc">{project.summary}</p>
                  <span class="wrk-card-arrow" aria-hidden="true">
                    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
                  </span>
                </div>
              </a>
            ))}
          </div>

          {projects.length === 0 && (
            <div class="wrk-no-results">
              <p>No case studies available yet.</p>
            </div>
          )}
        </div>
      </section>

      <!-- ================= FINAL CTA ================= -->
      <section class="wrk-final-cta">
        <div class="wrk-wrap">
          <div class="wrk-final-inner" data-reveal>
            <h2>Let's turn your project <br /><span>into something visual.</span></h2>
            <p>Tell us what you're building and we'll help you define the right visual production approach.</p>
            <a href="/contact" class="wrk-final-button">
              <span>Discuss a project</span>
              <span>↗</span>
            </a>
          </div>
        </div>
      </section>
    </main>

    <Footer />

    <script is:inline>
      // Reveal on scroll
      const revealItems = document.querySelectorAll("[data-reveal]");
      const revealObserver = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add("is-visible");
              revealObserver.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.12 }
      );
      revealItems.forEach((item) => revealObserver.observe(item));

      // Card spotlight: light follows the cursor
      document.querySelectorAll(".wrk-card").forEach((card) => {
        card.addEventListener("pointermove", (e) => {
          const r = card.getBoundingClientRect();
          card.style.setProperty("--mx", `${e.clientX - r.left}px`);
          card.style.setProperty("--my", `${e.clientY - r.top}px`);
        });
      });
    </script>
  </body>
</html>