---
import Hero from "../components/Hero.astro";
import "../styles/token.css";
import "../styles/global.css";
import Navbar from "../components/Navbar.astro";
import "../styles/Navbar.css";
import "../styles/Hero.css";
import ProductionLayer from "../components/ProductionLayer.astro";
import "../styles/Production-layer.css";
import VisualGallery from "../components/VisualGallery.astro";
import "../styles/Visual-Gallery.css";
import Buyersegments from "../components/Buyersegments.astro";
import "../styles/Buyer-segments.css";
import CaseStudies from "../components/casestudies.astro";
import "../styles/case-studies.css";
import ProcessSection from "../components/ProcessSection.astro";
import FAQSection from "../components/FAQSection.astro";
import CTASection from "../components/CTASection.astro";
import Footer from "../components/Footer.astro";
import Mission from "../components/Mission.astro";
import About from "../components/about.astro";
import "../styles/Mission.css";
import "../styles/process.css";
import "../styles/faq.css";
import "../styles/cta.css";
import "../styles/footer.css";
import "../styles/index.css";
import "../styles/Mission.css";
import "../styles/HomeAbout.css";
import Howitworks  from "../components/Howitworks.astro";
import "../styles/Howitworks.css";
import Marquee from "../components/Marquee.astro";
import "../styles/Marquee.css";
import Stages from "../components/Stages.astro";
import "../styles/stages.css";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />

    <meta name="viewport" content="width=device-width" />

    <meta
      name="description"
      content="Axys3D is an integrated AEC production partner delivering BIM, Revit production, MEP coordination support, 3D modeling, architectural visualization, animation and real-time experiences."
    />

    <title>Axys3D</title>
  </head>

  <body>
    <main>
      <div class="reveal reveal-zoom">
        <Navbar />
        <Hero />
      </div>

      <!-- <div class="grad-zone">
        <div class="reveal reveal-up">
          <Marquee />
        </div>
      </div> -->
      <!-- Mission — own gradient zone -->
      <div class="grad-zone">
        <div class="reveal reveal-fade">
          <Mission />
        </div>
      </div>
     
      <div class="grad-zone">
        <div class="reveal reveal-up">
          <Stages />
        </div>

      </div>
      <!-- How it works — own gradient zone -->
    
      <div class="reveal reveal-left">
        <VisualGallery />
      </div>
 
       <div class="grad-zone">
        <div class="reveal reveal-up">
          <Howitworks />
        </div> </div> 


      <!-- Production Layer — own gradient zone -->
      <div class="grad-zone">
        <div class="reveal reveal-up">
          <ProductionLayer />
        </div>
      </div>

       <!-- <div class="grad-zone">
        <div class="reveal reveal-blur">
          <CaseStudies />
        </div>
      </div> -->


     

      <!-- Buyer segments gradient zone -->
      <!-- <div class="grad-zone">
        <div class="reveal reveal-right">
          <Buyersegments />
        </div>
      </div> -->

      <!-- Case Studies gradient zone -->
     

      <!-- Process Section gradient zone
      <div class="grad-zone">
        <div class="reveal reveal-up">
          <ProcessSection />
        </div>
      </div> -->

      <!-- <div class="reveal reveal-fade">
        <About /> 
      </div> -->

      <!-- FAQ gradient zone -->
      <div class="grad-zone">
        <div class="reveal reveal-fade">
          <FAQSection />
        </div>
      </div>

      <!-- CTA gradient zone -->
      <div class="grad-zone">
        <div class="reveal reveal-pop">
          <CTASection />
        </div>
      </div>
    </main>

    <!-- Footer gradient zone -->
    <div class="grad-zone">
      <div class="reveal reveal-fade">
        <Footer />
      </div>
    </div>

    <script>
      const revealEls = document.querySelectorAll(".reveal");

      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add("is-visible");
              observer.unobserve(entry.target);
            }
          });
        },
        {
          threshold: 0.15,
          rootMargin: "0px 0px -8% 0px",
        }
      );

      revealEls.forEach((el) => observer.observe(el));

      
    </script>
  </body>
</html>
