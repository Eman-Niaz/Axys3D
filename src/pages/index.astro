    <title>Axys3D — AEC Production Partner</title>
  </head>

  <body>
    <main>
      <Hero />
      <ProductionLayer />
      <Service />
      <Buyersegments />
      <CaseStudies />

      <ProcessSection />

      <FAQSection />

      <CTASection />
    </main>
    <Footer />
  </body>
</html>
