---
// src/pages/industries/[slug].astro
// Single industry workflow page with active hero background image & animations

import Navbar from "../../components/Navbar.astro";
import Footer from "../../components/Footer.astro";
import "../../styles/token.css";
import "../../styles/global.css";
import "../../styles/Navbar.css";
import "../../styles/industry-single.css";
import "../../styles/footer.css";
import { getCollection, getEntry, type CollectionEntry } from "astro:content";

export async function getStaticPaths() {
  let industries: CollectionEntry<"industries">[] = [];
  try {
    industries = await getCollection("industries");
  } catch (e) {
    console.log("Collection fetch error:", e);
  }

  if (!industries || industries.length === 0) {
    return [
      { params: { slug: "architecture-design-practices" } },
      { params: { slug: "engineering-multidisciplinary" } },
      { params: { slug: "developers-asset-teams" } },
      { params: { slug: "agencies-production-partners" } },
    ];
  }

  return industries.map((entry) => ({
    params: { slug: entry.id },  
    props: { entry },
  }));
}

const { slug } = Astro.params;
let entry: CollectionEntry<"industries"> | undefined = Astro.props.entry;

if (!entry && slug) {
  try {
    entry = await getEntry("industries", slug);
  } catch (e) {
    console.log("Error loading entry:", e);
  }
}

const data = entry?.data || ({} as Partial<CollectionEntry<"industries">["data"]>);

// Safe type extraction with fallbacks
const title: string = data.title || "Architecture & Design Practices";
const serviceLabel: string = data.serviceLabel || "ARCHITECTURE-DESIGN-PRACTICES";
const description: string =
  data.description ||
  "Extend BIM, Revit, modeling and visual communication capacity while the appointed practice retains design authorship, client leadership and professional issue.";
const operatingContext: string =
  data.operatingContext || "Production pressure needs a governed response.";

const buyerPressures: string[] = data.buyerPressures || [
  "Compressed submission and documentation programmes",
  "Uneven internal Revit or visualization capacity",
  "Design changes propagating across models, sheets and media",
  "External production that does not follow office standards",
];

const productionRequirements: string[] = data.productionRequirements || [
  "BEP- and template-aligned authoring",
  "Documentation coordination against approved design information",
  "Planning and stakeholder visuals tied to named revisions",
  "Transparent assumptions, issues and structured handoff",
];

const engagementModel: Array<{ step: string; description: string }> = data.engagementModel
  ? data.engagementModel.map((item, index) => ({
      step: item.step ?? String(index + 1).padStart(2, "0"),
      description: item.description,
    }))
  : [
      { step: "01", description: "Confirm standards, model ownership and approval roles" },
      { step: "02", description: "Package work by discipline, zone, stage or deliverable" },
      { step: "03", description: "Review through the practice's named design leads" },
      { step: "04", description: "Return editable sources, status and unresolved items" },
    ];

const typicalServices: string[] = data.typicalServices || [
  "BIM execution and model production",
  "Revit production",
  "3D modeling",
  "Architectural visualization",
  "Animation and real-time",
];

const responsibilityBoundary: string =
  data.responsibilityBoundary ||
  "The appointed practice retains design authorship, statutory responsibility and professional sign-off.";

// --- helpers for the new layout ---
const prettyLabel: string = serviceLabel
  .replace(/[-_]+/g, " ")
  .toLowerCase()
  .replace(/\b\w/g, (c: string) => c.toUpperCase());

const titleWords: string[] = title.split(/\s+/).filter(Boolean);
const titleSplit = Math.ceil(titleWords.length / 2);

const ctxWords: string[] = operatingContext.split(/\s+/).filter(Boolean);
const ctxSplit = Math.ceil(ctxWords.length / 2);

const stageNames = ["Inputs", "Production", "Review", "Handoff"];
const stageIcons = [
  '<path d="M14 3H7a2 2 0 00-2 2v14a2 2 0 002 2h10a2 2 0 002-2V8z"/><path d="M14 3v5h5"/>',
  '<circle cx="12" cy="12" r="3.2"/><path d="M12 3v2.5M12 18.5V21M3 12h2.5M18.5 12H21M5.6 5.6l1.8 1.8M16.6 16.6l1.8 1.8M18.4 5.6l-1.8 1.8M7.4 16.6l-1.8 1.8"/>',
  '<path d="M2 12s3.6-6.5 10-6.5S22 12 22 12s-3.6 6.5-10 6.5S2 12 2 12z"/><circle cx="12" cy="12" r="2.8"/>',
  '<path d="M12 2.8l8 4.5v9.4l-8 4.5-8-4.5V7.3z"/><path d="M4 7.3l8 4.5 8-4.5M12 11.8v9.4"/>',
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title} — Axys3D</title>
    <script is:inline>
      document.documentElement.classList.add("js");
    </script>
  </head>

  <body class="page-industry-single">
    <!-- PAGE BACKGROUND — Top tak seamless gradient and glow -->
    <div class="ind-page-bg" aria-hidden="true"></div>

    <Navbar variant="solid" />

    <main class="ind-page">
      <!-- =========== HERO (text only, left) =========== -->
      <section class="ind-hero">
        <div class="ind-wrap">
          <a class="ind-back" href="/Industries/">All industries</a>
          <span class="ind-kicker">Industries / {prettyLabel}</span>

          <h1 class="ind-h1">
            <span class="ind-h1-visual" aria-hidden="true">
              {titleWords.map((w: string, i: number) => (
                <span class={`ind-word${i >= titleSplit ? " ind-word--muted" : ""}`} style={`--i:${i}`}>{w}</span>
              ))}
            </span>
            <span class="sr-only">{title}</span>
          </h1>

          <p class="ind-lead">{description}</p>
        </div>
      </section>

      <!-- =========== OPERATING CONTEXT (bento) =========== -->
      <section class="ind-section ind-section--first">
        <div class="ind-wrap">
          <div class="ind-head ind-reveal">
            <div>
              <span class="ind-kicker">Operating context</span>
              <h2 class="ind-h2">
                {ctxWords.slice(0, ctxSplit).join(" ")} <span>{ctxWords.slice(ctxSplit).join(" ")}</span>
              </h2>
            </div>
            <p class="ind-head-note">Where the pressure comes from, and what the production response has to cover.</p>
          </div>

          <div class="ind-bento">
            <article class="ind-card ind-card--cream ind-reveal" style="--d:0.05s">
              <div class="ind-card-top">
                <span class="ind-tag">Buyer pressures</span>
                <span class="ind-card-num">01</span>
              </div>
              <h3 class="ind-card-title">Typical buyer pressures</h3>
              <p class="ind-card-desc">{buyerPressures.length} constraints this workflow has to absorb.</p>
              <ul class="ind-rows" data-rows>
                {buyerPressures.map((t: string, i: number) => (
                  <li class={`ind-row${i === 0 ? " is-active" : ""}`}>{t}</li>
                ))}
              </ul>
            </article>

            <article class="ind-card ind-card--dark ind-reveal" style="--d:0.12s">
              <div class="ind-card-top">
                <span class="ind-tag">Requirements</span>
                <span class="ind-card-num">02</span>
              </div>
              <h3 class="ind-card-title">Production requirements</h3>
              <p class="ind-card-desc">{productionRequirements.length} controls the package is built around.</p>
              <ul class="ind-rows" data-rows>
                {productionRequirements.map((t: string, i: number) => (
                  <li class={`ind-row${i === 0 ? " is-active" : ""}`}>{t}</li>
                ))}
              </ul>
            </article>

            <div class="ind-stack">
              <article class="ind-card ind-card--cream ind-stat ind-reveal" style="--d:0.19s">
                <span class="ind-tag">Pressures mapped</span>
                <div>
                  <span class="ind-stat-num">{String(buyerPressures.length).padStart(2, "0")}</span>
                  <p class="ind-stat-sub">Buyer-side constraints identified for this workflow.</p>
                </div>
              </article>
              <article class="ind-card ind-card--dark ind-stat ind-reveal" style="--d:0.26s">
                <span class="ind-tag">Governed steps</span>
                <div>
                  <span class="ind-stat-num">{String(engagementModel.length).padStart(2, "0")}</span>
                  <p class="ind-stat-sub">Named approvals from first brief to handoff.</p>
                </div>
              </article>
            </div>
          </div>
        </div>
      </section>

      <!-- =========== ENGAGEMENT MODEL (auto-cycling steps) =========== -->
      <section class="ind-section">
        <div class="ind-wrap">
          <div class="ind-head ind-reveal">
            <div>
              <span class="ind-kicker">Engagement model</span>
              <h2 class="ind-h2">One brief, named approvals, <span>structured handoff.</span></h2>
            </div>
            <p class="ind-head-note">The same governed sequence on every package, from first brief to structured handoff.</p>
          </div>

          <div class="ind-steps" data-steps>
            {engagementModel.map((item: { step: string; description: string }, i: number) => (
              <article class={`ind-step ind-reveal${i === 0 ? " is-active" : ""}`} data-step style={`--d:${i * 0.09}s`}>
                <div class="ind-step-top">
                  <span class="ind-step-pill">{item.step}</span>
                  <span class="ind-step-count">{i + 1} / {engagementModel.length}</span>
                </div>
                <div class="ind-step-icon">
                  <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={stageIcons[i % stageIcons.length]}></svg>
                </div>
                <h3 class="ind-step-title">{stageNames[i] ?? `Step ${item.step}`}</h3>
                <p class="ind-step-desc">{item.description}</p>
                <div class="ind-step-bar"><span></span></div>
                {i < engagementModel.length - 1 && <span class="ind-step-link" aria-hidden="true">→</span>}
              </article>
            ))}
          </div>
        </div>
      </section>

      <!-- =========== CAPABILITIES + BOUNDARY =========== -->
      <section class="ind-section">
        <div class="ind-wrap">
          <div class="ind-head ind-reveal">
            <div>
              <span class="ind-kicker">Relevant capabilities</span>
              <h2 class="ind-h2">Connected <span>service packages.</span></h2>
            </div>
            <p class="ind-head-note">Service packages typically connected to this workflow.</p>
          </div>

          <div class="ind-duo">
            <article class="ind-card ind-card--dark ind-reveal" style="--d:0.05s">
              <div class="ind-card-top">
                <span class="ind-tag">Capabilities</span>
                <span class="ind-card-num">{String(typicalServices.length).padStart(2, "0")}</span>
              </div>
              <h3 class="ind-card-title">Where we plug in</h3>
              <div class="ind-chips">
                {typicalServices.map((svc: string) => (
                  <span class="ind-chip">{svc}</span>
                ))}
              </div>
            </article>

            <article class="ind-card ind-card--cream ind-reveal" style="--d:0.12s">
              <div class="ind-card-top">
                <span class="ind-tag">Responsibility boundary</span>
              </div>
              <p class="ind-boundary">{responsibilityBoundary}</p>
            </article>
          </div>
        </div>
      </section>

      <!-- =========== FINAL CTA =========== -->
      <section class="ind-final-cta">
        <div class="ind-final-inner ind-reveal">
          <h2>Ready to configure this <span>production workflow?</span></h2>
          <p>Align model authoring and deliverable standards with our studio team.</p>
          <a href="/Contact/" class="ind-final-btn">
            <span>Define production package</span>
            <span>↗</span>
          </a>
        </div>
      </section>
    </main>

    <Footer />

    <script is:inline>
      // scroll reveal
      const revealEls = document.querySelectorAll(".ind-reveal");
      if ("IntersectionObserver" in window) {
        const io = new IntersectionObserver(
          (entries) => entries.forEach((e) => {
            if (e.isIntersecting) { e.target.classList.add("is-visible"); io.unobserve(e.target); }
          }),
          { threshold: 0.15, rootMargin: "0px 0px -40px 0px" }
        );
        revealEls.forEach((el) => io.observe(el));
      } else {
        revealEls.forEach((el) => el.classList.add("is-visible"));
      }

      // list rows: highlight follows the mouse
      document.querySelectorAll("[data-rows]").forEach((list) => {
        const rows = list.querySelectorAll(".ind-row");
        rows.forEach((row) => row.addEventListener("mouseenter", () => {
          rows.forEach((r) => r.classList.remove("is-active"));
          row.classList.add("is-active");
        }));
      });

      // engagement steps: auto-cycle, hover to take control
      (function () {
        const wrap = document.querySelector("[data-steps]");
        if (!wrap) return;
        const steps = Array.from(wrap.querySelectorAll("[data-step]"));
        if (!steps.length) return;
        let cur = 0, timer;
        const set = (n) => { cur = n; steps.forEach((s, k) => s.classList.toggle("is-active", k === n)); };
        const stop = () => clearInterval(timer);
        const start = () => { stop(); timer = setInterval(() => set((cur + 1) % steps.length), 3600); };
        set(0);
        if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
        start();
        steps.forEach((s, k) => {
          s.addEventListener("mouseenter", () => { stop(); set(k); });
          s.addEventListener("mouseleave", start);
        });
      })();
    </script>
  </body>
</html>