---
import Navbar from "../../components/Navbar.astro";
import Footer from "../../components/Footer.astro";
import "../../styles/token.css";
import "../../styles/global.css";
import "../../styles/Navbar.css";
import "../../styles/insights.css";
import "../../styles/footer.css";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const articles = await getCollection("insights");
  return articles.map((article) => ({
    params: { slug: article.id }, // Astro v5 glob loader me `id` hi slug ka kaam karti hai
    props: { article },
  }));
}

const { article } = Astro.props;
const { Content } = await render(article);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{article.data.title} — Axys3D Insights</title>
  </head>

  <body class="page-insights">
    <Navbar variant="solid" />

    <main class="insights-page ins-detail-page">
      <article class="ins-wrap ins-detail-wrap">
        <!-- Back Navigation -->
        <a href="/Insights" class="ins-back-link">
          ← Back to Insights
        </a>

        <!-- Header -->
        <header class="ins-detail-header">
          <p class="ins-category">
            {article.data.category} / {article.data.readTime}
          </p>
          <h1 class="ins-detail-title">{article.data.title}</h1>
          <p class="ins-detail-lead">{article.data.summary}</p>
        </header>

        <!-- Dynamic Markdown Body -->
        <div class="ins-markdown-body">
          <Content />
        </div>
      </article>
    </main>

    <Footer />
  </body>
</html>
