---
// src/pages/services/[slug].astro
import Navbar from "../../components/Navbar.astro";
import Footer from "../../components/Footer.astro";
import "../../styles/token.css";
import "../../styles/global.css";
import "../../styles/Navbar.css";
import "../../styles/service-details.css";
import "../../styles/footer.css";
import { getCollection } from "astro:content";

export async function getStaticPaths() {
  const services = await getCollection("services");

  return services.map((service) => {
    const slug = service.id.replace(/^\d+-/, "");

    return {
      params: { slug },
      props: { service },
    };
  });
}

const { service } = Astro.props;

const {
  title,
  serviceNumber,
  serviceLabel,
  description,
} = service.data;

const pad = (n: number | string) => String(n).padStart(2, "0");

/* Heading Split: Pehla hissa white, doosra brown */
const titleWords: string[] = title.split(/\s+/).filter(Boolean);
const titleSplit = Math.ceil(titleWords.length / 2);
const titleA = titleWords.slice(0, titleSplit).join(" ");
const titleB = titleWords.slice(titleSplit).join(" ");

/* Trusted Studios */
const trustedLogos = [
  { name: "Verisure", sym: "◆" },
  { name: "Layerise", sym: "⚡" },
  { name: "Collective", sym: "❖" },
  { name: "Axis Studio", sym: "▲" },
  { name: "BIM Co", sym: "◉" },
];

/* Real High-Res Architectural Imagery for Case Studies */
const q = "?auto=format&fit=crop&w=1200&q=80";
const caseStudies = [
  {
    title: "Skyline Residential Tower",
    type: "Full BIM & Facade Coordination",
    result: "Zero on-site clashes across 42 floors",
    image: `https://images.unsplash.com/photo-1486406146926-c627a92ad1ab${q}`,
  },
  {
    title: "Nordic Cultural Pavilion",
    type: "Photoreal Exterior Stills & Tour",
    result: "Competition winner render package",
    image: `https://images.unsplash.com/photo-1600585154340-be6161a56a0c${q}`,
  },
  {
    title: "Metropolitan Mixed-Use",
    type: "MEP Routing & Spatial Audit",
    result: "7-day turnaround delivery",
    image: `https://images.unsplash.com/photo-1600596542815-ffad4c1539a9${q}`,
  },
];

/* Key Deliverables Overview */
const deliverables = [
  {
    num: "01",
    title: "Checked 3D Models",
    desc: "Clean geometry authoring in Revit & CAD adhering to strict LOD standards.",
  },
  {
    num: "02",
    title: "Clash & MEP Audits",
    desc: "Complete clash detection reports before documentation reaches the site.",
  },
  {
    num: "03",
    title: "Cinematic Visuals",
    desc: "4K photoreal renders, real-time walkthroughs, and presentation materials.",
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title} — AXYS3D</title>
    <script is:inline>
      document.documentElement.classList.add("js");
    </script>
  </head>

  <body class="page-service-detail">
    <!-- Subtle Background Gradient -->
    <div class="svcd-page-bg" aria-hidden="true"></div>

    <Navbar variant="solid" />

    <main class="svcd-page">
      <!-- ================= 1. HERO (CONCISE & IMPACTFUL) ================= -->
      <section class="svcd-hero">
        <div class="svcd-wrap">
          <div class="svcd-hero-inner">
            <span class="svcd-kicker">SERVICE {pad(serviceNumber)} / {serviceLabel}</span>

            <h1 class="svcd-h1">
              {titleA} <span>{titleB}</span>
            </h1>

            <p class="svcd-lead">{description}</p>

            <div class="svcd-hero-actions">
              <a href="#case-studies" class="svcd-btn-primary">
                <span>See Case Studies</span>
                <span>↓</span>
              </a>
              <a href="/Contact/" class="svcd-btn-ghost">
                <span>Start a Project</span>
                <span>↗</span>
              </a>
            </div>
          </div>
        </div>
      </section>

      <!-- ================= 2. TRUSTED BY LOGO STRIP ================= -->
      <section class="svcd-trust-sec">
        <div class="svcd-wrap">
          <div class="svcd-trust-inner" data-reveal>
            <span class="svcd-trust-label">TRUSTED BY TEAMS ACROSS AEC & REAL ESTATE</span>
            <div class="svcd-trust-logos">
              {trustedLogos.map((item) => (
                <div class="svcd-trust-item">
                  <span class="svcd-trust-sym">{item.sym}</span>
                  <span class="svcd-trust-name">{item.name}</span>
                </div>
              ))}
            </div>
          </div>
        </div>
      </section>

      <!-- ================= 3. VIDEO & INTERACTIVE WALKTHROUGH ================= -->
      <section class="svcd-video-sec">
        <div class="svcd-wrap">
          <div class="svcd-sec-head" data-reveal>
            <div>
              <span class="svcd-kicker">MOTION &amp; EXECUTION</span>
              <h2 class="svcd-h2">Experience the production, <span>in motion.</span></h2>
            </div>
            <p class="svcd-sec-desc">Explore live render fidelity, spatial walkthroughs, and precise coordinated modeling.</p>
          </div>

          <div class="svcd-video-card" data-reveal>
            <img
              src="https://images.unsplash.com/photo-1613977257363-707ba9348227?auto=format&fit=crop&w=1800&q=80"
              alt="3D Walkthrough preview"
              class="svcd-video-cover"
              loading="lazy"
            />
            <div class="svcd-video-overlay"></div>

            <div class="svcd-video-badge">
              <span class="svcd-pulse-dot"></span>
              <span>4K REAL-TIME FLYTHROUGH</span>
            </div>

            <div class="svcd-play-btn-wrap">
              <div class="svcd-play-btn" aria-label="Play Walkthrough Preview">
                <svg viewBox="0 0 24 24" fill="currentColor">
                  <path d="M8 5v14l11-7z" />
                </svg>
              </div>
              <span class="svcd-play-label">WATCH 60-SEC WALKTHROUGH REEL</span>
            </div>
          </div>
        </div>
      </section>

      <!-- ================= 4. CASE STUDIES & VISUAL GALLERY ================= -->
      <section class="svcd-cases-sec" id="case-studies">
        <div class="svcd-wrap">
          <div class="svcd-sec-head" data-reveal>
            <div>
              <span class="svcd-kicker">SELECTED WORK</span>
              <h2 class="svcd-h2">Recent projects &amp; <span>deliverables.</span></h2>
            </div>
            <p class="svcd-sec-desc">Real case studies executed under strict timelines with verified delivery standards.</p>
          </div>

          <div class="svcd-cases-grid">
            {caseStudies.map((item, idx) => (
              <div class="svcd-case-card" data-reveal style={`--d:${idx * 90}ms`}>
                <div class="svcd-case-thumb">
                  <img src={item.image} alt={item.title} loading="lazy" />
                  <span class="svcd-case-tag">{item.type}</span>
                </div>
                <div class="svcd-case-info">
                  <h3 class="svcd-case-title">{item.title}</h3>
                  <p class="svcd-case-res">✓ {item.result}</p>
                </div>
              </div>
            ))}
          </div>
        </div>
      </section>

      <!-- ================= 5. WHAT WE DELIVER (COMPACT CARDS) ================= -->
      <section class="svcd-deliver-sec">
        <div class="svcd-wrap">
          <div class="svcd-sec-head" data-reveal>
            <div>
              <span class="svcd-kicker">SCOPE OVERVIEW</span>
              <h2 class="svcd-h2">What you receive in <span>every package.</span></h2>
            </div>
            <p class="svcd-sec-desc">Clear, audited assets ready for immediate presentation, client sign-off, or site coordination.</p>
          </div>

          <div class="svcd-deliver-grid">
            {deliverables.map((d, i) => (
              <div class="svcd-deliver-card" data-reveal style={`--d:${i * 80}ms`}>
                <span class="svcd-deliver-num">{d.num}</span>
                <h3 class="svcd-deliver-title">{d.title}</h3>
                <p class="svcd-deliver-desc">{d.desc}</p>
              </div>
            ))}
          </div>
        </div>
      </section>

      <!-- ================= 6. FINAL CTA ================= -->
      <section class="svcd-final-cta">
        <div class="svcd-wrap">
          <div class="svcd-final-inner" data-reveal>
            <h2>Ready to configure this <span>production workflow?</span></h2>
            <p>Align model authoring, technical requirements, and deliverable standards with our studio leads.</p>
            <a href="/Contact/" class="svcd-final-btn">
              <span>Book technical session</span>
              <span>↗</span>
            </a>
          </div>
        </div>
      </section>
    </main>

    <Footer />

    <script is:inline>
      const revealItems = document.querySelectorAll("[data-reveal]");
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add("is-visible");
              observer.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.1 }
      );
      revealItems.forEach((el) => observer.observe(el));
    </script>
  </body>
</html>