---
// src/pages/services/[slug].astro
// Dynamic detail page for individual architectural/AEC services

import Navbar from "../../components/Navbar.astro";
import Footer from "../../components/Footer.astro";
import "../../styles/token.css";
import "../../styles/global.css";
import "../../styles/Navbar.css";
import "../../styles/services.css";
import "../../styles/service-details.css";
import "../../styles/footer.css";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const services = await getCollection("services");

  return services.map((service) => {
    const slug = service.id.replace(/^\d+-/, "");

    return {
      params: { slug },
      props: { service },
    };
  });
}

const { service } = Astro.props;

const {
  title,
  serviceNumber,
  serviceLabel,
  description,
  bestFitBuyers,
  projectStages,
  engagementContext,
} = service.data;

const { Content } = await render(service);

const heroBackgroundImage =
  "https://images.unsplash.com/photo-1487958449943-2429e8be8625?auto=format&fit=crop&w=2400&q=85";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title} — Axys3D</title>
  </head>

  <body class="page-service-detail">

    <!-- HERO WRAPPER WITH TRANSPARENT OVERLAY NAVBAR -->
    <div class="svcd-hero-wrapper">
      <Navbar variant="transparent" />

      <section class="svcd-hero">

        <!-- Background Image & Gradient Layer -->
        <div class="svcd-hero-bg">
          <img
            src={heroBackgroundImage}
            alt="Hero Background"
            class="svcd-hero-img"
          />
          <div class="svcd-hero-overlay"></div>
        </div>

        <!-- Hero Primary Content -->
        <div class="svc-wrap svcd-hero-content">

          <div class="svcd-top-meta">
            <a class="svcd-back" href="/Services/">
              <span class="back-arrow">←</span>
              <span>ALL SERVICES</span>
            </a>
            <span class="svcd-category-badge">AEC / PRODUCTION SPEC</span>
          </div>

          <p class="svc-eyebrow">
            SERVICE {serviceNumber} // {serviceLabel}
          </p>

          <h1 class="svcd-h1">
            {title}
          </h1>

          <p class="svcd-lead">
            {description}
          </p>

          <!-- DYNAMIC ASYMMETRIC META CARDS -->
          <div class="svcd-meta-grid">

            <!-- Card Variant 01: Glassmorphism Glass Panel -->
            <div class="svcd-meta-col svcd-card-variant-a">
              <span class="svcd-meta-number">01</span>
              <p class="svcd-meta-label">BEST-FIT BUYERS</p>
              <ul class="svcd-meta-list">
                {bestFitBuyers.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            </div>

            <!-- Card Variant 02: Solid Dark Panel Accent -->
            <div class="svcd-meta-col svcd-card-variant-b">
              <span class="svcd-meta-number">02</span>
              <p class="svcd-meta-label">PROJECT STAGES</p>
              <ul class="svcd-meta-list">
                {projectStages.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            </div>

            <!-- Card Variant 03: Left Border Inset Panel -->
            <div class="svcd-meta-col svcd-card-variant-c">
              <span class="svcd-meta-number">03</span>
              <p class="svcd-meta-label">ENGAGEMENT CONTEXT</p>
              <ul class="svcd-meta-list">
                {engagementContext.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            </div>

          </div>

        </div>

      </section>
    </div>

    <!-- MAIN BODY & PROSE CONTAINER -->
    <main class="svcd-body">
      <div class="svc-wrap svcd-prose">
        <Content />
      </div>

      <!-- CALL TO ACTION BLOCK -->
      <div class="svc-wrap svcd-cta-wrapper">
        <div class="svcd-cta-card">
          <div class="svcd-cta-info">
            <span class="svcd-cta-eyebrow">ENGAGE OUR STUDIO</span>
            <h2 class="svcd-cta-heading">Ready to scale your BIM & visualization workflow?</h2>
            <p class="svcd-cta-subtext">Let's discuss technical requirements, execution scope, and production schedules.</p>
          </div>
          <div class="svcd-cta-actions">
            <a href="/Contact/" class="svcd-btn svcd-btn-primary">
              Schedule Consultation
              <span class="btn-icon">→</span>
            </a>
            <a href="/Visuals/" class="svcd-btn svcd-btn-secondary">
              Explore Portfolio
            </a>
          </div>
        </div>
      </div>
    </main>

    <Footer />

  </body>
</html>